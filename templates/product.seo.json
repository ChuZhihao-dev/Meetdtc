    "faq_XyKTzC": {
      "type": "faq",
      "blocks": {
        "faq_row_XdLKBG": {
          "type": "_faq-row",
          "settings": {
            "question": "Q1. What does your SEO service include?",
            "answer": "<p>Our proposed service covers nine areas, from research and technical SEO to content and reporting. Your agreement specifies the pages, articles, markets, and implementation work included.<br/><br/></p>",
            "open_by_default": true
          },
          "blocks": {}
        },
        "faq_row_ckALeW": {
          "type": "_faq-row",
          "settings": {
            "question": "Q2. How long does SEO take to show results?",
            "answer": "<p>Timing depends on the website’s starting point, competition, and implementation. We establish a baseline during the initial audit and set review milestones around the agreed roadmap.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_8DWdMn": {
          "type": "_faq-row",
          "settings": {
            "question": "Q3. Do you guarantee first-page rankings?",
            "answer": "<p>We do not guarantee a specific ranking. We agree on target keyword groups, deliverables, and performance measures so you can assess both the work completed and its results.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_6Vcq7e": {
          "type": "_faq-row",
          "settings": {
            "question": "Q4. Do you work with ecommerce and B2B websites?",
            "answer": "<p>The program can be structured for either. Ecommerce projects prioritize categories, products, and purchases; B2B projects prioritize services, supplier evaluation, and qualified enquiries.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_idcK38": {
          "type": "_faq-row",
          "settings": {
            "question": "Q5. Can you work with our existing developers and content team?",
            "answer": "<p>Yes. The scope can cover recommendations, production, or shared implementation. We define one owner for each action so responsibilities remain clear.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_mtDEQH": {
          "type": "_faq-row",
          "settings": {
            "question": "Q6. Do we need to create new content?",
            "answer": "<p>We assess existing content first. The content plan identifies three types of action: improve an existing page, consolidate overlapping pages, or create a new page.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_TfzdMb": {
          "type": "_faq-row",
          "settings": {
            "question": "Q7. Can you support multiple countries and languages?",
            "answer": "<p>Yes, subject to the agreed scope. Each target market receives its own keyword and page mapping rather than relying on a single translated keyword list.<br/><br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_CGMX33": {
          "type": "_faq-row",
          "settings": {
            "question": "Q8. How do you measure SEO performance?",
            "answer": "<p>We use Google Search Console for search performance and GA4 for website behavior and tracked conversions. The report connects those findings to agreed business goals.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_H88kCk": {
          "type": "_faq-row",
          "settings": {
            "question": "Q9. Is link building included?",
            "answer": "<p>It can be included in the selected scope. We specify resource criteria, deliverables, and reporting separately so you know what link development involves.<br/><br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_ABzErp": {
          "type": "_faq-row",
          "settings": {
            "question": "Q10. What do you need from us to get started?",
            "answer": "<p>We need your website URL, target markets, priority products or services, and business goals. Access to Search Console and GA4 supports a more detailed assessment.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        }
