    "service_scope_VaDYAw": {
      "type": "service-scope",
      "blocks": {
        "card_ETxkQz": {
          "type": "card",
          "settings": {
            "heading": "Cloud API Setup & Compliance",
            "description": "<p>We provision your WhatsApp Business Platform account, verify your phone number, and handle template approvals end-to-end. You get a compliant, ready-to-send number on Meta's Cloud API with the templates you need pre-approved.</p>",
            "link": "",
            "link_label": "Learn more"
          }
        },
        "card_wKwRVy": {
          "type": "card",
          "settings": {
            "heading": "Chat Flow & Automation",
            "description": "<p>We design automated greetings, FAQs, order updates, and escalation paths using interactive message templates. You get a working chatbot that responds 24/7.</p>",
            "link": "",
            "link_label": "Learn more"
          }
        },
        "card_jTHQUi": {
          "type": "card",
          "settings": {
            "heading": "CRM & Store Integration",
            "description": "<p>We connect WhatsApp with your CRM, ERP, or ecommerce platform via webhooks and the Business Management API. You get live sync of conversations, orders, and customer data.</p>",
            "link": "",
            "link_label": "Learn more"
          }
        },
        "card_HJg9Ee": {
          "type": "card",
          "settings": {
            "heading": "WhatsApp Marketing Messages API",
            "description": "<p>We plan, create, and submit approved templates, then run targeted broadcast campaigns through Meta's Marketing Messages API. You get higher engagement with built-in auto-optimization and detailed performance reports.</p>",
            "link": "",
            "link_label": "Learn more"
          }
        },
        "card_xg8a6q": {
          "type": "card",
