    "faq_XyKTzC": {
      "type": "faq",
      "blocks": {
        "faq_row_XdLKBG": {
          "type": "_faq-row",
          "settings": {
            "question": "Q1. What is the WhatsApp Business Platform?",
            "answer": "<p>Meta's enterprise-grade messaging API that lets businesses automate conversations, send campaigns, and support customers at scale.</p>",
            "open_by_default": true
          },
          "blocks": {}
        },
        "faq_row_ckALeW": {
          "type": "_faq-row",
          "settings": {
            "question": "Q2. Is it different from the free WhatsApp Business app?",
            "answer": "<p>Yes. The Business Platform adds automation, CRM integration, template campaigns, and bulk messaging — the free app is manual and single-device.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_8DWdMn": {
          "type": "_faq-row",
          "settings": {
            "question": "Q3. Can we send marketing campaigns on WhatsApp?",
            "answer": "<p>Yes, using pre-approved template messages. We handle template creation, submission, and optimization to keep your number safe.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_6Vcq7e": {
          "type": "_faq-row",
          "settings": {
            "question": "Q4. Will our number get blocked or banned?",
            "answer": "<p>Not if you follow WhatsApp's rules. We build compliant opt-in flows and approved templates to keep your account healthy.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_idcK38": {
          "type": "_faq-row",
          "settings": {
            "question": "Q5. What message types are supported?",
            "answer": "<p>Text, images, video, documents, interactive buttons, list messages, and template messages — plus WhatsApp voice calls directly in chat.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_mtDEQH": {
          "type": "_faq-row",
          "settings": {
            "question": "Q6. How does pricing work?",
            "answer": "<p>Conversation-based pricing. Business-initiated chats are charged per 24-hour window; customer-initiated chats are free or lower-cost by region.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_TfzdMb": {
          "type": "_faq-row",
          "settings": {
            "question": "Q7. Can you connect WhatsApp to our CRM and store?",
            "answer": "<p>&nbsp;Yes. We integrate with major CRMs and ecommerce platforms, syncing conversations, orders, and customer data in real time.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_CGMX33": {
          "type": "_faq-row",
          "settings": {
            "question": "Q8. How fast will we see results?",
            "answer": "<p>Faster replies and higher engagement within the first month; conversion impact typically shows in your first campaign cycle.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_H88kCk": {
          "type": "_faq-row",
          "settings": {
            "question": "Q9. Which countries and languages do you support?",
            "answer": "<p>WhatsApp reaches 2B+ users across 180+ countries. We build localized templates and multi-language flows for your target markets.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
