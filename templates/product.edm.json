    "faq_XyKTzC": {
      "type": "faq",
      "blocks": {
        "faq_row_XdLKBG": {
          "type": "_faq-row",
          "settings": {
            "question": "Q1.  Do we need an existing email tool to start?",
            "answer": "<p>No. We start with a free diagnosis and recommend the right platform objectively — Klaviyo, Omnisend or Stream — and many clients go live within 2 weeks.</p>",
            "open_by_default": true
          },
          "blocks": {}
        },
        "faq_row_ckALeW": {
          "type": "_faq-row",
          "settings": {
            "question": "Q2.How long until we see results?",
            "answer": "<p>Systems go live in 1–2 weeks; open-rate gains typically show in the first month, and meaningful GMV contribution builds within 2–3 months.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_8DWdMn": {
          "type": "_faq-row",
          "settings": {
            "question": "Q3. What results can we expect?",
            "answer": "<p>In one 3C brand, average open rate reached 65%+ and EDM GMV contribution grew 64%+ YoY. Across clients, EDM + SMS typically drives 20–35% of site GMV.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_6Vcq7e": {
          "type": "_faq-row",
          "settings": {
            "question": "Q4.  Is this only for big brands?",
            "answer": "<p>No. We offer flexible engagement — free guidance, strategy coaching, full managed operations or KPI-based pricing — from mid-size DTC brands to enterprises.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_idcK38": {
          "type": "_faq-row",
          "settings": {
            "question": "Q5. Do you just send emails?",
            "answer": "<p>No. We deliver strategy, system setup, lifecycle flows, campaign content, segmentation and monthly analysis with a dedicated expert team.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_mtDEQH": {
          "type": "_faq-row",
          "settings": {
            "question": "Q6. Will our emails actually reach the inbox?",
            "answer": "<p>A mention names your brand, a recommendation presents it as a suitable option, and a citation links to a source. We report these as separate measures.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_TfzdMb": {
          "type": "_faq-row",
          "settings": {
            "question": "Q7. How do you handle data and compliance?",
            "answer": "<p>We follow GDPR, CAN-SPAM and CASL, set up double opt-in and preference centers, and keep transactional and marketing emails clearly separated.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_CGMX33": {
          "type": "_faq-row",
          "settings": {
            "question": "Q8.  Which platforms do you work with?",
            "answer": "<p>Klaviyo (Platinum Master Partner), Omnisend (certified partner), Stream and more — we match the tool to your budget, team and goals.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_H88kCk": {
          "type": "_faq-row",
          "settings": {
            "question": "Q9. What if we already have an email program?",
            "answer": "<p>We diagnose what's working and what isn't, then migrate and optimize — one 3C client lifted click rate 500%+ and conversion 750%+ after switching to us.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_ABzErp": {
          "type": "_faq-row",
          "settings": {
            "question": "Q10.  How do you measure success?",
            "answer": "<p>We track open rate, click rate, conversion, unsubscribe and complaint rates, plus EDM-attributed revenue, and review them with you monthly.</p>",
            "open_by_default": false
          },
          "blocks": {}
        }
      },
