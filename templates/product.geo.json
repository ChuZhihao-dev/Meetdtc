    "faq_XyKTzC": {
      "type": "faq",
      "blocks": {
        "faq_row_XdLKBG": {
          "type": "_faq-row",
          "settings": {
            "question": "Q1. What is GEO? What is GEO?",
            "answer": "<p>GEO is work aimed at improving a brand’s presence in AI-generated answers. Our program focuses on three outcomes: mentions, recommendations, and citations.</p>",
            "open_by_default": true
          },
          "blocks": {}
        },
        "faq_row_ckALeW": {
          "type": "_faq-row",
          "settings": {
            "question": "Q2. How is GEO different from SEO?",
            "answer": "<p>SEO focuses on visibility in search results. GEO examines how a brand appears in AI answers; the two services share work on accessible pages, clear information, and useful content.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_8DWdMn": {
          "type": "_faq-row",
          "settings": {
            "question": "Q3. Which AI platforms can the program cover?",
            "answer": "<p>The scope may include ChatGPT, Gemini, Perplexity, Google AI Overviews, or other agreed platforms. We confirm platform availability, collection methods, and reporting coverage before starting.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_6Vcq7e": {
          "type": "_faq-row",
          "settings": {
            "question": "Q4. Can you guarantee that AI will recommend our brand?",
            "answer": "<p>A recommendation in every answer cannot be guaranteed. We agree on a prompt set, monitoring conditions, and review period to evaluate observed performance consistently.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_idcK38": {
          "type": "_faq-row",
          "settings": {
            "question": "Q5. How do you choose the questions to monitor?",
            "answer": "<p>We organize questions into five stages: discovery, comparison, evaluation, purchase, and use. We then prioritize them by relevance to your products, audience, and markets.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_mtDEQH": {
          "type": "_faq-row",
          "settings": {
            "question": "Q6. What is the difference between a mention, a recommendation, and a citation?",
            "answer": "<p>A mention names your brand, a recommendation presents it as a suitable option, and a citation links to a source. We report these as separate measures.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_TfzdMb": {
          "type": "_faq-row",
          "settings": {
            "question": "Q7. Why do AI answers differ between tests?",
            "answer": "<p>Answers can vary with the question, context, platform, and test conditions. We use an agreed setup and repeated observations rather than judge performance from one answer.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_CGMX33": {
          "type": "_faq-row",
          "settings": {
            "question": "Q8. Does publishing more articles guarantee more AI visibility?",
            "answer": "<p>No. We assess each content opportunity against a target question, supporting evidence, and an identified information gap before adding it to the plan.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_H88kCk": {
          "type": "_faq-row",
          "settings": {
            "question": "Q9. Can you support different countries and languages?",
            "answer": "<p>Yes, within the agreed scope. Each market receives its own prompt set and content priorities, and results are reported separately where the monitoring setup supports it.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_ABzErp": {
          "type": "_faq-row",
          "settings": {
            "question": "Q10. How do you measure progress?",
            "answer": "<p>We compare results against the baseline using the same defined prompt set and reporting method. Core measures include mention rate, recommendation rate, citation rate, and prompt coverage.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_WTzBV7": {
          "type": "_faq-row",
          "settings": {
            "question": "Q11. Can GEO performance be connected to leads or sales?",
            "answer": "<p>We can review identifiable AI referral visits and tracked conversions where data is available. Answer visibility and website conversions are reported separately because not every AI interaction produces a visit.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_YVKwqV": {
          "type": "_faq-row",
          "settings": {
            "question": "Q12. What information do you need from us?",
            "answer": "<p>We need your website, brand names, priority products, target markets, and competitors. Product specifications and supporting credentials help us check information accuracy.</p>",
            "open_by_default": false
          },
          "blocks": {}
        }
      },
