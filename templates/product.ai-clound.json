    "service_scope_VaDYAw": {
      "type": "service-scope",
      "blocks": {
        "card_ETxkQz": {
          "type": "card",
          "settings": {
            "heading": "Discovery & Cloud Architecture Blueprint",
            "description": "<p>We audit your existing cross-border workloads, traffic peaks, and model dependencies. You receive a battle-tested GCP architecture topology, quota requirement matrix, and a deterministic unit-cost forecast before line one of code is written.</p>",
            "link": "",
            "link_label": "Learn more"
          }
        },
        "card_wKwRVy": {
          "type": "card",
          "settings": {
            "heading": "Enterprise GenAI & Workflow Engineerin",
            "description": "<p>We design multi-model routing pipelines, prompt engineering benchmarks, and prompt-caching layers across Vertex AI (Gemini 3/4, Veo). You receive production-ready inference endpoints integrated directly into your business stack with 60%+ cost reduction.</p>",
            "link": "",
            "link_label": "Learn more"
          }
        },
        "card_jTHQUi": {
          "type": "card",
          "settings": {
            "heading": "Global Backbone Networking & Low-Latency Edge",
            "description": "<p>We configure Google Cloud Premium Tier private backbone network, Cloudflare Zero-Trust tunnels, and multi-region Cloud CDN edge caching. You receive sub-second cross-border response latency and enterprise DDoS resilience across US, Europe, and APAC.</p>",
            "link": "",
            "link_label": "Learn more"
          }
        },
        "card_HJg9Ee": {
          "type": "card",
          "settings": {
            "heading": "Production Infrastructure as Code (IaC) & Deployment",
            "description": "<p>We codify and automate all serverless Cloud Run, GKE microservices, VPC peering, and Cloud SQL setups using Terraform. You receive 100% transparent, version-controlled repository code that your in-house engineers can replicate and audit at any time.</p>",
            "link": "",
            "link_label": "Learn more"
          }
        },
        "card_xg8a6q": {
          "type": "card",
