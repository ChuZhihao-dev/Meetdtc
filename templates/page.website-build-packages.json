    "faq_FKqUjK": {
      "type": "faq",
      "blocks": {
        "faq_row_6L8JYN": {
          "type": "_faq-row",
          "settings": {
            "question": "Q1. What do the page quantities mean?",
            "answer": "<p>Basic includes 8 core e-commerce page types: homepage, category, product, brand/about, order tracking, contact, policies and FAQ. Advanced includes these 8 core page types plus up to 6 custom-built pages, built specifically for your project rather than using Shopify’s ready-made page templates. It also includes up to 3 operational pages, such as affiliate programme pages, review aggregation pages or quizzes. Custom page quantities are assessed for your project.</p>",
            "open_by_default": true
          },
          "blocks": {}
        },
        "faq_row_Nxk7Qg": {
          "type": "_faq-row",
          "settings": {
            "question": "Q2. How do theme-based and custom-built pages differ?",
            "answer": "<p>Theme-based pages use the selected theme’s existing sections and layouts. The up to 6 additional pages in Advanced are built specifically for your project rather than using Shopify’s ready-made page templates. Operational pages can include affiliate programme pages, review aggregation pages and quizzes. The agreed project scope defines the functionality and any integrations.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_XiLH9X": {
          "type": "_faq-row",
          "settings": {
            "question": "Q3. How do SEO and tracking differ between packages?",
            "answer": "<p>Basic includes homepage SEO. Advanced adds meta title, description, URL, image alt text and structured-content optimisation, sitemap planning and up to 10 standard GA4 tracking events. Custom requirements are assessed for your project.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_X4L7Gj": {
          "type": "_faq-row",
          "settings": {
            "question": "Q4. Are multilingual features included?",
            "answer": "<p>Basic and Advanced include configuration for up to 3 machine-translated languages. Custom multilingual and currency requirements are assessed for your project.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_tGbwJD": {
          "type": "_faq-row",
          "settings": {
            "question": "Q5.  What do I need to provide, and when does delivery start?",
            "answer": "<p>Please provide the copy, images, videos and other materials required for the website. Delivery estimates start after all required materials are received: approximately 2 weeks for Basic and 4 weeks for Advanced. Custom delivery is assessed for your project.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_RhamPq": {
          "type": "_faq-row",
          "settings": {
            "question": "Q6. Are themes, subscriptions and third-party tools included?",
            "answer": "<p>Third-party theme licences, platform subscriptions, domains, paid apps and email-service fees are not included in the build fee. Email capture and outreach tools follow their applicable billing arrangements: qualified-traffic-based billing for Basic and per-user prepayment for Advanced.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_aRPt6t": {
          "type": "_faq-row",
          "settings": {
            "question": "Q7. What if I need additional services?",
            "answer": "<p>Extra uploads, custom page design, feature development, third-party integrations, visual assets and additional SEO can be assessed for your project. Services may be included in your package or incur an additional fee. Scope and any fees are confirmed before work begins.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_wTi8Tc": {
          "type": "_faq-row",
          "settings": {
            "question": "Q8. What support is included after handover?",
            "answer": "<p>Basic includes 2 months of post-launch support. Advanced and Custom include 3 months. Shopify handover resources include admin manuals, domain and payment connection tutorials, and policy and basic-page samples.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_MfHYWK": {
          "type": "_faq-row",
          "settings": {
            "question": "Q9. Does advertising account assistance guarantee approval?",
            "answer": "<p>Account-opening guidance and priority review assistance are included. Final approval is subject to the advertising platform’s review.</p>",
            "open_by_default": false
          },
          "blocks": {}
        }
      },
