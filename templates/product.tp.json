        "faq_row_ckALeW": {
          "type": "_faq-row",
          "settings": {
            "question": "Q2. What are Verified Trustpilot Reviews?",
            "answer": "<p>Reviews collected through Trustpilot's official channels, where the buyer is confirmed. They're the only type Google counts for Seller Rating.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_8DWdMn": {
          "type": "_faq-row",
          "settings": {
            "question": "Q3. Why focus on Verified Reviews?",
            "answer": "<p>Google only pulls them. AI search engines weight them highest. Consumers trust them most.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_6Vcq7e": {
          "type": "_faq-row",
          "settings": {
            "question": "Q4. How do we improve our Google Seller Rating?",
            "answer": "<p>It comes straight from Trustpilot. More Verified Reviews + consistent invites + quick replies to negatives = better Google rating.<br/><br/></p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_idcK38": {
          "type": "_faq-row",
          "settings": {
            "question": "Q5. We have negative customer reviews. Can we delete them?",
            "answer": "<p>Only if they break Trustpilot’s guidelines, such as fake, non-customer, or promotional reviews, and Trustpilot makes that call. For genuine ones, we fix root issues, reply professionally, and bring in fresh reviews.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_mtDEQH": {
          "type": "_faq-row",
          "settings": {
            "question": "Q6. We got a warning letter from Trustpilot — what now?",
            "answer": "<p>&nbsp;Stop the flagged activity, switch to compliant invitation methods. We'll guide you through each step.</p>",
            "open_by_default": false
          },
          "blocks": {}
        },
        "faq_row_TfzdMb": {
          "type": "_faq-row",
          "settings": {
            "question": "Q7. What auto invitation options are there?",
            "answer": "<p>AFS, platform integration (Shopify, WooCommerce), or API. We'll recommend what fits your setup.<br/><br/><br/></p>",
