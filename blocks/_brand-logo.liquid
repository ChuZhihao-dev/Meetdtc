

{% liquid
  assign block_settings = block.settings
  assign image_loading = 'lazy'
  if section.index <= 2
    assign image_loading = 'eager'
  endif
  assign has_logo = false
  if block_settings.image
    assign has_logo = true
  endif
  assign alt = block_settings.alt | default: block_settings.image.alt | default: shop.name
  assign image_scale = block_settings.image_scale | default: 25
  assign display_width = block_settings.image.width | times: image_scale | divided_by: 100.0
  assign image_sizes = display_width | ceil | append: 'px'
  assign image_source_width = block_settings.image.width | at_most: 5760
%}

{% if has_logo or request.design_mode %}
  {% capture logo_image %}
    {%- if has_logo -%}
      {{
        block_settings.image
        | image_url: width: image_source_width
        | image_tag:
          width: block_settings.image.width,
          height: block_settings.image.height,
          sizes: image_sizes,
          loading: image_loading,
          decoding: 'async',
          class: 'brand-logo__image',
          alt: alt
      }}
    {%- else -%}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'brand-logo__placeholder' }}
    {%- endif -%}
  {% endcapture %}

  {% if block_settings.link != blank %}
    <a
      href="{{ block_settings.link }}"
      class="brand-logo brand-logo--linked"
      style="--brand-image-width: {{ display_width }}px;"
      {{ block.shopify_attributes }}
    >
      {{ logo_image }}
    </a>
  {% else %}
    <div class="brand-logo" style="--brand-image-width: {{ display_width }}px;" {{ block.shopify_attributes }}>
      {{ logo_image }}
    </div>
  {% endif %}
{% endif %}

{% stylesheet %}
  .brand-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-logo--linked {
    transition: opacity var(--animation-speed) ease;
  }

  .brand-logo__image,
  .brand-logo__placeholder {
    display: block;
    height: auto;
    width: var(--brand-image-width, auto);
    max-width: none;
    object-fit: contain;
  }

  @media (hover: hover) {
    .brand-logo--linked:hover {
      opacity: 0.75;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.logo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "range",
      "id": "image_scale",
      "label": "t:options.scale",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 25
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "t:settings.alt_text"
    }
  ],
  "presets": [
    {
      "name": "t:names.logo",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
