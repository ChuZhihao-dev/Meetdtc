{% doc %}
  Renders a merchant-authored question and answer with native disclosure behavior.
  The containing FAQ section owns the FAQPage microdata scope.
  Uses the containing section's layout_style setting for the card icon variant.
  @example {% content_for 'block', type: '_faq-row', id: 'question' %}
{% enddoc %}

{% liquid
  assign block_settings = block.settings
  assign answer_text = block_settings.answer | strip_html | strip
  assign render_faq_row = request.design_mode
  if block_settings.question != blank and answer_text != blank
    assign render_faq_row = true
  endif
%}

{% if render_faq_row %}
{%- capture faq_row_details -%}
  <details
    class="faq-row"
    {% if block_settings.question != blank and answer_text != blank %}
      itemprop="mainEntity"
      itemscope
      itemtype="https://schema.org/Question"
    {% endif %}
    data-reveal
    {% if block_settings.open_by_default %}
      open
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="faq-row__summary">
      <span class="faq-row__toggle svg-wrapper icon-plus" aria-hidden="true">
        {% if section.settings.layout_style == 'cards' %}
          <span class="faq-row__symbol faq-row__symbol--plus" style="--faq-symbol: url('{{ 'faq-plus.svg' | asset_url }}');"></span>
          <span class="faq-row__symbol faq-row__symbol--minus" style="--faq-symbol: url('{{ 'faq-minus.svg' | asset_url }}');"></span>
        {% else %}
          {{- 'icon-plus.svg' | inline_asset_content -}}
        {% endif %}
      </span>
      <span class="faq-row__question" itemprop="name">{{ block_settings.question | escape }}</span>
    </summary>

    <div class="details-content faq-row__answer" itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
      <div class="faq-row__answer-text" itemprop="text">{{ block_settings.answer }}</div>
    </div>
  </details>
{%- endcapture -%}

{% render 'accordion-custom-component',
  children: faq_row_details,
  close_with_escape: true,
  open_by_default_on_desktop: block_settings.open_by_default,
  open_by_default_on_mobile: block_settings.open_by_default
%}
{% endif %}

{% stylesheet %}
  .faq-row {
    padding: 30px 20px;
    background-color: var(--faq-row-background, #e5e6ff);
    border-radius: var(--faq-row-radius, 16px);
    box-shadow: var(--faq-row-shadow, none);
    transition: box-shadow var(--animation-speed-slow) var(--animation-easing);
  }

  .faq-row[open] {
    box-shadow: var(--faq-row-shadow-open, var(--faq-row-shadow, none));
  }

  .faq-row__summary {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-block: 0;
    padding-inline: 0;
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--faq-question-color, #3f4eff);
  }

  .faq-row__summary:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: 4px;
    border-radius: 8px;
  }

  .faq-row__summary .faq-row__toggle {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-inline-start: 0;
    color: var(--faq-icon-color, #3f4eff);
    background-color: #ffffff;
    border-radius: 50%;
  }

  .faq-row__toggle svg {
    display: block;
    width: 14px;
    height: 14px;
  }

  .faq-row__symbol {
    grid-area: 1 / 1;
    inline-size: 16px;
    block-size: 16px;
    background-color: currentColor;
    mask: var(--faq-symbol) center / 16px 16px no-repeat;
    opacity: 1;
    transform: rotate(0deg);
    transition:
      opacity var(--animation-speed) var(--animation-easing),
      transform var(--animation-speed) var(--animation-easing);
  }

  .faq-row__symbol--minus {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .faq-row[open] .faq-row__symbol--plus {
    opacity: 0;
    transform: rotate(90deg);
  }

  .faq-row[open] .faq-row__symbol--minus {
    opacity: 1;
    transform: rotate(0deg);
  }

  .faq-row__question {
    min-width: 0;
    color: var(--faq-question-color, #3f4eff);
    text-wrap: pretty;
  }

  .faq-row__answer {
    padding-block: var(--faq-answer-padding-block, 16px);
    padding-inline-start: calc(32px + 16px);
    font-family: Montserrat;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--faq-answer-color, #595959);
  }

  .faq-row__answer-text > :first-child {
    margin-block-start: 0;
  }

  .faq-row__answer-text > :last-child {
    margin-block-end: 0;
  }

  @media screen and (max-width: 749px) {
    .faq-row {
      padding: 20px 16px;
    }

    .faq-row__summary {
      gap: 12px;

    }

    .faq-row__summary .faq-row__toggle {
      width: 28px;
      height: 28px;
    }

    .faq-row__toggle svg {
      width: 12px;
      height: 12px;
    }

    .faq-row__answer {
      padding-block: var(--faq-answer-padding-block-mobile, 12px 24px);
      padding-inline-start: calc(28px + 12px);

    }
  }
  /* The shared accordion owns height, padding and content-visibility transitions. */
  @media (prefers-reduced-motion: reduce) {
    .faq-row,
    .faq-row.faq-row::details-content,
    .faq-row .details-content,
    .faq-row__symbol {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.accordion_row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "t:settings.title",
      "default": "What is MarTech, and how can it support global growth?"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "t:settings.description"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "t:settings.open_by_default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.accordion_row",
      "category": "t:categories.layout",
      "settings": {
        "question": "What is MarTech, and how can it support global growth?"
      }
    }
  ]
}
{% endschema %}
