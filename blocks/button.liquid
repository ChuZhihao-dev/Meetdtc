
{% render 'button', link: block.settings.link %}

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-unstyled",
          "label": "t:options.link"
        },
        {
          "value": "button-custom",
          "label": "t:options.custom"
        }
      ],
      "default": "button",
      "info": "t:info.edit_button_style_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "link_text_color",
      "label": "t:settings.link_text_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.style_class == 'button-unstyled' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance",
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "checkbox",
      "id": "button_gradient",
      "label": "t:settings.gradient_background",
      "default": false,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "color",
      "id": "button_gradient_from",
      "label": "t:settings.gradient_color_from",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' and block.settings.button_gradient }}"
    },
    {
      "type": "color",
      "id": "button_gradient_to",
      "label": "t:settings.gradient_color_to",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' and block.settings.button_gradient }}"
    },
    {
      "type": "range",
      "id": "button_gradient_angle",
      "label": "t:settings.gradient_angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "deg",
      "default": 90,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' and block.settings.button_gradient }}"
    },
    {
      "type": "range",
      "id": "button_gradient_start_position",
      "label": "t:settings.gradient_start_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' and block.settings.button_gradient }}"
    },
    {
      "type": "range",
      "id": "button_gradient_end_position",
      "label": "t:settings.gradient_end_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' and block.settings.button_gradient }}"
    },
    {
      "type": "checkbox",
      "id": "button_custom_radius",
      "label": "t:settings.custom_radius",
      "default": false,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' and block.settings.button_custom_radius }}"
    },
    {
      "type": "header",
      "content": "t:content.typography",
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "select",
      "id": "button_font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--font-accent--family)",
          "label": "t:options.accent"
        }
      ],
      "default": "",
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "select",
      "id": "button_font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        },
        {
          "value": "1.25rem",
          "label": "20px"
        },
        {
          "value": "1.375rem",
          "label": "22px"
        },
        {
          "value": "1.5rem",
          "label": "24px"
        }
      ],
      "default": "",
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "t:settings.weight",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "100",
          "label": "100"
        },
        {
          "value": "200",
          "label": "200"
        },
        {
          "value": "300",
          "label": "300"
        },
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        },
        {
          "value": "800",
          "label": "800"
        },
        {
          "value": "900",
          "label": "900"
        }
      ],
      "default": "",
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "select",
      "id": "button_letter_spacing",
      "label": "t:settings.letter_spacing",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "tight",
          "label": "t:options.tight"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "loose",
          "label": "t:options.loose"
        }
      ],
      "default": "",
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "select",
      "id": "button_case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "",
      "visible_if": "{{ block.settings.style_class != 'button-unstyled' }}"
    },
    {
      "type": "header",
      "content": "t:content.icon"
    },
    {
      "type": "image_picker",
      "id": "button_icon",
      "label": "t:settings.icon"
    },
    {
      "type": "range",
      "id": "button_icon_size",
      "label": "t:settings.icon_size",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.button_icon != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
