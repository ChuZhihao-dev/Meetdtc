{% doc %}
  Renders a merchant-selected article as a result card with editable case copy and metrics.
  Without an article, existing manual media and links remain available.
  @example Add a result card to Our work, select an article, and enter its case metrics.
{% enddoc %}
{% liquid
  assign block_settings = block.settings
  assign selected_article = block_settings.article
  assign card_image = block_settings.image
  assign card_url = block_settings.link
  assign card_tag = block_settings.tag
  assign article_summary = ''
  if selected_article != blank
    assign card_image = selected_article.image | default: card_image
    assign card_url = selected_article.url
    assign card_tag = card_tag | default: selected_article.title
    assign article_summary = selected_article.excerpt_or_content | strip_html | strip | truncatewords: 42
  endif
  assign image_alt = card_image.alt | default: selected_article.title | default: card_tag | default: ''
  assign default_link_label = 'growth_potential.read_more' | t
  assign link_label = block_settings.link_label | default: selected_article.title | default: card_tag | default: image_alt | default: default_link_label
  assign image_loading = 'lazy'
  if section.index <= 2
    assign image_loading = 'eager'
  endif
%}

<article class="result-card" data-reveal {{ block.shopify_attributes }}>
  {% if card_url != blank %}
    <a class="result-card__link" href="{{ card_url | escape }}">
      <span class="visually-hidden">{{ link_label | escape }}</span>
    </a>
  {% endif %}
  <div class="result-card__media">
    {%- if card_image != blank -%}
      {{
        card_image
        | image_url: width: 846
        | image_tag:
          width: card_image.width,
          height: card_image.height,
          widths: '423, 600, 846',
          sizes: '(min-width: 750px) 423px, 85vw',
          loading: image_loading,
          decoding: 'async',
          class: 'result-card__image',
          alt: image_alt
      }}
    {%- endif -%}
  </div>

  <div class="result-card__body">
    {%- if card_tag != blank -%}
      <span class="result-card__tag">{{ card_tag | escape }}</span>
    {%- endif -%}

    {%- if block_settings.description != blank -%}
      <div class="result-card__description">{{ block_settings.description }}</div>
    {%- elsif article_summary != blank -%}
      <div class="result-card__description"><p>{{ article_summary | escape }}</p></div>
    {%- endif -%}

    {% if block_settings.metric_1_value != blank or block_settings.metric_1_label != blank or block_settings.metric_2_value != blank or block_settings.metric_2_label != blank %}
      <div class="result-card__metrics">
        {% if block_settings.metric_1_value != blank or block_settings.metric_1_label != blank %}
          <div class="result-card__metric">
            {% if block_settings.metric_1_value != blank %}<span class="result-card__metric-value">{{ block_settings.metric_1_value | escape }}</span>{% endif %}
            {% if block_settings.metric_1_label != blank %}<span class="result-card__metric-label">{{ block_settings.metric_1_label | escape }}</span>{% endif %}
          </div>
        {% endif %}
        {% if block_settings.metric_2_value != blank or block_settings.metric_2_label != blank %}
          <div class="result-card__metric">
            {% if block_settings.metric_2_value != blank %}<span class="result-card__metric-value">{{ block_settings.metric_2_value | escape }}</span>{% endif %}
            {% if block_settings.metric_2_label != blank %}<span class="result-card__metric-label">{{ block_settings.metric_2_label | escape }}</span>{% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .result-card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: 100%;
    height: auto;
    padding-block: var(--work-card-padding-block-start, 46px) var(--work-card-padding-block-end, 46px);
    padding-inline: var(--work-card-padding-inline-start, 37px) var(--work-card-padding-inline-end, 37px);
    overflow: hidden;
    background-color: var(--work-card-background, #ffffff);
    border-radius: var(--work-card-radius, 16px);
  }

  .result-card__link { position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .result-card__link:focus-visible { outline: 2px solid var(--work-metric-color, var(--color-foreground)); outline-offset: -4px; }
  .result-card__description a { position: relative; z-index: 2; }

  .result-card__media {
    flex: 0 0 auto;
    width: 100%;
    aspect-ratio: 423 / 264;
    overflow: hidden;
    background-image: linear-gradient(103.31deg, #e5edfd 0.33%, #f8e5f2 99.67%);
    border-radius: var(--work-card-media-radius, 12px);
  }

  .result-card__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .result-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }

  .result-card__tag {
    align-self: flex-start;
    max-inline-size: 100%;
    overflow-wrap: anywhere;
    margin-block-start: 26px;
    padding: 6.5px 25px;
    font-family: var(--font-heading--family);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    color: var(--work-tag-color, #9a66f8);
    background-color: var(--work-tag-background, #eaebf8);
    border: 1px dashed var(--work-tag-border, #e8c1ee);
    border-radius: 5px;
  }

  .result-card__description {
    margin-block-start: 26px;
    overflow-wrap: anywhere;
    font-family: var(--font-heading--family);
    font-size: 19px;
    font-weight: 500;
    line-height: 31px;
    color: var(--work-description-color, #000000);
  }

  .result-card__metrics {
    display: flex;
    gap: 146px;
    margin-block-start: auto;
    padding-block-start: 20px;
  }

  .result-card__metric {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .result-card__metric-value {
    font-family: var(--font-body--family);
    font-size: 48px;
    font-weight: 600;
    line-height: 25.2px;
    letter-spacing: -0.99px;
    color: var(--work-metric-color, #783edf);
  }

  .result-card__metric-label {
    font-family: Inter;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--work-metric-label-color, #000000);
  }

  @media screen and (max-width: 749px) {
    .result-card {
      padding: 24px 20px;
    }

    .result-card__tag {
      margin-block-start: 20px;
    }

    .result-card__description {
      margin-block-start: 14px;

    }

    .result-card__metrics {
      gap: 20px;
      padding-block-start: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.result_card",
  "tag": null,
  "settings": [
    {
      "type": "article",
      "id": "article",
      "label": "t:names.blog_post",
      "info": "t:result_card.article_info"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "visible_if": "{{ block.settings.article == blank }}"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "t:settings.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "header",
      "content": "t:content.metric_1"
    },
    {
      "type": "text",
      "id": "metric_1_value",
      "label": "t:settings.text"
    },
    {
      "type": "text",
      "id": "metric_1_label",
      "label": "t:settings.label"
    },
    {
      "type": "header",
      "content": "t:content.metric_2"
    },
    {
      "type": "text",
      "id": "metric_2_value",
      "label": "t:settings.text"
    },
    {
      "type": "text",
      "id": "metric_2_label",
      "label": "t:settings.label"
    }
  ],
  "presets": [
    {
      "name": "t:names.result_card",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
