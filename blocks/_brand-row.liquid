{% liquid
  assign logo_motion = block.settings.logo_motion | default: 'static'
%}
{% if logo_motion != 'static' %}
  <script src="{{ 'partner-brands.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}


{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{% comment %} The original group stays selectable; runtime copies are inert and have no editor identity. {% endcomment %}
<div class="brand-row" data-motion="{{ logo_motion }}" ref="rows[]" {{ block.shopify_attributes }}>
  <div class="brand-row__track"><div class="brand-row__items">{{ children }}</div></div>
</div>

{% stylesheet %}
  .brand-row { width: 100%; min-width: 0; }
  .brand-row__track { width: 100%; }
  .brand-row__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    width: 100%;
    column-gap: var(--brand-logo-gap, 78px);
    row-gap: calc(var(--brand-logo-gap, 78px) / 2);
  }
  .brand-row--scrolling { overflow: hidden; }
  .brand-row--scrolling .brand-row__track { display: flex; width: max-content; direction: ltr; }
  .brand-row--scrolling .brand-row__items { flex: 0 0 auto; flex-wrap: nowrap; justify-content: flex-start; width: max-content; padding-inline-end: var(--brand-logo-gap, 78px); }
  .brand-row--scrolling .brand-logo { flex-shrink: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.row",
  "tag": null,
  "blocks": [
    {
      "type": "_brand-logo"
    }
  ],
  "presets": [
    {
      "name": "t:names.row",
      "category": "t:categories.storytelling"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "logo_motion",
      "label": "t:partner_brands.motion",
      "default": "static",
      "options": [
        {
          "value": "static",
          "label": "t:partner_brands.static"
        },
        {
          "value": "left",
          "label": "t:partner_brands.left"
        },
        {
          "value": "right",
          "label": "t:partner_brands.right"
        }
      ]
    }
  ]
}
{% endschema %}
