{% doc %}
  Renders an editable value card with an exported icon or merchant-selected image.
  @example Add a value proposition block to the Why choose us section.
{% enddoc %}
{% liquid
  assign block_settings = block.settings
  assign image_loading = 'lazy'
  if section.index <= 2
    assign image_loading = 'eager'
  endif
  assign icon = block_settings.icon
  assign mask_prefix = 'stroke0_' | append: block.id | append: '_'
%}

<div class="value-prop" {{ block.shopify_attributes }}>
  <div
    class="value-prop__badge{% if block_settings.image != blank %} value-prop__badge--custom{% endif %}"
    style="--value-prop-ring: {{ block_settings.circle_color | default: '#4183ff' }};"
  >
    <span
      class="value-prop__icon value-prop__icon--{{ icon }}"
      aria-hidden="true"
    >
      {%- if block_settings.image != blank -%}
        {{
          block_settings.image
          | image_url: width: 120
          | image_tag:
            widths: '40, 80, 120',
            sizes: '40px',
            class: 'value-prop__image',
            loading: image_loading,
            decoding: 'async',
            alt: ''
        }}
      {%- else -%}
        {%- capture icon_markup -%}
        {%- case icon -%}
          {%- when 'team' -%}
            {{ 'why-choose-us-team.svg' | inline_asset_content }}
          {%- when 'global' -%}
            {{ 'why-choose-us-global.svg' | inline_asset_content }}
          {%- when 'layers' -%}
            {{ 'why-choose-us-layers.svg' | inline_asset_content }}
          {%- when 'bars' -%}
            {{ 'why-choose-us-bars.svg' | inline_asset_content }}
        {%- endcase -%}
        {%- endcapture -%}
        {{ icon_markup | replace: 'stroke0_', mask_prefix }}
      {%- endif -%}
    </span>
  </div>

  {%- if block_settings.title != blank -%}
    <p class="value-prop__title">{{ block_settings.title | escape }}</p>
  {%- endif -%}

  {%- if block_settings.description != blank -%}
    <div class="value-prop__description">{{ block_settings.description }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .value-prop {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-inline-size: 0;
    min-block-size: 310px;
    padding: 24px;
    background-color: rgb(19 98 250 / 0.112);
    border-radius: 20px;
    box-shadow: 0 0 16px rgb(60 69 232 / 0.1);
    scroll-snap-align: start;
  }

  .value-prop__badge {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: 97.246px;
    block-size: 98px;
  }

  .value-prop__icon { display: grid; place-items: center; inline-size: 100%; block-size: 100%; }
  .value-prop__icon svg { inline-size: 100%; block-size: 100%; }
  .value-prop__icon ellipse[stroke] { stroke: var(--value-prop-ring); }
  .value-prop__badge--custom { background-color: #fff; border: 1px solid var(--value-prop-ring); border-radius: 50%; }
  .value-prop__image { inline-size: 40px; block-size: 40px; object-fit: contain; }

  .value-prop__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
  }

  .value-prop__description {
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
  }

  .value-prop__description > :first-child { margin-block-start: 0; }
  .value-prop__description > :last-child { margin-block-end: 0; }

  @media screen and (max-width: 749px) {
    .value-prop { min-block-size: 0; gap: 12px; padding: 20px; }
    .value-prop__badge { inline-size: 56px; block-size: 56px; }
    .value-prop__image { inline-size: 24px; block-size: 24px; }
    .value-prop__title { font-size: 14px; line-height: 1.4; }
    .value-prop__description { font-size: 13px; line-height: 1.6; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.value_prop",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "team",
          "label": "t:options.icon_team"
        },
        {
          "value": "global",
          "label": "t:options.icon_global"
        },
        {
          "value": "layers",
          "label": "t:options.icon_layers"
        },
        {
          "value": "bars",
          "label": "t:options.icon_bars"
        }
      ],
      "default": "team"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "color",
      "id": "circle_color",
      "label": "t:settings.color",
      "default": "#4183FF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Integrated, End-to-End Expertise"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description"
    }
  ],
  "presets": [
    {
      "name": "t:names.value_prop",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
