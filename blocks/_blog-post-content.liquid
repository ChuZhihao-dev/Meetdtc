{% liquid
  # Legacy embedded articles must not add padding to the header, footer or main shell.
  # Limit only their broad padding selectors; preserve title-hiding and editorial rules.
  assign article_content = article.content
  if article_content contains 'me-af-wrapper'
    assign article_content = article_content | replace: 'body:has(.me-af-wrapper) .section-content-wrapper,', '.blog-post-content .section-content-wrapper,' | replace: 'body:has(.me-af-wrapper) .section,', '.blog-post-content .section,' | replace: 'body:has(.me-af-wrapper) main', '.blog-post-content main'
  endif
%}
<div
  class="blog-post-content rte"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {{ article_content }}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: var(--normal-content-width);
    margin: 0 auto;
    color: var(--color, inherit);
  }

  .blog-post-content a {
    color: currentcolor;
  }

  @media screen and (max-width: 749px) {
    .blog-post-content { inline-size: 100%; min-inline-size: 0; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }
    .blog-post-content rte-formatter { display: block; min-inline-size: 0; }
    .blog-post-content :is(img, video, iframe, svg) { max-inline-size: 100%; }
    .blog-post-content img { block-size: auto; }
    .blog-post-content :is(h1, h2) { font-size: 24px; line-height: 1.3; }
    .blog-post-content :is(h3, h4, h5, h6) { font-size: 14px; line-height: 1.5; }
    .blog-post-content :is(p, li) { font-size: 13px; line-height: 1.7; }
    .blog-post-content :is(.rte-table-wrapper, .table-scroll) { max-inline-size: 100%; min-inline-size: 0; overflow-x: auto; overscroll-behavior-inline: contain; }
    .blog-post-content table { min-inline-size: 600px; font-size: 13px; }
    .blog-post-content :is(th, td) { padding: 10px 12px; }
    .blog-post-content pre { max-inline-size: 100%; overflow-x: auto; }

    /* Compatibility for the existing embedded editorial HTML. Keep merchant colors.
       Important declarations are limited to properties already forced by that HTML. */
    .blog-post-content .me-af-wrapper { inline-size: 100%; max-inline-size: 100%; margin-block: 0 24px !important; padding-inline: 0; font-size: 13px; line-height: 1.7; }
    .blog-post-content .verz-hero-banner { border-radius: 16px; }
    .blog-post-content .verz-hero-banner img { height: auto !important; max-height: none !important; aspect-ratio: 16 / 9; object-fit: cover; }
    .blog-post-content .verz-overlapping-holder { inline-size: 100%; margin-block-start: -16px; padding: 20px 16px; border-radius: 16px; }
    .blog-post-content .verz-grid-layout { display: block; min-inline-size: 0; }
    .blog-post-content .verz-toc { display: none; }
    .blog-post-content .verz-article-main { min-inline-size: 0; font-size: 13px; line-height: 1.7; }
    .blog-post-content .verz-article-main h1 { font-size: 16px !important; line-height: 1.3 !important; margin-block-end: 12px !important; }
    .blog-post-content .verz-article-main h2 { margin-block: 28px 12px; padding-block-start: 0; scroll-margin-block-start: calc(var(--header-height, 64px) + 16px);font-size:18px; }
    .blog-post-content .verz-article-main h3 { margin-block: 20px 8px; }
    .blog-post-content .verz-article-main p { margin-block: 0 14px; }
    /* Preserve the embedded article's original directory palette and geometry. */
    .blog-post-content .verz-mobile-toc {
      --article-toc-surface: #f9f7fc;
      --article-toc-border: #e9e4f2;
      --article-toc-radius: 12px;
      display: block;
      position: sticky;
      inset-block-start: calc(var(--article-toc-header-offset, 0px) + 8px);
      z-index: var(--layer-sticky);
      margin-block-end: 26px;
      padding: 12px 16px;
      border: 1px solid var(--article-toc-border);
      border-radius: var(--article-toc-radius);
      background: var(--article-toc-surface);
    }
    #header-group:has(#header-component[sticky='always'], #header-component[sticky='scroll-up'][data-sticky-state='active']) ~ * .blog-post-content {
      --article-toc-header-offset: var(--header-height, 0px);
    }
    .blog-post-content .verz-mobile-toc summary {
      display: block;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: #5b34c6;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.8;
      cursor: pointer;
      list-style: none;
    }
    .blog-post-content .verz-mobile-toc summary::-webkit-details-marker { display: none; }
    .blog-post-content .verz-mobile-toc :is(summary, a):focus-visible {
      outline: 2px solid #5b34c6;
      outline-offset: 2px;
    }
    .blog-post-content .verz-mobile-toc nav {
      /* The menu visually continues the original card without moving the article. */
      display: grid;
      position: absolute;
      z-index: var(--layer-flat);
      inset-block-start: calc(100% - 13px);
      inset-inline: -1px;
      gap: 9px;
      max-block-size: max(0px, calc(100dvh - var(--article-toc-header-offset, 0px) - var(--article-toc-height, 50px) - 32px));
      overflow-y: auto;
      overscroll-behavior-block: contain;
      margin: 0;
      padding: 10px 16px 12px;
      border: 1px solid var(--article-toc-border);
      border-block-start: 0;
      border-radius: 0 0 var(--article-toc-radius) var(--article-toc-radius);
      background: var(--article-toc-surface);
    }
    .blog-post-content .verz-mobile-toc[open] {
      border-end-start-radius: 0;
      border-end-end-radius: 0;
      border-block-end-color: transparent;
    }
    .blog-post-content .verz-mobile-toc a {
      display: block;
      padding: 0;
      color: #5e5a8a;
      font-size: 12.5px;
      line-height: 1.8;
      text-decoration: none;
    }
    .blog-post-content:has(.verz-mobile-toc) .verz-article-main [id] {
      scroll-margin-block-start: calc(var(--article-toc-header-offset, 0px) + var(--article-toc-height, 50px) + 24px);
    }
    .blog-post-content .article-meta-row { flex-wrap: wrap; gap: 8px; margin-block-end: 16px; padding-block-end: 12px; font-size: 12px; }
    .blog-post-content .article-meta-row span + span { padding-inline-start: 8px; }
    .blog-post-content .verz-deck { font-size: 13px; line-height: 1.7; }
    .blog-post-content :is(.af-definition, .af-flow, .af-insight) { margin-block: 20px; padding: 16px; }
    .blog-post-content .af-definition p { font-size: 13px; line-height: 1.7; }
    .blog-post-content .af-eyebrow { font-size: 12px; letter-spacing: normal; }
    .blog-post-content .af-flow ol { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .blog-post-content .af-flow li { font-size: 14px; }
    .blog-post-content .af-flow figcaption strong { font-size: 14px; line-height: 1.5; }
    .blog-post-content .checklist-list li { font-size: 14px; line-height: 1.6; }
    .blog-post-content .af-faq-section { margin-block: 24px; }
    .blog-post-content .af-faq-item summary { gap: 12px; min-block-size: 44px; padding: 12px; font-size: 14px; line-height: 1.5; }
    .blog-post-content .af-faq-item summary::after { flex-shrink: 0; }
    .blog-post-content .af-faq-item .faq-answer { padding: 0 12px 12px; font-size: 13px; line-height: 1.7; }
    .blog-post-content .me-standard-cta { gap: 12px !important; margin-block: 24px 0 !important; padding: 16px !important; }
    .blog-post-content .me-standard-cta h3 { font-size: 14px !important; line-height: 1.5; }
    .blog-post-content .me-standard-cta a.cta-btn { inline-size: 100%; min-block-size: 44px; padding: 10px 12px !important; white-space: normal !important; text-align: center; line-height: 1.5; }

    /* Shared case-study HTML used by Our Work articles. */
    .blog-post-content .case-study-wrapper { min-inline-size: 0; font-size: 13px; line-height: 1.7; }
    .blog-post-content .case-study-cover-img { height: auto; margin-block: 0 20px !important; }
    .blog-post-content .case-study-wrapper h2 { margin-block: 28px 12px !important; font-size: 18px !important; line-height: 1.3; }
    .blog-post-content .case-study-wrapper h3 { margin-block: 20px 8px !important; font-size: 14px !important; line-height: 1.5; }
    .blog-post-content .case-study-wrapper p { margin-block: 0 14px; font-size: 13px; line-height: 1.7; }
    .blog-post-content .case-study-wrapper ul { margin-block: 0 20px; padding-inline-start: 20px; }
    .blog-post-content .case-study-wrapper li { margin-block-end: 8px; font-size: 14px; line-height: 1.6; }
    .blog-post-content .case-study-meta-box { grid-template-columns: minmax(0, 1fr); gap: 12px; margin-block: 24px; }
    .blog-post-content .case-study-meta-item { display: grid; grid-template-columns: 80px minmax(0, 1fr); align-items: baseline; gap: 12px; min-inline-size: 0; }
    .blog-post-content .case-study-meta-item .label { margin: 0; font-size: 12px; line-height: 1.5; letter-spacing: normal; }
    .blog-post-content .case-study-meta-item .value { min-inline-size: 0; font-size: 14px; line-height: 1.6; }
    .blog-post-content .case-study-results-box { margin-block: 24px; padding: 16px; }
    .blog-post-content .case-study-results-box h3 { margin-block: 0 12px !important; }
    .blog-post-content .case-study-results-box ul { margin: 0; }
    .blog-post-content .case-study-results-box li:last-child { margin-block-end: 0; }
    .blog-post-content .case-study-table :is(th, td) { padding: 10px 12px; font-size: 13px; line-height: 1.6; }
    .blog-post-content .case-study-cta-box { gap: 12px !important; margin-block: 24px !important; padding: 16px !important; }
    .blog-post-content .case-study-cta-box h3 { margin: 0 !important; }
    .blog-post-content .case-study-cta-box .cta-btn { min-block-size: 44px; padding: 10px 12px !important; font-size: 14px !important; line-height: 1.5; white-space: normal !important; text-align: center; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ],
  "presets": [
    {
      "name": "t:names.content",
      "category": "t:categories.blog_post"
    }
  ]
}
{% endschema %}
