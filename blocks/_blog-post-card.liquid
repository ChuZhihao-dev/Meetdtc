

{%- doc -%}
  Renders a blog post card.

  @param {object} article - The article object
  @param {boolean} is_horizontal - Whether the card is horizontal or not
  @param {boolean} [is_list] - Use the main blog horizontal list presentation
  @example Used as static-blog-post-card inside main-blog with article: article, is_list: true.
  @param {string} [image_sizes] - The responsive sizes value for this card's image
  @param {string} [image_loading] - The loading strategy for this card's image
  @param {string} [image_fetch_priority] - The fetch priority for this card's image
{%- enddoc -%}

{%- assign block_settings = block.settings -%}

{% liquid
  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, section_id: block.id
  endif
%}

{% if block_settings.background_color != blank %}
  {% style %}
    blog-posts-list[section-id="{{ section.id }}"] .blog-post-item {
      --color-background: {{ block_settings.background_color }};
    }
  {% endstyle %}
{% endif %}

{% capture details %}
  {% content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text', alignment: block_settings.alignment, article: article %}
{% endcapture %}
{% capture article_title %}<h2>{{ article.title | escape }}</h2>{% endcapture %}

<div
  class="blog-post-card{% if is_list %} blog-post-card--list{% endif %}{% if block_settings.background_color != blank %} color-custom-{{ block.id }}{% endif %}{% if is_horizontal %} blog-post-card--horizontal{% endif %}"
  {{ block.shopify_attributes }}
  style="{% if block_settings.background_color != blank %}--blog-card-background: {{ block_settings.background_color }};{% endif %} --text-align: {{ block_settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }}"
>
  {% if article.image %}
    {% content_for 'block',
      id: 'image',
      type: '_blog-post-image',
      article: article,
      image_sizes: image_sizes,
      image_loading: image_loading,
      image_fetch_priority: image_fetch_priority
    %}
  {% elsif is_list %}
    <div class="blog-post-card__image-container blog-post-card__placeholder" aria-hidden="true">
      <span>{{ 'blog_filter.image_preview' | t }}</span>
    </div>
  {% endif %}

  <div class="blog-post-card__content">
    {% if is_list %}
      {{ details }}
    {% endif %}
    <a
      class="blog-post-card__title-link"
      href="{{ article.url }}"
      data-testid="blog-post-link"
    >
      {%- content_for 'block', id: 'heading', type: '_heading', text: article_title -%}
    </a>

    {% unless is_list %}
      {{ details }}
    {% endunless %}

    {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true, should_truncate: is_list, separate_read_more: is_list %}
  </div>
</div>

{% stylesheet %}
  .blog-post-card {
    display: flex;
    flex-direction: column;
    text-align: var(--text-align);
    column-gap: var(--columns-gap);
  }

  .blog-post-card__content {
    padding-block-start: 0.4rem;
    display: flex;
    flex-direction: column;
  }

  .blog-post-card--horizontal .blog-post-card__title-link .spacing-style,
  .blog-post-card--horizontal .blog-post-details,
  .blog-post-card--horizontal .blog-post-card__content-text {
    padding-inline-start: 0;
  }

  .blog-post-card__image-container,
  .blog-post-card__content {
    width: 100%;
  }

  /**
   * Horizontal layout (image left, content right)
   * Applied to hero posts based on total article count
   * Only applies the split layout when an image is actually present
   */
  .blog-post-card--horizontal {
    flex-direction: row;

    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  .blog-post-card--horizontal > .blog-post-card__image-container {
    flex-basis: 70%;
  }

  .blog-post-card--horizontal .blog-post-card__content {
    flex-basis: 30%;
    flex-grow: 1;
  }

  .blog-post-card__content a {
    display: block;
    text-wrap: pretty;
    text-decoration: none;
    padding-block-start: 0.75rem;
    color: var(--color-foreground);
  }

  .blog-post-card__content a:hover {
    color: var(--color-foreground-subdued);
  }

  a.blog-post-card__title-link {
    color: var(--color-foreground);

    &:hover {
      color: var(--color-foreground-subdued);
    }
  }
  .blog-post-card--list {
    display: grid;
    grid-template-columns: minmax(0, 390fr) minmax(0, 765fr);
    align-items: center;
    min-block-size: 280px;
    padding: 35px 28px;
    border: 1px solid var(--blog-card-border, var(--color-border));
    border-radius: 16px;
    background: var(--blog-card-background, var(--color-background));
    font-family: var(--font-heading--family);
  }
  .blog-post-card--list > .blog-post-card__image-container,
  .blog-post-card--list .blog-post-card__content { min-inline-size: 0; }
  .blog-post-card--list .blog-post-card__content { gap: 16px; padding-block-start: 0; }
  .blog-post-card--list .blog-post-card__image-container a { display: block; }
  .blog-post-card--list .blog-post-card__image { display: block; }
  .blog-post-card__placeholder {
    display: grid;
    place-items: center;
    block-size: 208px;
    border: 0.5px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    color: var(--color-foreground-muted);
    font-size: 9px;
    font-weight: 400;
  }
  .blog-post-card--list .blog-post-details { font-family: inherit; font-size: 16px; line-height: 1.5; }
  .blog-post-card--list .blog-post-card__title-link { padding-block-start: 0; overflow-wrap: anywhere; }
  .blog-post-card--list .blog-post-card__content-text { font-family: inherit; font-size: 14px; font-weight: 500; line-height: 1.41; overflow-wrap: anywhere; }
  .blog-post-card--list .blog-post-card__read-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: start;
    position: relative;
    isolation: isolate;
    inline-size: 205px;
    max-inline-size: 100%;
    min-block-size: 44px;
    padding: 5px 20px;
    border-radius: 54px;
    background: transparent;
    color: var(--blog-button-text, var(--color-primary-button-text));
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    transition: opacity var(--animation-speed) var(--ease-out-cubic);
  }
  .blog-post-card--list .blog-post-card__read-more::before {
    content: '';
    position: absolute;
    inset: 5px 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--blog-button-background, var(--color-primary-button-background));
  }
  .blog-post-card--list .blog-post-card__read-more:hover { color: var(--blog-button-text, var(--color-primary-button-text)); opacity: 0.85; }
  .blog-post-card--list a:focus-visible { outline: 2px solid var(--color-foreground); outline-offset: 4px; }
  @media screen and (max-width: 749px) {
    .blog-post-card--list { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 20px; }
    .blog-post-card--list .blog-post-card__image { block-size: auto; aspect-ratio: 390 / 208; }
    .blog-post-card__placeholder { block-size: auto; aspect-ratio: 390 / 208; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-post-card--list .blog-post-card__read-more { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
