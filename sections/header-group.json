
{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "header_section": {
      "type": "header",
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "background_color": "{{ settings.color_palette.background }}",
            "text_color": "#2f2f2f",
            "type_font_primary_size": "1rem",
            "type_font_primary_weight": "700",
            "top_level_gap": 80,
            "menu_font_style": "inverse",
            "type_font_primary_link": "heading",
            "type_case_primary_link": "none",
            "menu_style": "featured_products",
            "featured_products_aspect_ratio": "4 / 5",
            "featured_collections_aspect_ratio": "16 / 9",
            "image_border_radius": 0,
            "navigation_bar": false,
            "background_color_navigation_bar": "{{ settings.color_palette.background }}",
            "text_color_navigation_bar": "",
            "drawer_accordion": false,
            "drawer_accordion_expand_first": false,
            "drawer_dividers": false,
            "active_color": "#0032f5"
          },
          "blocks": {}
        },
        "header-cta": {
          "type": "group",
          "static": true,
          "blocks": {
            "audit-button": {
              "type": "button",
              "name": "t:names.button",
              "settings": {
                "label": "Get a Free Audit >",
                "link": "",
                "open_in_new_tab": false,
                "style_class": "button-custom",
                "custom_button_background": "#5d6eea",
                "custom_button_text": "#ffffff",
                "custom_button_border": "#ffffff00",
                "button_gradient": true,
                "button_gradient_from": "#5d6eea",
                "button_gradient_to": "#772cc7",
                "button_gradient_angle": 90,
                "button_gradient_start_position": 0,
                "button_gradient_end_position": 100,
                "button_custom_radius": true,
                "button_radius": 50,
                "button_font": "var(--font-heading--family)",
                "button_font_size": "1rem",
                "button_font_weight": "700",
                "width": "fit-content",
                "width_mobile": "fit-content"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "audit-button"
          ],
          "name": "t:names.group",
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "flex-end",
            "vertical_alignment": "center",
            "gap": 8,
            "width": "fit-content",
            "width_mobile": "fit-content",
            "height": "fit",
            "background_media": "none",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        }
      },
      "settings": {
        "logo_position": "left",
        "menu_position": "center",
        "menu_row": "top",
        "customer_account_menu": "customer-account-main-menu",
        "show_search": true,
        "search_position": "right",
        "search_row": "top",
        "show_country": true,
        "country_selector_style": false,
        "show_language": true,
        "localization_font": "heading",
        "localization_font_size": "0.875rem",
        "localization_position": "right",
        "localization_row": "top",
        "section_width": "page-width",
        "section_height": "standard",
        "enable_sticky_header": "scroll-up",
        "divider_width": 0,
        "divider_size": "page-width",
        "divider_color": "",
        "border_width": 0,
        "bottom_border_color": "",
        "actions_display_style": "icon",
        "actions_font_size": "0.875rem",
        "actions_font": "body",
        "actions_text_case": "none",
        "background_color_top": "{{ settings.color_palette.background }}",
        "text_color_top": "",
        "background_color_bottom": "",
        "text_color_bottom": "",
        "bubble_style": "default",
        "bubble_background_color": "",
        "bubble_text_color": "",
        "enable_transparent_header_home": true,
        "home_inverse_logo": false,
        "text_color_transparent_home": "",
        "enable_transparent_header_product": true,
        "product_inverse_logo": false,
        "text_color_transparent_product": "",
        "enable_transparent_header_collection": false,
        "collection_inverse_logo": false,
        "text_color_transparent_collection": ""
      }
    }
