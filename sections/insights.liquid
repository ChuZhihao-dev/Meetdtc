{% comment %}
  Insights.
  Renders an eyebrow, a gradient headline, and supporting copy above a list of
  independent horizontal article cards and a header action. Mobile retains the
  native scroll-snap carousel. Each block selects an individual Shopify blog article.
  @example
  <!-- Add Insights, select an article in each card block, and configure the header link. -->
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'scroll-reveal-styles' %}

{% liquid
  assign section_settings = section.settings
  assign heading_text = section_settings.heading
  assign card_alpha = section_settings.card_opacity | divided_by: 100.0
  assign container_alpha = section_settings.container_opacity | divided_by: 100.0
%}




<div
  class="section-background insights__background"
  style="
    --insights-bg-angle: {{ section_settings.background_gradient_angle }}deg;
    --insights-bg-from: {{ section_settings.background_gradient_from }};
    --insights-bg-to: {{ section_settings.background_gradient_to }};
  "
></div>

<scroll-reveal-component
  class="section section--page-width insights spacing-style"
  style="{% render 'spacing-style', settings: section_settings %}
    --insights-mobile-radius: {{ section_settings.card_radius_mobile }}px;
    --insights-heading-gap: {{ section_settings.heading_gap }}px;
    --insights-list-gap: {{ section_settings.list_gap }}px;
    --insights-media-width: {{ section_settings.media_width }}px;
    --insights-card-radius: {{ section_settings.card_radius }}px;
    --insights-link-color: {{ section_settings.link_color }};
    --page-content-width: {{ section_settings.content_width | default: 1276 }}px;
    --page-width: calc(var(--page-content-width) + var(--page-margin) * 2);
    --insights-button-background: {{ section_settings.button_background | default: 'linear-gradient(-82.679deg, #5D70EB 0.416%, #7C21C2 99.584%)' }};
    {% if section_settings.container_background != blank %}
      --insights-container-background: {{ section_settings.container_background | color_modify: 'alpha', container_alpha }};
    {% endif %}
    {% if section_settings.card_background != blank %}
      --insights-card-background: {{ section_settings.card_background | color_modify: 'alpha', card_alpha }};
    {% endif %}
  "
  data-reveal-scope
  {{ section.shopify_attributes }}
>
  <div class="insights__header" data-reveal>
    {% if section_settings.eyebrow != blank or heading_text != blank or section_settings.description != blank %}
      <div class="insights__intro">
        {% if section_settings.eyebrow != blank or heading_text != blank %}
        <div class="insights__title">
        {% if section_settings.eyebrow != blank %}
          <p class="insights__eyebrow">{{ section_settings.eyebrow | escape }}</p>
        {% endif %}

        {% if heading_text != blank %}
          {% render 'text-block-styles' %}
          <div
            class="
              insights__heading
              text-block
              text-block--full-width
              custom-typography
              custom-font-size
              {% if section_settings.gradient_text %}text-block--gradient{% endif %}
            "
            style="
              {% render 'typography-style', settings: section_settings, type: 'heading', preset: 'custom' %}
              --text-align: {{ section_settings.alignment }};
            "
          >
            {{ heading_text }}
          </div>
        {% endif %}

        </div>
        {% endif %}
        {% if section_settings.description != blank %}
          <div class="insights__description">{{ section_settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}
    {% if section_settings.view_all_link != blank and section_settings.view_all_label != blank %}
      <a class="insights__view-all" href="{{ section_settings.view_all_link | escape }}">
        <span>{{ section_settings.view_all_label | remove: '→' | strip | escape }}</span>
        <img src="{{ 'insights-arrow.svg' | asset_url }}" width="24" height="24" alt="" aria-hidden="true" loading="lazy">
      </a>
    {% endif %}
  </div>

  {% capture article_cards %}
    {% content_for 'blocks' %}
  {% endcapture %}
  {% if article_cards != blank %}
    <div class="insights__list" tabindex="0"{% if heading_text != blank %} role="region" aria-label="{{ heading_text | strip_html | escape }}"{% endif %}>{{ article_cards }}</div>
  {% endif %}

</scroll-reveal-component>

{% stylesheet %}
  .insights__background {
    background-image: linear-gradient(
      var(--insights-bg-angle, 180deg),
      var(--insights-bg-from, #aac5ff) 0%,
      var(--insights-bg-to, #c9d5fd) 100%
    );
  }

  .insights__intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .insights__eyebrow {
    margin: 0;
    font-family: Montserrat;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .insights__heading {
    color: var(--color-foreground);
  }

  .insights__description {
    font-family: Montserrat;
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-foreground);
    text-wrap: pretty;
  }

  .insights__description > :first-child {
    margin-block-start: 0;
  }

  .insights__description > :last-child {
    margin-block-end: 0;
  }

  .insights__list {
    display: flex;
    flex-direction: column;
    gap: var(--insights-list-gap, 16px);
    width: 100%;
    margin-block-start: var(--insights-heading-gap, 40px);
    padding: 24px;
    background-color: var(--insights-container-background, rgb(255 255 255 / 0.6));
    border-radius: var(--insights-card-radius, 27px);
  }

  .insights__view-all {
    position: relative;
    display: inline-flex;
    justify-self: start;
    margin-block-start: 24px;
    font-family: Montserrat;
    font-size: 15px;
    font-weight: 700;
    line-height: 25px;
    color: var(--insights-link-color, #106EFA);
  }

  /* Underline via pseudo-element: hidden by default; draws in left-to-right on hover. */
  .insights__view-all::after,
  .insight-row__read::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0.3em;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s ease;
  }

  .insights__view-all:hover::after,
  .insight-row__read:hover::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .insights__view-all::after,
    .insight-row__read::after {
      transition: none;
    }
  }

  .insight-row {
    position: relative;
    display: flex;
    gap: 32px;
    padding: 24px;
    color: inherit;
    text-decoration: none;
    background-color: var(--insights-card-background, rgb(255 255 255 / 0.8));
    border-radius: var(--insights-card-radius, 27px);
    box-shadow: 3px 4px 12.1px 0 #3c45e840;
  }

  .insight-row__media {
    position: relative;
    flex: 0 0 var(--insights-media-width, 260px);
    width: var(--insights-media-width, 260px);
    max-width: 100%;
    aspect-ratio: 366/175;
    background-image: linear-gradient(
      100.56deg,
      rgb(229 228 252 / 0.8) 1.45%,
      rgb(224 238 250 / 0.8) 98.55%
    );
    border-radius: var(--insights-card-radius, 27px);
    overflow: hidden;
  }

  .insight-row__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .insight-row__body {
    max-width: 625px;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .insight-row__header {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    justify-content: space-between;
    padding-inline-end: 74px;
  }

  .insight-row__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    color: #000000;
    overflow-wrap: anywhere;
  }

  .insight-row__read {
    position: absolute;
    top: 18px;
    inset-inline-end: 34px;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading--family);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 25px;
    white-space: nowrap;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .insight-row__answer {
    max-width: 625px;
    margin-block-start: 15px;
    font-family: Montserrat;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.6;
    color: #000000;
  }

  .insight-row__answer > :first-child {
    margin-block-start: 0;
  }

  .insight-row__answer > :last-child {
    margin-block-end: 0;
  }

  /* Card hover: lift, deepen the shadow, and gently zoom the image. */
  @media (hover: hover) {
    .insight-row {
      transition:
        transform 0.35s var(--ease-out-cubic),
        box-shadow 0.35s var(--ease-out-cubic);
    }

    .insight-row:hover {
      transform: translateY(-4px);
      box-shadow: 3px 10px 28px 0 #3c45e840;
    }

    .insight-row:hover .insight-row__read::after {
      transform: scaleX(1);
    }

    .insight-row__image {
      transition: transform 0.5s var(--ease-out-cubic);
    }

    .insight-row:hover .insight-row__image {
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .insight-row,
    .insight-row__image {
      transition: none;
    }

    .insight-row:hover {
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .insights__list{
      padding:20px;
    }
    .insight-row{
      padding:20px;
    }
    .insights__description {
      font-size: 1rem;
    }

    .insight-row {
      flex-direction: column;
    }

    .insight-row__media {
      flex-basis: auto;
      width: 100%;
    }

    .insight-row__read {
      position: static;
    }

    .insight-row__header {
      padding-inline-end: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .insights__heading.custom-font-size { font-size: 1.75rem; line-height: 1.25; }
    .insights__heading > * { font-size: inherit; line-height: inherit; }
    .insights__description { font-size: 16px; line-height: 1.5; }
    .insights__list { padding: 12px; margin-block-start: 24px; }
    .insight-row { gap: 20px; padding: 16px; min-width: 0; }
    .insight-row__header { flex-direction: column; gap: 8px; }
    .insight-row__title { font-size: 16px; line-height: 1.35; }
    .insight-row__read { min-height: 44px; }
    .insight-row__answer { margin-block-start: 12px; }
  }
  @media screen and (max-width: 749px) {
    .insights__list { gap: 16px; border-radius: var(--insights-mobile-radius, 16px); }
    .insight-row { gap: 16px; border-radius: var(--insights-mobile-radius, 16px); }
    .insight-row__media { border-radius: max(0px, calc(var(--insights-mobile-radius, 16px) - 4px)); }
    .insights__view-all { min-height: 44px; align-items: center; margin-block-start: 16px; }
  }
  /* Shared mobile scale for every instance of this component. */
  @media screen and (max-width: 749px) {
    .insights { padding-block: min(var(--padding-block-start), 32px) min(var(--padding-block-end), 32px); }

    .insights .insights__intro { gap: 12px; }
    .insights .insights__eyebrow { font-size: 12px; }
    .insights .insights__heading.custom-font-size { font-size: 24px; line-height: 1.25; }
    .insights .insights__description { font-size: 13px; line-height: 1.6; }
    .insights .insight-row__title { font-size: 14px; line-height: 1.4; }
    .insights :is(.insight-row__read, .insights__view-all) { font-size: 14px; }
    .insights .insight-row__answer { font-size: 13px; line-height: 1.6; }
  }
  .insights__list:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: calc(var(--focus-outline-width) * -1);
  }

  @media screen and (max-width: 749px) {
    /* Keep the heading aligned while cards bleed to the viewport edges. */
    .insights > .insights__list {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 85%;
      gap: 16px;
      padding-block: 0 8px;
      padding-inline: var(--page-margin);
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;
      scroll-snap-type: inline mandatory;
      scroll-padding-inline: var(--page-margin);
      background: transparent;
      border-radius: 0;
    }

    .insights .insight-row__read { display: none; }
    .insights__list::-webkit-scrollbar { display: none; }
    .insights__list > .insight-reveal { min-inline-size: 0; scroll-snap-align: start; }
    .insights__list .insight-row { block-size: 100%; }
    .insights > .insights__list:has(> .insight-reveal:only-child) { grid-auto-columns: 100%; }
  }
  @media screen and (max-width: 749px) {
    /* Vertical reveal/hover motion creates a second scroll axis inside the carousel. */
    .insights .insights__list > .insight-reveal[data-reveal] {
      transform: none;
      translate: none;
      transition-property: opacity;
    }
    .insights .insights__list .insight-row:hover { transform: none; translate: none; }
  }

  .insights__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
    min-inline-size: 0;
  }

  .insights__header > .insights__intro {
    gap: 26px;
    min-inline-size: 0;
    max-inline-size: 628px;
  }

  .insights__title {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-inline-size: 0;
  }

  .insights__description {
    font-weight: 400;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
  }

  .insights__header > .insights__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: end;
    gap: 6px;
    max-inline-size: 100%;
    min-block-size: 44px;
    margin-block: 0;
    padding: 10px 26px;
    border-radius: 47px;
    background: var(--insights-button-background);
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .insights__view-all img {
    flex: none;
    inline-size: 24px;
    block-size: 24px;
  }

  .insights__view-all span {
    min-inline-size: 0;
  }

  .insights__view-all:dir(rtl) img {
    transform: scaleX(-1);
  }

  .insights__view-all::after,
  .insight-row__read::after {
    content: none;
  }

  .insights > .insights__list {
    padding-block: 0;
  }

  .insights .insight-row {
    box-shadow: 0 0 16px rgb(60 69 232 / 0.1);
  }

  .insights .insight-reveal:first-child .insight-row {
    box-shadow: 0 0 16px rgb(60 69 232 / 0.2);
  }

  .insight-row__title {
    font-weight: 600;
  }

  .insight-row__answer {
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  .insight-row__read {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (hover: hover) {
    .insights .insight-row:hover {
      box-shadow: 0 0 16px rgb(60 69 232 / 0.2);
    }
  }

  @media screen and (min-width: 750px) {
    .insights > .insights__list {
      padding-inline: 0;
    }

    .insights .insight-row {
      display: grid;
      grid-template-columns: minmax(0, var(--insights-media-width)) minmax(0, 1fr) auto;
      align-items: center;
      gap: clamp(24px, 4.5vw, 64px);
      min-block-size: 220px;
      padding: 20px 24px;
    }

    .insights .insight-row__media {
      inline-size: 100%;
      aspect-ratio: 386 / 180;
    }

    .insights .insight-row__body {
      gap: 26px;
      max-inline-size: 610px;
    }

    .insights .insight-row__header {
      padding-inline-end: 0;
    }

    .insights .insight-row__answer {
      margin-block-start: 0;
    }

    .insights .insight-row__read {
      position: static;
      align-self: start;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .insights .insight-row {
      grid-template-columns: minmax(0, 30%) minmax(0, 1fr);
      gap: 20px 24px;
    }

    .insights .insight-row__media {
      grid-row: 1 / span 2;
    }

    .insights .insight-row__read {
      grid-column: 2;
      justify-self: end;
    }
  }

  @media screen and (max-width: 749px) {
    .insights__header {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .insights__header > .insights__intro {
      gap: 16px;
    }

    .insights__header > .insights__view-all {
      justify-self: start;
    }

    .insights > .insights__list {
      padding-block: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.insights",
  "max_blocks": 12,
  "blocks": [{ "type": "_insight-article" }],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "range",
      "id": "content_width",
      "label": "t:settings.content_width",
      "min": 1040,
      "max": 1440,
      "step": 4,
      "unit": "px",
      "default": 1276
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "INSIGHTS"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "<p>Real Questions. Plain Answers.</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description",
      "default": "<p>The three things almost every client asks before they start.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Read"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--font-accent--family)",
          "label": "t:options.accent"
        }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "1.5rem",
          "label": "24px"
        },
        {
          "value": "1.875rem",
          "label": "30px"
        },
        {
          "value": "2rem",
          "label": "32px"
        },
        {
          "value": "2.25rem",
          "label": "36px"
        },
        {
          "value": "2.375rem",
          "label": "38px"
        },
        {
          "value": "2.5rem",
          "label": "40px"
        },
        {
          "value": "3rem",
          "label": "48px"
        },
        {
          "value": "3.625rem",
          "label": "58px"
        }
      ],
      "default": "2.5rem"
    },
    {
      "type": "select",
      "id": "weight",
      "label": "t:settings.weight",
      "options": [
        {
          "value": "400",
          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "t:settings.line_height",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "1",
          "label": "1.0"
        },
        {
          "value": "1.1",
          "label": "1.1"
        },
        {
          "value": "1.2",
          "label": "1.2"
        },
        {
          "value": "1.3",
          "label": "1.3"
        },
        {
          "value": "1.4",
          "label": "1.4"
        },
        {
          "value": "1.5",
          "label": "1.5"
        }
      ],
      "default": "1.1"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "t:settings.letter_spacing",
      "options": [
        {
          "value": "tight",
          "label": "t:options.tight"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "loose",
          "label": "t:options.loose"
        }
      ],
      "default": "normal"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "wrap",
      "label": "t:settings.wrap",
      "options": [
        {
          "value": "pretty",
          "label": "t:options.pretty"
        },
        {
          "value": "balance",
          "label": "t:options.balance"
        },
        {
          "value": "nowrap",
          "label": "t:options.none"
        }
      ],
      "default": "balance"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "gradient_text",
      "label": "t:settings.gradient_text",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.background"
    },
    {
      "type": "color",
      "id": "background_gradient_from",
      "label": "t:settings.gradient_color_from",
      "default": "#AAC5FF"
    },
    {
