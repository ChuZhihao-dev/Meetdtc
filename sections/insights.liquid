      "content": "t:content.cards_layout"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "t:settings.width",
      "min": 120,
      "max": 420,
      "step": 4,
      "unit": "px",
      "default": 260
    },
    {
      "type": "range",
