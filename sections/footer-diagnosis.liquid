{% comment %}
  Growth diagnosis: introduction, feature list and native Shopify enquiry form.
  Owns the shared diagnosis drawer and its form styling.
  Page rules omit only the consultation region; the drawer remains rendered.
  @example Add to the footer group; edit introduction, feature blocks and form labels.
{% endcomment %}

<script
  src="{{ 'footer-diagnosis.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign section_settings = section.settings
  assign form_id = 'FooterDiagnosis-' | append: section.id
  assign form_anchor_id = section_settings.form_anchor_id | strip | remove: '#' | handleize
  assign show_diagnosis = true
  assign current_title = page.title | default: product.title | default: article.title | default: collection.title | default: blog.title | default: page_title | strip | downcase
  assign current_handle = page.handle | default: product.handle | default: article.handle | default: collection.handle | default: blog.handle | downcase
  assign current_path = request.path | downcase
  assign excluded_names = section_settings.hidden_pages | replace: '，', ',' | newline_to_br | replace: '<br />', ',' | split: ','
  for excluded_name in excluded_names
    assign excluded_name = excluded_name | strip | downcase
    if excluded_name == blank
      continue
    endif
    if excluded_name == current_title or excluded_name == current_handle or excluded_name == current_path
      assign show_diagnosis = false
      break
    endif
    if template.name == 'index' and excluded_name == '首页'
      assign show_diagnosis = false
      break
    endif
  endfor
%}



{% if show_diagnosis %}
  <div class="section-background footer-diagnosis__background"
    style="background: linear-gradient(116.77deg, {{ section_settings.gradient_left }} 0%, {{ section_settings.gradient_middle }} 55%, {{ section_settings.gradient_right }} 100%);"></div>
{% endif %}

<div
  class="section section--page-width footer-diagnosis spacing-style{% unless show_diagnosis %} footer-diagnosis--drawer-only{% endunless %}"
  style="{% render 'spacing-style', settings: section_settings %}
    --fd-card-bg: {{ section_settings.card_background }};
    --fd-card-radius: {{ section_settings.card_radius }}px;
    --fd-input-radius: {{ section_settings.input_radius }}px;
    --fd-btn-from: {{ section_settings.button_gradient_start }};
    --fd-btn-to: {{ section_settings.button_gradient_end }};
    --fd-column-gap: {{ section_settings.desktop_column_gap }}px;
  "
  {{ section.shopify_attributes }}
>
  {% if show_diagnosis %}
  <div class="footer-diagnosis__top">
    <div class="footer-diagnosis__intro">
      {% if section_settings.eyebrow != blank %}
        <p class="footer-diagnosis__eyebrow">{{ section_settings.eyebrow }}</p>
      {% endif %}

      {% if section_settings.heading != blank %}
        <div class="footer-diagnosis__heading rte">{{ section_settings.heading }}</div>
      {% endif %}

      {% if section_settings.description != blank %}
        <div class="footer-diagnosis__description rte">{{ section_settings.description }}</div>
      {% endif %}

      {%- capture features -%}
        {% for block in section.blocks %}
          {%- if block.type == 'feature' -%}
            {%- liquid
              assign feature_icon = block.settings.icon
              assign custom_icon = block.settings.custom_icon
            -%}
            <li class="footer-diagnosis__feature" {{ block.shopify_attributes }}>
              <span class="footer-diagnosis__feature-icon" aria-hidden="true">
                {%- if custom_icon != blank -%}
                  {{
                    custom_icon
                    | image_url: width: 80
                    | image_tag: widths: '40, 80', sizes: '20px', loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                    {%- case feature_icon -%}
                      {%- when 'arrow_up_right' -%}
                        <path d="M7 17 17 7" /><path d="M8 7h9v9" />
                      {%- when 'browser' -%}
                        <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18" />
                      {%- when 'shield' -%}
                        <path d="M12 3l7 3v6c0 4.2-3 7-7 9-4-2-7-4.8-7-9V6z" />
                      {%- else -%}
                        <path d="m5 12 5 5 9-11" />
                    {%- endcase -%}
                  </svg>
                {%- endif -%}
              </span>
              <span class="footer-diagnosis__feature-text">{{ block.settings.text }}</span>
            </li>
          {%- endif -%}
        {% endfor %}
      {%- endcapture -%}

      {% if features != blank %}
        <ul class="footer-diagnosis__features">{{ features }}</ul>
      {% endif %}
    </div>

    {% render 'custom-footer-diagnosis-form', section_settings: section_settings, form_id: form_id, form_anchor_id: form_anchor_id %}
  </div>
  {% endif %}

  {% render 'growth-diagnosis-drawer', section_settings: section_settings, section_id: section.id %}
</div>

{% stylesheet %}
  .footer-diagnosis--drawer-only { padding-block: 0; }

  .footer-diagnosis {
    font-family: var(--font-heading--family);
    color: #ffffff;
  }

  .footer-diagnosis__top {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: var(--fd-column-gap, 48px);
    align-items: start;
    width: 100%;
  }

  .footer-diagnosis__intro {
    display: flex;
    flex-direction: column;
    gap: 15px;
    min-width: 0;
  }

  .footer-diagnosis__eyebrow {
    margin: 0;
    font-weight: 500;
    font-size: var(--fluid-body-24, 24px);
    line-height: var(--fluid-leading-1-583333, 38px);
    text-transform: uppercase;
  }

  .footer-diagnosis__heading {
    font-weight: 700;
    font-size: var(--fluid-heading-46-1, 46.1px);
    line-height: var(--fluid-leading-1-171367, 54px);
  }

  .footer-diagnosis__heading > :first-child,
  .footer-diagnosis__heading > :last-child {
    margin-block: 0;
  }

  .footer-diagnosis__description {
    font-weight: 500;
    font-size: var(--fluid-body-24, 24px);
    line-height: 120%;
letter-spacing: normal;

  }

  .footer-diagnosis__description > :first-child,
  .footer-diagnosis__description > :last-child {
    margin-block: 0;
  }

  .footer-diagnosis__features {
    display: flex;
    flex-direction: column;
    gap: 21px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-diagnosis__feature {
    display: flex;
    gap: 14px;
    align-items: center;
    font-weight: 600;
    font-size: var(--fluid-body-20, 20px);
    line-height: 100%;
  }

  .footer-diagnosis__feature-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 56px;
    height: 56px;
    background-color: #7088FE;
    border-radius: 50%;
  }

  .footer-diagnosis__feature-icon svg,
  .footer-diagnosis__feature-icon img {
    display: block;
    width: 24px;
    height: 24px;
  }

  .footer-diagnosis__card {
    display: block;
    scroll-margin-block-start: calc(var(--header-group-height, 0px) + 24px);
    padding: 46px 42px;
    color: #111111;
    background-color: var(--fd-card-bg, #FBFBFB);
    border-radius: var(--fd-card-radius, 40px);
  }

  .footer-diagnosis__form {
    display: block;
  }

  .footer-diagnosis__fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 30px 19px;
  }

  .footer-diagnosis__field {
    display: flex;
    flex-direction: column;
    gap: 11px;
    min-width: 0;
  }

  .footer-diagnosis__field--full {
    grid-column: 1 / -1;
  }

  .footer-diagnosis__label {
    font-weight: 600;
    font-size: 17px;
    line-height: 100%;
    letter-spacing: normal;
    color:#000000;
  }

  .footer-diagnosis__input {
    width: 100%;
    min-height: 44px;
    padding: 10px 20px;
    font-weight: 400;
    font-size: 15px;
    line-height: 36px;
    letter-spacing: normal;
    background-color: #ffffff;
    border: 1px solid #878787;
    border-radius: var(--fd-input-radius, 16px);
  }

  .footer-diagnosis__input::placeholder {
    color: #9aa0b4;
  }


  .footer-diagnosis__input--textarea {
    min-height: 132px;
    resize: vertical;
  }

  .footer-diagnosis__submit {
    width: 100%;
    min-height: 62px;
    padding: 13px 20px;
    font-weight: 700;
    font-size: 20px;
    line-height: 36px;
    letter-spacing: normal;
    color: #ffffff;
    cursor: pointer;
    background-image: linear-gradient(90deg, var(--fd-btn-from, #9b3cf0) 0%, var(--fd-btn-to, #4e63f0) 100%);
    border: 0;
    border-radius: 999px;
  }

  .footer-diagnosis__submit[aria-disabled='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .footer-diagnosis__error,
  .footer-diagnosis__success {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 12px 14px;
    font-size: 0.875rem;
    border-radius: 10px;
  }

  .footer-diagnosis__error {
    color: #b00020;
    background-color: #fde8ec;
  }

  .footer-diagnosis__success {
    color: #0b6b3a;
    background-color: #e7f7ee;
  }

  @media screen and (max-width: 1023px) {
    .footer-diagnosis__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .footer-diagnosis__heading {
      font-size: var(--fluid-heading-46-1, 2rem);
    }

  }

  @media screen and (max-width: 767px) {
    .footer-diagnosis__submit{
      font-size:14px;
      min-height:48px;
      padding:6px 10px;
    }
    .footer-diagnosis__card {
      padding: 20px;
    }

    .footer-diagnosis__fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer-diagnosis__heading {
      font-size: var(--fluid-heading-46-1, 1.75rem);
    }

    .footer-diagnosis__description {
      font-size: var(--fluid-body-24, 1.0625rem);
    }

  }

{% endstylesheet %}

{% schema %}
{
  "max_blocks": 4,
  "name": "t:names.footer_diagnosis",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "feature",
      "name": "t:names.footer_feature",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:settings.icon",
          "options": [
            {
              "value": "arrow_up_right",
              "label": "t:options.icon_arrow_up_right"
            },
            {
              "value": "browser",
              "label": "t:options.icon_browser"
            },
            {
              "value": "check",
              "label": "t:options.icon_check"
            },
            {
              "value": "shield",
              "label": "t:options.icon_shield"
            }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "default": "Expert Diagnosis"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "textarea",
      "id": "hidden_pages",
      "label": "t:footer_surface.hidden_pages",
      "info": "t:footer_surface.hidden_pages_info",
      "placeholder": "t:footer_surface.hidden_pages_placeholder"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "FREE GROWTH DIAGNOSIS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Request a Free Growth Diagnosis"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description",
      "default": "<p>Tell us about your business and current challenges. Our team will review your needs, identify growth priorities and recommend the most suitable next steps.</p>"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:settings.text",
      "default": "Get My Free Growth Diagnosis"
    },
    {
      "type": "checkbox",
      "id": "show_advanced",
      "label": "t:footer_surface.advanced",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_left",
      "label": "t:settings.color",
      "default": "#1550FF",
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "color",
      "id": "gradient_middle",
      "label": "t:settings.color",
      "default": "#6551F5",
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "color",
      "id": "gradient_right",
      "label": "t:settings.color",
      "default": "#AF67F7",
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "text",
      "id": "form_anchor_id",
      "label": "t:footer_diagnosis.form_anchor_id",
      "info": "t:footer_diagnosis.form_anchor_info",
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.background_color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
