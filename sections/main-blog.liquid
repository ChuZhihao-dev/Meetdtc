{% comment %}
  Blog listing: editable introduction, tag navigation and horizontal article cards.
  The keyed results boundary preserves category focus during filtering and pagination.
  @example Reached through the blog template; article content comes from the current blog.
{% endcomment %}
<script src="{{ 'blog-posts-list.js' | asset_url }}" type="module"></script>
{% liquid
  render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
%}
<blog-posts-list
  class="blog-list color-custom-{{ section.id }}"
  section-id="{{ section.id }}"
  data-animate="{{ section.settings.enable_reveal }}"
  data-loading-text="{{ 'blog_filter.loading' | t | escape }}"
  data-error-text="{{ 'blog_filter.error' | t | escape }}"
  style="
    --blog-intro-background: {{ section.settings.intro_background | default: section.settings.background_color }};
    --blog-list-background: {{ section.settings.list_background | default: section.settings.background_color }};
    --blog-filter-accent: {{ section.settings.category_accent }};
    --blog-card-border: {{ section.settings.card_border }};
    --blog-card-background: {{ section.settings.card_background }};
    --blog-button-background: {{ section.settings.button_background }};
    --blog-button-text: {{ section.settings.button_text }};
  "
>
  <div class="blog-list__intro section section--page-width spacing-style"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px;">
    <div class="blog-list__intro-content">
      {% content_for 'blocks' %}
    </div>
  </div>
  <div class="blog-list__body section section--page-width spacing-style"
    style="--padding-block-end: {{ section.settings.padding-block-end }}px;">
    {% content_for 'block', type: '_blog-category-nav', id: 'static-blog-categories' %}
    <div class="blog-filter-feedback">
      <p ref="status" class="blog-filter-status visually-hidden" role="status" aria-live="polite" aria-atomic="true"></p>
      <button class="blog-filter-retry" type="button" on:click="/retry">{{ 'blog_filter.retry' | t }}</button>
    </div>
    {% paginate blog.articles by section.settings.posts_per_page %}
      <div class="blog-posts-results" tabindex="-1" on:click="blog-posts-list/navigate"
        data-hydration-key="blog-list-{{ section.id }}"
        data-current-path="{{ request.path | escape }}"
        data-loaded-text="{{ 'blog_filter.loaded' | t: count: paginate.items | escape }}">
        <div ref="grid" class="blog-posts-container">
          {% liquid
            # Sizes mirror the desktop card columns and mobile card inset.
            assign image_sizes = '(min-width: 1440px) 390px, (min-width: 750px) calc(30.97vw - 83px), calc(100vw - 76px)'
          %}
          {% for article in blog.articles %}
            {% liquid
              assign image_loading = 'lazy'
              if forloop.first
                assign image_loading = 'eager'
              endif
            %}
            <div class="blog-post-item" data-testid="blog-post-item">
              {% content_for 'block',
                id: 'static-blog-post-card',
                type: '_blog-post-card',
                article: article,
                image_sizes: image_sizes,
                image_loading: image_loading,
                image_fetch_priority: 'auto',
                is_horizontal: true,
                is_list: true
              %}
            </div>
          {% endfor %}
        </div>
        {% if blog.articles.size == 0 %}<p class="blog-filter-empty">{{ 'blog_filter.empty' | t }}</p>{% endif %}
        {% render 'pagination-controls', paginate: paginate %}
      </div>
    {% endpaginate %}
  </div>
</blog-posts-list>

{% stylesheet %}
  .blog-list {
    display: block;
    --blog-post-card-scale: 0.52;
    --columns-gap: clamp(24px, 6.67vw, 96px);
  }
  .blog-list__intro {
    --page-content-width: 1316px;
    --page-width: calc(var(--page-content-width) + var(--page-margin) * 2);
    isolation: isolate;
    padding-block-start: calc(64px + var(--padding-block-start, 0px));
    padding-block-end: 56px;
  }
  .blog-list__intro::before,
  .blog-list__body::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .blog-list__intro::before { background: var(--blog-intro-background, var(--color-background)); }
  .blog-list__intro-content { display: grid; gap: 10px; min-inline-size: 0; }
  .blog-list__body {
    --page-content-width: 1309px;
    --page-margin: max(24px, min(5.625vw, 81px), var(--safe-area-inset-left, 0px), var(--safe-area-inset-right, 0px));
    --page-width: calc(var(--page-content-width) + var(--page-margin) * 2);
    --full-page-grid-with-margins: minmax(var(--page-margin), 1fr) min(1309px, calc(100% - var(--page-margin) - min(3.47222vw, 50px))) minmax(min(3.47222vw, 50px), 1fr);
    isolation: isolate;
    padding-block-start: 53px;
  }
  .blog-list__body::before { background: var(--blog-list-background, var(--color-background)); }
  .blog-list__body .blog-categories { margin-block-end: 23px; }
  .blog-posts-results { min-inline-size: 0; scroll-margin-block-start: calc(var(--header-group-height, 0px) + 24px); }
  .blog-posts-results .pagination { --pagination-size: 44px; }
  .blog-posts-container { display: grid; gap: 10px; inline-size: 100%; }
  .blog-post-item { min-inline-size: 0; }
  .blog-filter-status { margin: 0; }
  .blog-filter-feedback { margin-block-end: 0; }
  blog-posts-list[data-error] .blog-filter-feedback { margin-block-end: 16px; }
  .blog-filter-retry { display: none; margin-block-start: 8px; min-block-size: 44px; color: inherit; cursor: pointer; }
  blog-posts-list[data-error] .blog-filter-retry { display: inline-block; }
  @media screen and (max-width: 749px) {
    .blog-list__intro { padding-block-start: calc(40px + var(--padding-block-start, 0px)); padding-block-end: 32px; }
    .blog-list__body { --page-margin: max(16px, var(--safe-area-inset-left, 0px), var(--safe-area-inset-right, 0px)); --full-page-grid-with-margins: var(--full-page-grid-margin) var(--full-page-grid-central-column-width) var(--full-page-grid-margin); padding-block-start: 24px; }
    .blog-posts-container { gap: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color_background",
      "id": "intro_background",
      "label": "t:blog_filter.intro_background",
      "default": "linear-gradient(166deg, #d9e0f9 0%, #f8f1ed 100%)"
    },
    {
      "type": "color_background",
      "id": "list_background",
      "label": "t:blog_filter.list_background",
      "default": "linear-gradient(148deg, #e6ecff 2.5%, #dbe1f8 97.5%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#4b4b4b"
    },
    {
      "type": "color",
      "id": "category_accent",
      "label": "t:blog_filter.category_accent",
      "default": "#0c23b8"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "t:blog_filter.card_border",
      "default": "#1739ba"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:blog_filter.card_background",
      "default": "#ffffff4d"
    },
    {
      "type": "color_background",
      "id": "button_background",
      "label": "t:blog_filter.button_background",
      "default": "linear-gradient(96deg, #7d38e9 0%, #607ff9 100%)"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "t:blog_filter.button_text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:blog_filter.posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "t:blog_filter.enable_reveal",
      "default": true
    }
  ]
}
{% endschema %}
