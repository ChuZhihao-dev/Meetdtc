{% comment %}
  Blog grid.
  Renders a gradient headline above a grid of cards that are generated by
  looping the articles of a selected blog. Each card links to its article, and a
  footer button links to the blog.
  @example
  <!-- Add the "Blog grid" section, then select a blog -->
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'scroll-reveal-styles' %}

{% liquid
  assign section_settings = section.settings
  assign heading_text = section_settings.heading
  assign blog = section_settings.blog
  assign post_limit = section_settings.post_limit
  assign view_all_href = section_settings.view_all_link | default: blog.url
%}

{% style %}
  #shopify-section-{{ section.id }} .blog-grid {
    --blog-bg-from: {{ section_settings.background_from }};
    --blog-bg-to: {{ section_settings.background_to }};
    --blog-columns: {{ section_settings.columns }};
    --blog-gap: {{ section_settings.gap }}px;
    --blog-heading-gap: {{ section_settings.heading_gap }}px;
    --blog-card-background: {{ section_settings.card_background }};
    --blog-card-border: {{ section_settings.card_border }};
    --blog-card-radius: {{ section_settings.card_radius }}px;
    --blog-card-padding-block-start: {{ section_settings.card_padding_block_start }}px;
    --blog-card-padding-block-end: {{ section_settings.card_padding_block_end }}px;
    --blog-card-padding-inline-start: {{ section_settings.card_padding_inline_start }}px;
    --blog-card-padding-inline-end: {{ section_settings.card_padding_inline_end }}px;
    --blog-heading-font-family: {{ section_settings.font }};
    --blog-heading-font-size: {{ section_settings.font_size }};
    --blog-heading-font-weight: {{ section_settings.weight }};
    --blog-heading-line-height: {{ section_settings.line_height | default: '1' }};
    --text-wrap: {{ section_settings.wrap | default: 'balance' }};
  }
{% endstyle %}

<div class="section-background blog-grid__background"></div>

<div
  class="section section--page-width blog-grid spacing-style"
  style="{% render 'spacing-style', settings: section_settings %}"
  data-reveal-scope
  {{ section.shopify_attributes }}
>
  {% if heading_text != blank %}
    {% render 'text-block-styles' %}
    <div
      class="
        blog-grid__heading
        text-block
        text-block--full-width
        {% if section_settings.gradient_text %}text-block--gradient{% endif %}
      "
      style="
        {% if section_settings.gradient_text %}
          --gradient-from: {{ section_settings.gradient_color_from }};
          --gradient-to: {{ section_settings.gradient_color_to }};
          --gradient-angle: 92.97deg;
          --gradient-start: 10.56%;
          --gradient-end: 89.44%;
        {% endif %}
      "
      data-reveal
    >
      {{ heading_text }}
    </div>
  {% endif %}

  {% if blog != blank and blog.articles_count > 0 %}
    <div class="blog-grid__grid">
      {%- for article in blog.articles limit: post_limit -%}
        {%- liquid
          assign article_description = article.excerpt | default: article.content
          if article_description != blank
            assign article_description = article_description | strip_html
          endif
        -%}
        <a class="blog-card" href="{{ article.url }}" aria-label="{{ article.title | escape }}" data-reveal>
          <h3 class="blog-card__title">{{ article.title }}</h3>

          {%- if article_description != blank -%}
            <div class="blog-card__excerpt">{{ article_description }}</div>
          {%- endif -%}

          {%- if section_settings.read_more_label != blank -%}
            <span class="blog-card__more">{{ section_settings.read_more_label }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {% elsif request.design_mode %}
    <div class="blog-grid__grid">
      {%- for i in (1..post_limit) -%}
        <div class="blog-card" data-reveal>
          <h3 class="blog-card__title">{{ 'content.select_article' | t }}</h3>
          <div class="blog-card__excerpt">{{ 'content.read_more' | t }}</div>
        </div>
      {%- endfor -%}
    </div>
  {% endif %}

  {% if view_all_href != blank and section_settings.view_all_label != blank %}
    <div class="blog-grid__footer">
      <a class="blog-grid__view-all" href="{{ view_all_href }}">
        {{- section_settings.view_all_label -}}
      </a>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .blog-grid__background {
    background-image: radial-gradient(
      54.79% 79.25% at 48.72% 36.96%,
      var(--blog-bg-from, #c5d9ff) 14.56%,
      var(--blog-bg-to, #a9c4ff) 100%
    );
  }

  .blog-grid__heading {
    /* Constrain the box so the text gradient spans the text rather than the
       full content width (which would shift the colours). */
    max-width: var(--max-width--display-narrow, 9.75em);
    font-family: var(--blog-heading-font-family, var(--font-heading--family));
    font-size: var(--blog-heading-font-size, 3.625rem);
    font-weight: var(--blog-heading-font-weight, 600);
    line-height: var(--blog-heading-line-height, 1);
    letter-spacing: 0;
    color: var(--color-foreground);
  }

  .blog-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--blog-columns, 3), minmax(0, 1fr));
    gap: var(--blog-gap, 32px);
    width: 100%;
    margin-block-start: var(--blog-heading-gap, 40px);
  }

  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block: var(--blog-card-padding-block-start, 24px) var(--blog-card-padding-block-end, 24px);
    padding-inline: var(--blog-card-padding-inline-start, 16px) var(--blog-card-padding-inline-end, 16px);
    color: #000000;
    text-decoration: none;
    background-color: var(--blog-card-background, rgb(255 255 255 / 0.58));
    border: 1px solid var(--blog-card-border, rgb(255 255 255 / 1));
    border-radius: var(--blog-card-radius, 13px);
    transition:
      transform 0.3s var(--ease-out-cubic),
      box-shadow 0.3s var(--ease-out-cubic);
  }

  .blog-card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 25px;
    font-weight: 600;
    line-height: 1;
    color: #000000;
    text-wrap: pretty;
  }

  .blog-card__excerpt {
    margin-block-start: 37px;
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    color: #000000;
    text-wrap: pretty;
  }

  .blog-card__more {
    position: relative;
    align-self: flex-start;
    margin-block-start: auto;
    padding-block-start: 20px;
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    color: #000000;
    text-decoration: none;
  }

  /* Read More underline: drawn with a pseudo-element, left-to-right on hover. */
  .blog-card__more::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 1px;
    background-color: currentcolor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s var(--ease-out-cubic);
  }

  .blog-grid__footer {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-block-start: 40px;
  }

  .blog-grid__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 41px;
    font-family: var(--font-heading--family);
    font-size: 21px;
    font-weight: 600;
    line-height: 1;
    color: #000000;
    text-align: center;
    text-decoration: none;
    background-color: rgb(255 255 255 / 0.58);
    border: 1px solid rgb(255 255 255 / 1);
    border-radius: 12px;
    transition: transform 0.3s var(--ease-out-cubic);
  }

  @media (hover: hover) {
    .blog-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px 0 rgb(11 34 184 / 0.15);
    }

    .blog-card:hover .blog-card__more::after,
    .blog-card__more:hover::after {
      transform: scaleX(1);
    }

    .blog-grid__view-all:hover {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .blog-grid__view-all,
    .blog-card__more::after {
      transition: none;
    }

    .blog-card:hover,
    .blog-grid__view-all:hover {
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .blog-grid__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-block-start: 24px;
    }

    .blog-grid__heading {
      font-size: 2.25rem;
    }

    .blog-card__title {
      font-size: 22px;
    }

    .blog-grid__view-all {
      width: 100%;
      padding: 16px 24px;
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_grid",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:settings.blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "t:settings.post_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "<p>Solutions Built for Measurable Growth</p>"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "t:settings.text",
      "default": "Read More"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--font-accent--family)",
          "label": "t:options.accent"
        }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "2.25rem",
          "label": "36px"
        },
        {
          "value": "2.5rem",
          "label": "40px"
        },
        {
          "value": "3rem",
          "label": "48px"
        },
        {
          "value": "3.625rem",
          "label": "58px"
        },
        {
          "value": "4rem",
          "label": "64px"
        }
      ],
      "default": "3.625rem"
    },
    {
      "type": "select",
      "id": "weight",
      "label": "t:settings.weight",
      "options": [
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "t:settings.line_height",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "1",
          "label": "1.0"
        },
        {
          "value": "1.1",
          "label": "1.1"
        },
        {
          "value": "1.2",
          "label": "1.2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "wrap",
      "label": "t:settings.wrap",
      "options": [
        {
          "value": "pretty",
          "label": "t:options.pretty"
        },
        {
          "value": "balance",
          "label": "t:options.balance"
        },
        {
          "value": "nowrap",
          "label": "t:options.none"
        }
      ],
      "default": "balance"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "gradient_text",
      "label": "t:settings.gradient_text",
      "default": true
    },
    {
      "type": "color",
      "id": "gradient_color_from",
      "label": "t:settings.gradient_color_from",
      "default": "#0B22B8",
      "visible_if": "{{ section.settings.gradient_text }}"
    },
    {
      "type": "color",
      "id": "gradient_color_to",
      "label": "t:settings.gradient_color_to",
      "default": "#9621C4",
      "visible_if": "{{ section.settings.gradient_text }}"
    },
    {
      "type": "header",
      "content": "t:content.background"
    },
    {
      "type": "color",
      "id": "background_from",
      "label": "t:settings.gradient_color_from",
      "default": "#C5D9FF"
    },
    {
      "type": "color",
      "id": "background_to",
      "label": "t:settings.gradient_color_to",
      "default": "#A9C4FF"
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.background_color",
      "alpha": true,
      "default": "#FFFFFF94"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "t:settings.border_color",
      "alpha": true,
      "default": "#FFFFFFFF"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding_inline_start",
      "label": "t:settings.left",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding_inline_end",
      "label": "t:settings.right",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.buttons"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:settings.text",
      "default": "VIEW ALL SERVICES"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.blog_grid",
      "category": "t:categories.blog_post",
      "settings": {
        "post_limit": 6,
        "heading": "<p>Solutions Built for Measurable Growth</p>",
        "read_more_label": "Read More",
        "font": "var(--font-heading--family)",
        "font_size": "3.625rem",
        "weight": "600",
        "line_height": "1",
        "wrap": "balance",
        "gradient_text": true,
        "gradient_color_from": "#0B22B8",
        "gradient_color_to": "#9621C4",
        "background_from": "#C5D9FF",
        "background_to": "#A9C4FF",
        "columns": 3,
        "gap": 32,
        "card_background": "#FFFFFF94",
        "card_border": "#FFFFFFFF",
        "card_radius": 13,
        "padding-block-start": 64,
        "padding-block-end": 64,
        "heading_gap": 40,
        "card_padding_block_start": 24,
        "card_padding_block_end": 24,
        "card_padding_inline_start": 16,
        "card_padding_inline_end": 16,
        "view_all_label": "VIEW ALL SERVICES"
      }
    }
  ]
}
{% endschema %}
