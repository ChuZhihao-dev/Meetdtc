{% comment %}
  Product solutions grid.
  Renders a configurable translucent panel with a gradient headline and service
  cards from a selected collection. Decorative icons follow product handles.
  Each card links to its product; the footer appears only with an explicit link.
  @example
  <!-- Add "Product solutions grid", then select a product collection -->
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'scroll-reveal-styles' %}

{% liquid
  assign section_settings = section.settings
  assign heading_text = section_settings.heading
  assign product_collection = section_settings.collection
  assign product_limit = section_settings.product_limit
  assign view_all_href = section_settings.view_all_link
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --solutions-section-radius: {{ section_settings.section_radius | default: 48 }}px;
    --solutions-bg-from: {{ section_settings.background_from }};
    --solutions-bg-to: {{ section_settings.background_to }};
    isolation: isolate;
  }
{% endstyle %}

<div class="section-background product-solutions-grid__background"></div>

<scroll-reveal-component
  class="section section--page-width product-solutions-grid spacing-style"
  style="{% render 'spacing-style', settings: section_settings %}
    --page-content-width: {{ section_settings.content_width | default: 1276 }}px;
    --page-width: calc(var(--page-content-width) + var(--page-margin) * 2);
    --solutions-panel-background: {{ section_settings.panel_background }};
    --solutions-panel-border: {{ section_settings.panel_border }};
    --solutions-panel-radius: {{ section_settings.panel_radius }}px;
    --solutions-panel-padding: {{ section_settings.panel_padding }}px;
    --solutions-card-text: {{ section_settings.card_text_color }};
    --solutions-card-muted: {{ section_settings.card_description_color }};
    --solutions-card-accent: {{ section_settings.card_link_color }};
    --solutions-mobile-radius: {{ section_settings.card_radius_mobile }}px;
    --solutions-bg-from: {{ section_settings.background_from }};
    --solutions-bg-to: {{ section_settings.background_to }};
    --solutions-columns: {{ section_settings.columns }};
    --solutions-gap: {{ section_settings.gap }}px;
    --solutions-heading-gap: {{ section_settings.heading_gap }}px;
    --product-solution-card-background: {{ section_settings.card_background }};
    --product-solution-card-hover-background: {{ section_settings.card_background | color_modify: 'alpha', 1 }};
    --product-solution-card-border: {{ section_settings.card_border }};
    --product-solution-card-radius: {{ section_settings.card_radius }}px;
    --product-solution-card-padding-block-start: {{ section_settings.card_padding_block_start }}px;
    --product-solution-card-padding-block-end: {{ section_settings.card_padding_block_end }}px;
    --product-solution-card-padding-inline-start: {{ section_settings.card_padding_inline_start }}px;
    --product-solution-card-padding-inline-end: {{ section_settings.card_padding_inline_end }}px;
    --solutions-heading-font-family: {{ section_settings.font }};
    --solutions-heading-font-size: {{ section_settings.font_size }};
    --solutions-heading-font-weight: {{ section_settings.weight }};
    --solutions-heading-line-height: {{ section_settings.line_height | default: 'normal' }};
    --solutions-button-from: {{ section_settings.button_gradient_from | default: '#7C21C2' }};
    --solutions-button-to: {{ section_settings.button_gradient_to | default: '#5D70EB' }};
    --solutions-button-text: {{ section_settings.button_text_color | default: '#FFFFFF' }};
    --text-wrap: {{ section_settings.wrap | default: 'balance' }};
  "
  data-reveal-scope
  {{ section.shopify_attributes }}
>
  <div class="product-solutions-grid__panel">
  {% if section_settings.eyebrow != blank %}<p class="product-solutions-grid__eyebrow" data-reveal>{{ section_settings.eyebrow | escape }}</p>{% endif %}
  {% if heading_text != blank %}
    {% render 'text-block-styles' %}
    <div
      class="
        product-solutions-grid__heading
        text-block
        text-block--full-width
        {% if section_settings.gradient_text %}text-block--gradient{% endif %}
      "
      data-reveal
    >
      {{ heading_text }}
    </div>
  {% endif %}

  {% if product_collection != blank and product_collection.products_count > 0 %}
    <div class="product-solutions-grid__grid">
      {%- for product in product_collection.products limit: product_limit -%}
        {%- liquid
          assign product_description = product.description
          if product_description != blank
            assign product_description = product_description | strip_html | truncatewords: 60
          endif
        -%}
        <a class="product-solution-card" href="{{ product.url }}" aria-label="{{ product.title | escape }}" data-reveal>
          {% if section_settings.show_icons %}{% render 'product-solution-icon', product: product %}{% endif %}
          <h3 class="product-solution-card__title">{{ product.title | escape }}</h3>

          {%- if product_description != blank -%}
            <div class="product-solution-card__excerpt">{{ product_description | escape }}</div>
          {%- endif -%}

          {%- if section_settings.read_more_label != blank -%}
            <span class="product-solution-card__more">{{ section_settings.read_more_label | escape }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {% elsif request.design_mode %}
    <div class="product-solutions-grid__grid">
      {%- for i in (1..product_limit) -%}
        <div class="product-solution-card" data-reveal>
          <h3 class="product-solution-card__title">{{ 'content.select_product_solution' | t }}</h3>
          <div class="product-solution-card__excerpt">{{ 'content.read_more' | t }}</div>
        </div>
      {%- endfor -%}
    </div>
  {% endif %}

  {% if view_all_href != blank and section_settings.view_all_label != blank %}
    <div class="product-solutions-grid__footer">
      <a class="product-solutions-grid__view-all" href="{{ view_all_href | escape }}">
        <span>{{ section_settings.view_all_label | escape }}</span>
        <img src="{{ 'product-solutions-arrow.svg' | asset_url }}" width="24" height="24" alt="" loading="lazy" aria-hidden="true">
      </a>
    </div>
  {% endif %}
  </div>
</scroll-reveal-component>

{% stylesheet %}
  .product-solutions-grid__panel {
    min-inline-size: 0;
    padding: var(--solutions-panel-padding, 52px);
    outline: 1px solid var(--solutions-panel-border, rgb(255 255 255 / 0.8));
    outline-offset: -1px;
    border-radius: var(--solutions-panel-radius, 28px);
    background: var(--solutions-panel-background, rgb(255 255 255 / 0.4));
  }

  .product-solutions-grid__eyebrow {
    margin: 0 0 12px;
    color: var(--solutions-card-muted, var(--color-foreground));
    font-family: var(--font-heading--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-solutions-grid__background {
    border-start-start-radius: var(--solutions-section-radius, 48px);
    border-start-end-radius: var(--solutions-section-radius, 48px);
    background-image: radial-gradient(
      54.79% 79.25% at 48.72% 36.96%,
      var(--solutions-bg-from, #c5d9ff) 14.56%,
      var(--solutions-bg-to, #a9c4ff) 100%
    );
  }

  .product-solutions-grid__heading.text-block {
    /* Beat shared text sizing so the gradient spans the design's heading column. */
    max-inline-size: min(707px, 100%);
  }

  .product-solutions-grid__heading {
    font-family: var(--solutions-heading-font-family, var(--font-heading--family));
    font-size: var(--solutions-heading-font-size, 3.625rem);
    font-weight: var(--solutions-heading-font-weight, 600);
    line-height: var(--solutions-heading-line-height, normal);
    letter-spacing: 0;
    color: var(--color-foreground);
  }

  .product-solutions-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--solutions-columns, 3), minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--solutions-gap, 32px);
    width: 100%;
    margin-block-start: var(--solutions-heading-gap, 40px);
  }

  .product-solution-card {
    position: relative;
    min-inline-size: 0;
    min-block-size: 248px;
    overflow-wrap: anywhere;
    display: flex;
    flex-direction: column;
    padding-block: var(--product-solution-card-padding-block-start, 24px) var(--product-solution-card-padding-block-end, 24px);
    padding-inline: var(--product-solution-card-padding-inline-start, 16px) var(--product-solution-card-padding-inline-end, 16px);
    color: var(--solutions-card-text, var(--color-foreground));
    text-decoration: none;
    background-color: var(--product-solution-card-background, rgb(255 255 255 / 0.58));
    border: 1px solid var(--product-solution-card-border, rgb(255 255 255 / 1));
    border-radius: var(--product-solution-card-radius, 13px);
    box-shadow: 0 0 16px rgb(0 0 0 / 0.1);
    transition:
      background-color var(--animation-speed) var(--animation-easing),
      box-shadow var(--animation-speed) var(--animation-easing);
  }

  .product-solution-card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-weight: 600;
    line-height: normal;
    color: var(--solutions-card-text, var(--color-foreground));
    text-wrap: pretty;
  }

  .product-solution-card__excerpt {
    margin-block-start: 20px;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--solutions-card-muted, var(--color-foreground));
    text-wrap: wrap;
  }

  .product-solution-card__more {
    position: relative;
    align-self: flex-start;
    margin-block-start: auto;
    padding-block-start: 20px;
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 500;
    line-height: normal;
    color: var(--solutions-card-accent, var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .product-solution-card:focus-visible {
    outline: var(--focus-outline-width) solid var(--solutions-card-accent, var(--color-foreground));
    outline-offset: var(--focus-outline-offset);
  }

  .product-solutions-grid__footer {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-block-start: 20px;
  }

  .product-solutions-grid__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    max-inline-size: 100%;
    min-block-size: 44px;
    padding: 10px 26px;
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--solutions-button-text, #fff);
    text-align: center;
    text-decoration: none;
    background-image: linear-gradient(97.525deg, var(--solutions-button-from, #7c21c2) 0.416%, var(--solutions-button-to, #5d70eb) 99.584%);
    border-radius: 47px;
    overflow-wrap: anywhere;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .product-solutions-grid__view-all img { flex: none; inline-size: 24px; block-size: 24px; }
  .product-solutions-grid__view-all:dir(rtl) img { transform: scaleX(-1); }
  .product-solutions-grid__view-all:focus-visible {
    outline: var(--focus-outline-width) solid var(--solutions-card-accent, var(--color-foreground));
    outline-offset: var(--focus-outline-offset);
  }

  @media (hover: hover) {
    .product-solution-card:hover {
      background-color: var(--product-solution-card-hover-background);
      box-shadow: 0 0 8px rgb(0 0 0 / 0.1);
    }

    .product-solutions-grid__view-all:hover {
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-solution-card,
    .product-solutions-grid__view-all {
      transition: none;
    }

  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .product-solutions-grid__grid { grid-template-columns: repeat(min(var(--solutions-columns, 3), 2), minmax(0, 1fr)); }
    .product-solutions-grid__panel { padding: min(var(--solutions-panel-padding, 52px), 28px); }
  }

  @media screen and (max-width: 749px) {
    .product-solutions-grid__panel { padding: min(var(--solutions-panel-padding, 52px), 16px); border-radius: min(var(--solutions-panel-radius, 28px), 20px); }
    .product-solutions-grid { padding-block: min(var(--padding-block-start), 32px) min(var(--padding-block-end), 32px); }
    .product-solutions-grid__heading { font-size: min(var(--solutions-heading-font-size, 3.625rem), 24px); line-height: 1.25; }
    .product-solutions-grid__eyebrow { font-size: 12px; margin-block-end: 12px; }
    .product-solutions-grid__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
      gap: 16px;
      margin-block-start: 24px;
    }
    .product-solution-card { min-block-size: 0; padding: 16px; border-radius: var(--solutions-mobile-radius, 12px); }
    .product-solution-card__title { font-size: 14px; line-height: 1.4; }
    .product-solution-card__excerpt { font-size: 13px; line-height: 1.6; margin-block-start: 12px; }
    .product-solution-card__more { padding-block-start: 12px; font-size: 14px; }
    .product-solutions-grid__view-all {
      min-block-size: 44px;
      padding: 10px 26px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_solutions_grid",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "range",
      "id": "content_width",
      "label": "t:settings.content_width",
      "min": 1040,
      "max": 1440,
      "step": 4,
      "unit": "px",
      "default": 1276
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "<p>Solutions Built for Measurable Growth</p>"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "t:settings.text",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "SERVICES"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "t:settings.icon",
      "default": true
    },
    {
      "type": "color",
