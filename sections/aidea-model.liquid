</aidea-model-component>

{% stylesheet %}
  .aidea-model__background {
    background: linear-gradient(122deg, var(--aidea-bg-from), var(--aidea-bg-to));
  }
  .aidea-model { display: block; overflow: clip; }
  .aidea-model__content {
    position: relative;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    min-width: 0;
  }
  .aidea-model__intro {
    position: relative;
    margin-inline: 5.833333%;
    font-family: var(--font-heading--family);
  }
  .aidea-model__heading {
    margin: 0;
    font-family: inherit;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.22;
    overflow-wrap: anywhere;
    color: #0b22b8;
    background: linear-gradient(117deg, #0b22b8 11%, #9621c4 89%);
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .aidea-model__description {
    max-width: 857px;
    margin-block: 24px 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.23;
    color: #000;
    overflow-wrap: anywhere;
  }
  .aidea-model__diagram {
    position: relative;
    aspect-ratio: 1440 / 980;
    width: 100%;
    margin-inline: auto;
    margin-block-start: 85px;
    container-type: inline-size;
    direction: ltr;
  }
  .aidea-model__asset { position: absolute; max-width: none; pointer-events: none; }
  .aidea-model__label {
    position: absolute;
    transform: translateX(-50%);
    font-family: var(--font-accent--family);
    font-weight: 700;
    text-align: center;
    color: #fff;
    overflow-wrap: anywhere;
  }
  .aidea-model__label--blue { color: #1362fa; }
  .aidea-model__mobile-labels { display: none; }

  /* Build outward from the centre; separate translate/scale preserve asset rotations and label centring. */
  .aidea-model[data-motion-ready] [data-aidea-part] {
    transition-property: opacity, translate, scale, clip-path;
    transition-duration: var(--aidea-duration, calc(var(--animation-speed-slow) * 5));
    transition-timing-function: var(--ease-out-cubic);
    transition-delay: var(--aidea-delay, 0s);
  }
  .aidea-model[data-motion-ready]:not([data-entered]) [data-aidea-part] { opacity: 0; }
  .aidea-model[data-motion-ready]:not([data-entered]) [data-aidea-part='core'] { scale: 0.94; }
  .aidea-model[data-motion-ready]:not([data-entered]) [data-aidea-part='node'] {
    translate: var(--aidea-from-x, 0cqw) var(--aidea-from-y, 0cqw);
    scale: 0.94;
  }
  .aidea-model[data-motion-ready] [data-aidea-part='line'] { clip-path: inset(0 0 0 0); }
  .aidea-model[data-motion-ready]:not([data-entered]) [data-aidea-part='line'] { clip-path: var(--aidea-line-clip); }
  @media (prefers-reduced-motion: reduce) {
    .aidea-model[data-motion-ready] [data-aidea-part] { opacity: 1; translate: none; scale: none; clip-path: none; transition: none; }
  }

  @media screen and (max-width: 749px) {
    .aidea-model__description { margin-block-start: 24px; }
    .aidea-model__diagram { width: 116%; margin-inline: -8%; margin-block-start: 40px; }
    .aidea-model__mobile-labels {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin: 24px 6% 0;
      padding: 0;
      list-style: none;
      font-family: var(--font-body--family);

      line-height: 1.4;
      color: #0b22b8;
    }
    .aidea-model__mobile-labels li { padding: 12px; border-radius: 12px; background: #ffffffb3; }
    .aidea-model__mobile-labels li:first-child { grid-column: 1 / -1; }
  }

  .aidea-model__mobile-labels { font-size: 14px; }
{% endstylesheet %}

{% schema %}
