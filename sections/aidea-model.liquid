{% comment %}
  AIDEA marketing growth model. Original Figma layers surround editable labels.
  @example Add "AIDEA model" in the theme editor and customize the model copy.
{% endcomment %}

{% unless section.settings.enable_animation == false %}
  <script src="{{ 'aidea-model.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endunless %}
<div class="section-background aidea-model__background" style="--aidea-bg-from:{{ section.settings.background_from }};--aidea-bg-to:{{ section.settings.background_to }};"></div>
<aidea-model-component data-animate="{{ section.settings.enable_animation | default: true, allow_false: true }}" class="section section--full-width spacing-style aidea-model" style="{% render 'spacing-style', settings: section.settings %}">
