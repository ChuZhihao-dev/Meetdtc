      <img class="aidea-model__asset" src="{{ 'aidea-357.svg' | asset_url }}" alt="" width="156" height="156" loading="lazy" style="left:61.875%;top:46.73469%;width:10.83333%;height:15.91837%;">
      <img class="aidea-model__asset" src="{{ 'aidea-357.svg' | asset_url }}" alt="" width="156" height="156" loading="lazy" style="left:27.15278%;top:46.73469%;width:10.83333%;height:15.91837%;">
      <div class="aidea-model__label" style="left:49.93056%;top:34.18367%;width:24.30556%;font-size:1.66667cqw;line-height:1.5;">{{ section.settings.ai_label | escape | newline_to_br }}</div>
