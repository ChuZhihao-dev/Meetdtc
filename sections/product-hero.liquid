{% comment %}
  Product hero for service pages. Header-free, start-aligned copy with up to two
  editable section-specific buttons and an optional service label list.
  @example Add Product hero, enter service labels one per line, and optionally add buttons.
{% endcomment %}

{% render 'text-block-styles' %}
{% render 'scroll-reveal-styles' %}
<script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>

<div class="section-background product-hero__background" style="--product-hero-bg-from:{{ section.settings.background_from }};--product-hero-bg-to:{{ section.settings.background_to }};"></div>
<scroll-reveal-component class="section section--page-width section--height-{{ section.settings.section_height | default: 'large' }} spacing-style product-hero" data-reveal-scope data-reveal-timeline style="{% render 'spacing-style', settings: section.settings %}--product-hero-certification-color:{{ section.settings.certification_color }};--product-hero-description-color:{{ section.settings.description_color }};--product-hero-content-position:{{ section.settings.content_position | default: 'center' }};">
  <div class="product-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="product-hero__eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <{{ section.settings.heading_tag }}
        class="product-hero__heading text-block text-block--gradient"
        data-reveal
        style="--gradient-from:{{ section.settings.heading_from }};--gradient-mid:{{ section.settings.heading_mid | default: '#8B45F0' }};--gradient-to:{{ section.settings.heading_to }};--gradient-angle:100deg;--gradient-start:0%;--gradient-end:100%;"
      >{{ section.settings.heading | escape | newline_to_br }}</{{ section.settings.heading_tag }}>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="product-hero__description" data-reveal>{{ section.settings.description | escape | newline_to_br }}</p>
    {% endif %}
    {% capture service_labels %}
      {% render 'service-labels', labels: section.settings.service_labels, color: section.settings.service_labels_color %}
    {% endcapture %}
    {% assign service_labels = service_labels | strip %}
    {% if service_labels != blank %}
      <div class="product-hero__services" data-reveal>{{ service_labels }}</div>
    {% endif %}
    {% capture actions %}{% content_for 'blocks' %}{% endcapture %}
    {% if actions != blank %}
      <div class="product-hero__actions" data-reveal>{{ actions }}</div>
    {% endif %}
    {% content_for 'block', type: '_product-hero-certifications', id: 'certifications' %}
  </div>
</scroll-reveal-component>

{% comment %}
  Output scoped CSS with the section HTML: the live compiled stylesheet has served
  stale rules after uploads. This keeps initial and section-rendered markup in sync.
{% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} .product-hero {
    display: grid;
    /* The selected height is the outer border box; padding belongs to the inner content. */
    height: var(--section-min-height);
    min-height: 0;
    padding-block: 0;
    overflow: auto;
  }
  #shopify-section-{{ section.id }} .product-hero__background {
    background-image: linear-gradient(92.19deg, var(--product-hero-bg-from) 1.07%, var(--product-hero-bg-to) 98.93%);
  }
  #shopify-section-{{ section.id }} .product-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: safe var(--product-hero-content-position, center);
    min-height: 100%;
    padding-block: calc(var(--padding-block-start, 0px) + var(--section-top-offset, 0px)) var(--padding-block-end, 0px);
    gap: 20px;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
    min-width: 0;
    font-family: var(--font-heading--family);
    text-align: start;
  }
  #shopify-section-{{ section.id }} .product-hero__eyebrow {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    text-transform:uppercase;
    color: #000;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .product-hero__heading {
    margin: 0;
    font-family: inherit;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .product-hero__description {
    width: 100%;
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--product-hero-description-color);
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .product-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: none;
  }
  #shopify-section-{{ section.id }} .product-hero__actions:has(> .product-hero-button ~ .product-hero-button) {
    display: flex;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .product-hero__actions > .product-hero-button {
    width: fit-content;
    min-height: 0;
  }
  #shopify-section-{{ section.id }} .product-hero__services {
    width: 100%;
    max-width: 1152px;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .product-hero__services .service-labels {
    justify-content: flex-start;
  }
  #shopify-section-{{ section.id }} .product-hero__certifications {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
    margin: 12px 0 0;
    padding: 0;
    max-width: 100%;
    list-style: none;
    color: var(--product-hero-certification-color, #102653);
  }
  #shopify-section-{{ section.id }} .product-hero__certification {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .product-hero__certification-icon {
    display: block;
    flex: none;
    width: auto;
    height: 64px;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .product-hero__certification-copy { min-width: 0; overflow-wrap: anywhere; }
  #shopify-section-{{ section.id }} .product-hero__certification-title { margin: 0; font-size: 20px; font-weight: 600; line-height: 1.3; }
  #shopify-section-{{ section.id }} .product-hero__certification-description { margin: 4px 0 0; font-size: 16px; line-height: 1.4; color: var(--product-hero-description-color); }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .product-hero__certifications { gap: 20px 32px; }
    #shopify-section-{{ section.id }} .product-hero__certification { gap: 12px; }
    #shopify-section-{{ section.id }} .product-hero__certification-icon { height: 48px; }
    #shopify-section-{{ section.id }} .product-hero__actions { flex-direction: row; align-items: center; }
    #shopify-section-{{ section.id }} .product-hero__content { gap: 24px; }
    #shopify-section-{{ section.id }} .product-hero__description br { display: none; }
    {% if template.suffix == 'about-us' %}
      #shopify-section-{{ section.id }} .product-hero__content { gap: 16px; }
      #shopify-section-{{ section.id }} .product-hero__heading { font-size: 28px; }
      #shopify-section-{{ section.id }} .product-hero__description { font-size: 16px; line-height: 1.5; }
      #shopify-section-{{ section.id }} .product-hero__eyebrow { font-size: 14px; }
      #shopify-section-{{ section.id }} .product-hero__actions > .product-hero-button { min-height: 44px; padding: 10px 16px; border-radius: 24px; font-size: 14px; }
    {% endif %}
  }
{% endstyle %}

{% schema %}
{
  "name": "t:product_hero.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 2,
  "blocks": [
    {
      "type": "_product-hero-button"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:product_hero.certifications"
    },
    {
      "type": "checkbox",
      "id": "show_certifications",
      "label": "t:product_hero.show_certifications",
      "default": true
    },
    {
      "type": "color",
      "id": "certification_color",
      "label": "t:product_hero.certification_color",
      "default": "#102653"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "WEB DEVELOPMENT"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Websites Built to Sell.\nNot Just to Look Good"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:product_hero.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description",
      "default": "We design and build sites that turn visitors into enquiries - scoped by page\ncount, timeline and budget, so you know what you are buying before we start."
    },
    {
      "type": "textarea",
      "id": "service_labels",
      "label": "t:product_hero.service_labels",
      "info": "t:product_hero.service_labels_info"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_from",
      "label": "t:product_hero.background_from",
      "default": "#F7E9F5"
    },
    {
      "type": "color",
      "id": "background_to",
      "label": "t:product_hero.background_to",
      "default": "#C7E2F4"
    },
    {
      "type": "color",
      "id": "heading_from",
      "label": "t:settings.gradient_color_from",
      "default": "#5B34C6"
    },
    {
      "type": "color",
      "id": "heading_to",
      "label": "t:settings.gradient_color_to",
      "default": "#2D6BFF"
    },
    {
      "type": "color",
      "id": "heading_mid",
      "label": "t:settings.gradient_color_mid",
      "default": "#8B45F0"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "t:product_hero.description_color",
      "default": "#6B6A6A"
    },
    {
      "type": "color",
      "id": "service_labels_color",
      "label": "t:product_hero.service_labels_color",
      "default": "#3E4C81",
      "visible_if": "{{ section.settings.service_labels != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:product_hero.content_position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:product_hero.position_top"
        },
        {
          "value": "center",
          "label": "t:product_hero.position_center"
        },
        {
          "value": "flex-end",
          "label": "t:product_hero.position_bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 84
    }
  ],
  "presets": [
    {
      "name": "t:product_hero.name",
      "category": "t:categories.banners",
      "settings": {
        "eyebrow": "WEB DEVELOPMENT",
        "heading": "Websites Built to Sell.\nNot Just to Look Good",
        "description": "We design and build sites that turn visitors into enquiries - scoped by page\ncount, timeline and budget, so you know what you are buying before we start."
      },
      "blocks": {
        "button_1": {
          "type": "_product-hero-button",
          "settings": {
            "style_class": "button-custom",
            "custom_button_background": "#FFFFFF",
            "custom_button_text": "#FFFFFF",
            "custom_button_border": "#00000000",
            "button_gradient": true,
            "button_gradient_from": "#7A25C4",
            "button_gradient_to": "#5E6EEB",
            "button_gradient_angle": 90,
            "button_gradient_start_position": 0,
            "button_gradient_end_position": 100,
            "link": "shopify://pages/contact",
            "label": "Book a Free Growth Consultation →"
          }
        },
        "button_2": {
          "type": "_product-hero-button",
          "settings": {
            "style_class": "button-custom",
            "custom_button_background": "#FFFFFF",
            "custom_button_text": "#000000",
            "custom_button_border": "#00000000",
            "button_gradient": false,
            "button_gradient_from": "#7A25C4",
            "button_gradient_to": "#5E6EEB",
            "button_gradient_angle": 90,
            "button_gradient_start_position": 0,
            "button_gradient_end_position": 100,
            "link": "#pricing",
            "label": "See Pricing →"
          }
        },
        "certifications": {
          "type": "_product-hero-certifications",
          "static": true
        }
      },
      "block_order": [
        "button_1",
        "button_2"
      ]
    }
  ]
}
{% endschema %}

