{% comment %}
  Product hero for service pages. Header-free, centered copy with up to two
  editable section-specific buttons and an optional service label list.
  @example Add Product hero, enter service labels one per line, and optionally add buttons.
{% endcomment %}

{% render 'text-block-styles' %}
{% render 'scroll-reveal-styles' %}
<script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>

<div class="section-background product-hero__background" style="--product-hero-bg-from:{{ section.settings.background_from }};--product-hero-bg-to:{{ section.settings.background_to }};"></div>
<scroll-reveal-component class="section section--full-width section--height-{{ section.settings.section_height | default: 'large' }} spacing-style product-hero" data-reveal-scope data-reveal-timeline style="{% render 'spacing-style', settings: section.settings %}--product-hero-description-color:{{ section.settings.description_color }};--product-hero-content-position:{{ section.settings.content_position | default: 'center' }};">
  <div class="product-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="product-hero__eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <{{ section.settings.heading_tag }}
        class="product-hero__heading text-block text-block--gradient"
        data-reveal
        style="--gradient-from:{{ section.settings.heading_from }};--gradient-to:{{ section.settings.heading_to }};--gradient-angle:96.71deg;--gradient-start:11.696%;--gradient-end:88.304%;"
      >{{ section.settings.heading | escape | newline_to_br }}</{{ section.settings.heading_tag }}>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="product-hero__description" data-reveal>{{ section.settings.description | escape | newline_to_br }}</p>
    {% endif %}
    {% capture service_labels %}
      {% render 'service-labels', labels: section.settings.service_labels, color: section.settings.service_labels_color %}
    {% endcapture %}
    {% assign service_labels = service_labels | strip %}
    {% if service_labels != blank %}
      <div class="product-hero__services" data-reveal>{{ service_labels }}</div>
    {% endif %}
    {% capture actions %}{% content_for 'blocks' %}{% endcapture %}
    {% if actions != blank %}
      <div class="product-hero__actions" data-reveal>{{ actions }}</div>
    {% endif %}
  </div>
</scroll-reveal-component>

{% stylesheet %}
  .product-hero {
    /* The selected height is the outer border box; padding belongs to the inner content. */
    display: block;
    height: var(--section-min-height);
    min-height: 0;
    padding-block: 0;
    overflow: auto;
  }
  .product-hero__background {
    background-image: linear-gradient(92.19deg, var(--product-hero-bg-from) 1.07%, var(--product-hero-bg-to) 98.93%);
  }
  .product-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: safe var(--product-hero-content-position, center);
    min-height: 100%;
    padding-block: calc(var(--padding-block-start, 0px) + var(--section-top-offset, 0px)) var(--padding-block-end, 0px);
    gap: 28px;
    width: 100%;
    max-width: 1440px;
    min-width: 0;
    margin-inline: auto;
    padding-inline: max(var(--page-margin), 24px);
    font-family: var(--font-heading--family);
    text-align: center;
  }
  .product-hero__eyebrow {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.22;
    color: #000;
    overflow-wrap: anywhere;
  }
  .product-hero__heading {
    margin: 0;
    font-family: inherit;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .product-hero__description {
    width: 100%;
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--product-hero-description-color);
    overflow-wrap: anywhere;
  }
  .product-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px;
    width: 100%;
    max-width: 1096px;
  }
  .product-hero__actions:has(> .product-hero-button ~ .product-hero-button) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
  }
  .product-hero__actions:has(> .product-hero-button ~ .product-hero-button) > .product-hero-button {
    width: 100%;
    min-height: 62px;
  }
  .product-hero__services {
    width: 100%;
    max-width: 1152px;
    min-width: 0;
  }
  .product-hero.reveal-ready [data-reveal] {
    transition: none;
  }
  .product-hero.reveal-ready [data-reveal][data-state='in'] {
    animation: product-hero-fade-up 700ms ease-in both;
    animation-delay: calc(var(--reveal-index, 0) * 120ms);
  }
  @keyframes product-hero-fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-hero.reveal-ready [data-reveal][data-state='in'] {
      animation: none;
    }
  }
  @media screen and (max-width: 749px) {
    .product-hero__content { gap: 24px; }
    .product-hero__description br { display: none; }
    .product-hero__actions { flex-direction: column; align-items: center; gap: 16px; }
    .product-hero__actions:has(> .product-hero-button ~ .product-hero-button) {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_hero.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 2,
  "blocks": [
    {
      "type": "_product-hero-button"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "WEB DEVELOPMENT"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Websites Built to Sell.\nNot Just to Look Good"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:product_hero.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description",
      "default": "We design and build sites that turn visitors into enquiries - scoped by page\ncount, timeline and budget, so you know what you are buying before we start."
    },
    {
      "type": "textarea",
      "id": "service_labels",
      "label": "t:product_hero.service_labels",
      "info": "t:product_hero.service_labels_info"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_from",
      "label": "t:product_hero.background_from",
      "default": "#F7E9F5"
    },
    {
      "type": "color",
      "id": "background_to",
      "label": "t:product_hero.background_to",
      "default": "#C7E2F4"
    },
    {
      "type": "color",
      "id": "heading_from",
      "label": "t:settings.gradient_color_from",
      "default": "#0C23B8"
    },
    {
      "type": "color",
      "id": "heading_to",
      "label": "t:settings.gradient_color_to",
      "default": "#7C21C2"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "t:product_hero.description_color",
      "default": "#6B6A6A"
    },
    {
      "type": "color",
      "id": "service_labels_color",
      "label": "t:product_hero.service_labels_color",
      "default": "#3E4C81",
      "visible_if": "{{ section.settings.service_labels != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:product_hero.content_position",
      "options": [
        { "value": "flex-start", "label": "t:product_hero.position_top" },
        { "value": "center", "label": "t:product_hero.position_center" },
        { "value": "flex-end", "label": "t:product_hero.position_bottom" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 84
    }
  ],
  "presets": [
    {
      "name": "t:product_hero.name",
      "category": "t:categories.banners",
      "settings": {
        "eyebrow": "WEB DEVELOPMENT",
        "heading": "Websites Built to Sell.\nNot Just to Look Good",
        "description": "We design and build sites that turn visitors into enquiries - scoped by page\ncount, timeline and budget, so you know what you are buying before we start."
      },
      "blocks": [
        {
          "type": "_product-hero-button",
          "settings": {
            "style_class": "button-custom",
            "custom_button_background": "#FFFFFF",
            "custom_button_text": "#FFFFFF",
            "custom_button_border": "#00000000",
            "button_gradient": true,
            "button_gradient_from": "#7A25C4",
            "button_gradient_to": "#5E6EEB",
            "button_gradient_angle": 90,
            "button_gradient_start_position": 0,
            "button_gradient_end_position": 100,
            "link": "shopify://pages/contact",
            "label": "Book a Free Growth Consultation \u2192"
          }
        },
        {
          "type": "_product-hero-button",
          "settings": {
            "style_class": "button-custom",
            "custom_button_background": "#FFFFFF",
            "custom_button_text": "#000000",
            "custom_button_border": "#00000000",
            "button_gradient": false,
            "button_gradient_from": "#7A25C4",
            "button_gradient_to": "#5E6EEB",
            "button_gradient_angle": 90,
            "button_gradient_start_position": 0,
            "button_gradient_end_position": 100,
            "link": "#pricing",
            "label": "See Pricing \u2192"
          }
        }
      ]
    }
  ]
}
{% endschema %}

