{% comment %}
  ME PICKS collection: editable introduction, collection navigation and brand offers.
  Follows the Our Work/Blog layout; sample cards are restricted to the theme editor.
  Native collection links respect each destination's assigned template.
  @example Assign collection.me-picks; navigation reads the store's collections automatically.
{% endcomment %}
{% liquid
  assign s = section.settings
  assign color_id = 'me-picks-' | append: section.id
  assign all_offers = s.all_offers_collection
  assign all_offers_url = all_offers.url | default: routes.all_products_collection_url
  assign heading = s.heading | default: collection.title
  assign preview = false
  if request.design_mode and s.show_preview
    assign preview = true
  endif
  assign all_current = false
  if all_offers != blank
    if all_offers.id == collection.id
      assign all_current = true
    endif
  elsif collection.handle == 'all'
    assign all_current = true
  endif
%}
{% render 'contrast-override', background_color: s.background_color, text_color: s.text_color, section_id: color_id %}
{% render 'product-offer-card-styles' %}
<script src="{{ 'product-offer-card.js' | asset_url }}" type="module" fetchpriority="low"></script>
<div class="me-picks color-custom-{{ color_id }}" style="
  --me-picks-background: {{ s.background_gradient }};
  --me-picks-heading-gradient: {{ s.heading_gradient }};
  --me-picks-accent: {{ s.accent_color }};
  --me-picks-card-background: {{ s.card_background }};
  --me-picks-card-border: {{ s.card_border }};
  --me-picks-card-radius: {{ s.card_radius }}px;
  --me-picks-media-background: {{ s.media_background }};
  --me-picks-code-background: {{ s.code_background }};
  --me-picks-code-color: {{ s.code_color }};
  --me-picks-button-background: {{ s.button_background }};
  --me-picks-button-color: {{ s.button_color }};
  --me-picks-top: {{ s.padding-block-start }}px;
  --me-picks-bottom: {{ s.padding-block-end }}px;
">
  <div class="me-picks__intro">
    <div class="me-picks__inner">
      <h1 class="me-picks__heading">{{ heading | escape }}</h1>
      {% if s.description != blank %}<div class="me-picks__description rte">{{ s.description }}</div>{% endif %}
    </div>
  </div>
  <nav class="me-picks__categories" aria-label="{{ 'me_picks.categories' | t }}">
    <div class="me-picks__category-list me-picks__inner">
      <a class="me-picks__category" href="{{ all_offers_url | escape }}" {% if all_current %}aria-current="page"{% endif %}>{{ s.all_offers_label | escape }}</a>
      {% if s.auto_categories %}
        {% for category in collections limit: 1000 %}
          {% unless category.handle == 'all' or category.id == all_offers.id %}
            <a class="me-picks__category" href="{{ category.url | escape }}" {% if category.id == collection.id %}aria-current="page"{% endif %}>{{ category.title | escape }}</a>
          {% endunless %}
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% liquid
            assign category = block.settings.collection
            assign category_title = block.settings.label | default: category.title
          %}
          {% if category_title != blank %}
            {% if category != blank %}
              <a class="me-picks__category" href="{{ category.url | escape }}" {% if category.id == collection.id %}aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ category_title | escape }}</a>
            {% else %}
              <span class="me-picks__category" {{ block.shopify_attributes }}>{{ category_title | escape }}</span>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </nav>
  <div class="me-picks__results me-picks__inner">
    {% if preview %}
      <p class="me-picks__preview-note">{{ 'me_picks.preview_notice' | t }}</p>
      <ul class="me-picks__grid" role="list">
        {% for index in (1..16) %}
          <li>{% render 'product-offer-card', preview: true, section_id: section.id, index: index %}</li>
        {% endfor %}
      </ul>
    {% else %}
      {% paginate collection.products by s.products_per_page %}
        <ul class="me-picks__grid" role="list">
          {% for product in collection.products %}
            {% liquid
              assign loading = 'lazy'
              if section.index <= 2 and forloop.index <= 4
                assign loading = 'eager'
              endif
            %}
            <li>{% render 'product-offer-card', product: product, current_collection: collection, all_offers_collection: all_offers, section_id: section.id, index: forloop.index, loading: loading %}</li>
          {% endfor %}
        </ul>
        {% if collection.products_count == 0 %}<p class="me-picks__empty">{{ 'me_picks.empty' | t }}</p>{% endif %}
        {% render 'pagination-controls', paginate: paginate %}
      {% endpaginate %}
    {% endif %}
  </div>
</div>
{% stylesheet %}
  .me-picks { background: var(--me-picks-background, var(--color-background)); font-family: var(--font-heading--family); }
  .me-picks__inner { inline-size: calc(100% - 32px); max-inline-size: 1290px; min-inline-size: 0; margin-inline: auto; }
  .me-picks__intro { padding-block: calc(40px + var(--me-picks-top)) 36px; }
  .me-picks__heading { max-inline-size: 917px; margin: 0; color: var(--color-foreground); font-family: inherit; font-size: clamp(36px, 4.02778vw, 58px); font-weight: 600; line-height: 1.22; letter-spacing: normal; overflow-wrap: anywhere; }
  @supports (background-clip: text) {
    .me-picks__heading { background: var(--me-picks-heading-gradient); background-clip: text; -webkit-text-fill-color: transparent; }
  }
  .me-picks__description { max-inline-size: 917px; margin-block-start: 8px; font-size: 18px; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
  .me-picks__description > :first-child { margin-block-start: 0; }
  .me-picks__description > :last-child { margin-block-end: 0; }
  .me-picks__categories { border: 1px solid var(--me-picks-card-border); border-radius: var(--me-picks-card-radius); background: var(--me-picks-card-background); }
  .me-picks__category-list { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 9px; overflow-x: auto; }
  .me-picks__category { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-block-size: 44px; padding-inline: 14px; color: var(--color-foreground-muted); font-size: 14px; font-weight: 800; line-height: 1.5; text-decoration: none; white-space: nowrap; }
  .me-picks__category[aria-current='page'] { border-radius: 6px; background: var(--palette-lightest); color: var(--me-picks-accent); box-shadow: 3px 3px 3px rgb(0 0 0 / 0.06); }
  .me-picks__category:focus-visible { outline: 2px solid var(--me-picks-accent); outline-offset: -2px; }
  .me-picks__results { padding-block: 32px var(--me-picks-bottom); }
  .me-picks__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .me-picks__grid > li { min-inline-size: 0; }
  .me-picks__empty { margin: 0; padding-block: 64px; text-align: center; }
  .me-picks__preview-note { margin-block: 0 16px; font-size: 12px; color: var(--color-foreground-muted); }
  @media screen and (min-width: 750px) {
    .me-picks__inner { inline-size: calc(100% - 64px); }
    .me-picks__intro { padding-block: calc(64px + var(--me-picks-top)) 55px; }
    .me-picks__description { margin-block-start: 0; font-size: 24px; line-height: 38px; }
    .me-picks__category { font-size: 16px; }
    .me-picks__results { padding-block-start: 54px; }
    .me-picks__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px; }
  }
  @media screen and (min-width: 990px) {
    .me-picks__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media screen and (min-width: 1200px) {
    .me-picks__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:me_picks.name",
  "enabled_on": { "templates": ["collection"] },
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "ME PICKS" },
    { "type": "richtext", "id": "description", "label": "t:settings.description", "default": "<p>Offers From Brands In Our Network</p>" },
    { "type": "checkbox", "id": "auto_categories", "label": "t:me_picks.auto_categories", "info": "t:me_picks.auto_categories_info", "default": true },
    { "type": "collection", "id": "all_offers_collection", "label": "t:me_picks.all_collection" },
    { "type": "text", "id": "all_offers_label", "label": "t:me_picks.all_label", "default": "All Offers" },
    { "type": "range", "id": "products_per_page", "label": "t:settings.products_per_page", "min": 8, "max": 32, "step": 4, "default": 16 },
    { "type": "checkbox", "id": "show_preview", "label": "t:me_picks.show_preview", "info": "t:me_picks.preview_info", "default": false },
    { "type": "paragraph", "content": "t:me_picks.product_info" },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "default": "#e6eaf6" },
    { "type": "color_background", "id": "background_gradient", "label": "t:me_picks.background_gradient", "default": "linear-gradient(145deg, #d7e0f9 45%, #e6eaf6 98%)" },
    { "type": "color", "id": "text_color", "label": "t:settings.text_color", "default": "#1f1f1f" },
    { "type": "color_background", "id": "heading_gradient", "label": "t:settings.gradient_text", "default": "linear-gradient(135deg, #0b22b8 12%, #9621c4 88%)" },
    { "type": "color", "id": "accent_color", "label": "t:settings.color", "default": "#0022ff" },
    { "type": "color", "id": "card_background", "label": "t:work_catalog.card_background", "default": "#ffffff4d" },
    { "type": "color", "id": "card_border", "label": "t:work_catalog.card_border", "default": "#ffffff" },
    { "type": "color", "id": "media_background", "label": "t:work_catalog.media_background", "default": "#ebebeb" },
    { "type": "range", "id": "card_radius", "label": "t:settings.border_radius", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "color", "id": "code_background", "label": "t:me_picks.code_background", "default": "#a4b3ea" },
    { "type": "color", "id": "code_color", "label": "t:me_picks.code_color", "default": "#172363" },
    { "type": "color_background", "id": "button_background", "label": "t:blog_filter.button_background", "default": "linear-gradient(101deg, #1f26fb 0%, #bb00ba 100%)" },
    { "type": "color", "id": "button_color", "label": "t:blog_filter.button_text", "default": "#ffffff" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 84 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:me_picks.category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:settings.collection" },
        { "type": "text", "id": "label", "label": "t:me_picks.category_label", "info": "t:me_picks.category_info" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:me_picks.name",
      "blocks": [
        { "type": "category", "settings": { "label": "E-Commerce" } },
        { "type": "category", "settings": { "label": "Beauty" } },
        { "type": "category", "settings": { "label": "Fashion" } },
        { "type": "category", "settings": { "label": "Travel" } },
        { "type": "category", "settings": { "label": "Food & Beverage" } },
        { "type": "category", "settings": { "label": "Tech & Apps" } },
        { "type": "category", "settings": { "label": "Home & Living" } }
      ]
    }
  ]
}
{% endschema %}
