{% comment %}
  Our Work section: blog article case studies and tag-based filtering.
  Article imagery, titles and descriptions stay resource-backed; tags come from the selected blog.
  Previews are editor-only.
  @example Add this section to a blog template when the page is ready to connect.
{% endcomment %}
{% render 'category-sticky-styles' %}
{% liquid
  assign s = section.settings
  assign color_id = 'work-catalog-' | append: section.id
  assign work_blog = s.blog | default: blog
  assign listing_blog = work_blog
  assign listing_path = listing_blog.url
  if blog != blank and listing_blog.handle == blog.handle
    # Keep the route-scoped object so native tag filtering applies to pagination.
    assign listing_blog = blog
    assign listing_path = request.path
  endif
  assign navigation_tags = work_blog.all_tags
  assign preview = false
  if request.design_mode and listing_blog == blank
    assign preview = true
  elsif request.design_mode and listing_blog.articles_count == 0 and current_tags == blank
    assign preview = true
  endif
%}
{% render 'contrast-override', background_color: s.media_background, text_color: s.text_color, section_id: color_id %}
<script src="{{ 'work-catalog.js' | asset_url }}" type="module"></script>
<work-catalog-component
  class="work-catalog color-custom-{{ color_id }}"
  section-id="{{ section.id }}"
  data-animate="{{ s.enable_reveal }}"
  data-loading-text="{{ 'work_catalog.loading' | t | escape }}"
  data-error-text="{{ 'work_catalog.error' | t | escape }}"
  style="
    --work-intro-background: {{ s.intro_background }};
    --work-list-background: {{ s.list_background }};
    --work-heading-gradient: {{ s.heading_gradient }};
    --work-filter-background: {{ s.filter_background }};
    --work-filter-color: {{ s.filter_color }};
    --work-filter-heading-color: {{ s.filter_heading_color }};
    --work-card-background: {{ s.card_background }};
    --work-card-border: {{ s.card_border }};
    --work-card-radius: {{ s.card_radius }}px;
    --work-media-background: {{ s.media_background }};
    --work-media-border: {{ s.media_border }};
    --work-placeholder-color: {{ s.placeholder_color }};
    --work-accent: {{ s.accent_color }};
    --work-muted: {{ s.muted_color }};
  "
>
  <div class="work-catalog__hero spacing-style" data-breadcrumb-surface style="--padding-block-start: {{ s.padding-block-start }}px;">
    <div class="work-catalog__intro">
      {% if s.heading != blank %}<h1 class="work-catalog__heading">{{ s.heading | escape }}</h1>{% endif %}
      {% if s.description != blank %}<div class="work-catalog__description">{{ s.description }}</div>{% endif %}
    </div>
  </div>
  <div class="work-catalog__body spacing-style" style="--padding-block-end: {{ s.padding-block-end }}px;">
    <div class="work-catalog__layout">
      <nav class="work-catalog__filters" on:click="work-catalog-component/navigate" aria-label="{{ 'work_catalog.filter' | t }}">
        {% capture filter_links %}
          {% render 'work-tag-link', tag: '', blog: work_blog %}
          {% for tag in navigation_tags %}
            {% if tag != blank %}{% render 'work-tag-link', tag: tag, blog: work_blog %}{% endif %}
          {% endfor %}
        {% endcapture %}
        <div class="work-catalog__desktop-filters">
          <p class="work-catalog__filter-heading">{{ 'work_catalog.filter' | t }}</p>
          {{ filter_links }}
        </div>
        <details class="work-catalog__mobile-filter" data-category-picker on:keydown="/closeFilter">
          <summary class="work-catalog__filter-toggle">
            <span class="work-catalog__filter-label">{{ 'work_catalog.filter' | t }}</span>
            <span class="work-catalog__selected-tag" data-category-label>{% if current_tags != blank %}{{ current_tags | join: ', ' | escape }}{% else %}{{ 'work_catalog.all' | t }}{% endif %}</span>
            <span class="work-catalog__filter-caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </summary>
          <div class="work-catalog__filter-options">{{ filter_links }}</div>
        </details>
      </nav>
      <div class="work-catalog__content">
        <p ref="status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></p>
        <button class="work-catalog__retry" type="button" on:click="/retry">{{ 'work_catalog.retry' | t }}</button>
        {% if listing_blog == blank %}
          {% render 'work-catalog-results', preview: preview, listing_path: listing_path %}
        {% else %}
          {% paginate listing_blog.articles by s.posts_per_page %}
            {% render 'work-catalog-results', blog: listing_blog, paginate: paginate, preview: preview, listing_path: listing_path %}
          {% endpaginate %}
        {% endif %}
      </div>
    </div>
  </div>
</work-catalog-component>
{% stylesheet %}
  .work-catalog__desktop-filters { display: contents; }
  .work-catalog__mobile-filter { display: none; }
  .work-catalog { display: block; font-family: var(--font-heading--family); }
  .work-catalog__hero { padding-block-start: max(calc(64px + var(--padding-block-start, 0px)), calc(var(--section-top-offset, 0px) + 24px)); background: var(--work-intro-background); }
  .work-catalog__intro { inline-size: min(var(--narrow-page-width), calc(100% - var(--page-margin) * 2)); max-inline-size: var(--narrow-page-width); padding-inline: 0; min-inline-size: 0; margin-inline: auto; padding-block: 0 68px; }
  .work-catalog__heading { max-inline-size: 686px; margin: 0; color: var(--color-foreground); font-family: inherit; font-size: 40px; font-weight: 600; line-height: 1.2; letter-spacing: normal; background: var(--work-heading-gradient); background-clip: text; -webkit-text-fill-color: transparent; overflow-wrap: anywhere; }
  .work-catalog__description { max-inline-size: 983px; margin-inline-start: 5px; font-size: 20px; font-weight: 500; line-height: 1.4; overflow-wrap: anywhere; }
  .work-catalog__description > :first-child { margin-block-start: 0; }
  .work-catalog__description > :last-child { margin-block-end: 0; }
  .work-catalog__body { padding-block-start: 60px; background: var(--work-list-background); }
  .work-catalog__layout { inline-size: min(var(--narrow-page-width), calc(100% - var(--page-margin) * 2)); max-inline-size: var(--narrow-page-width); padding-inline: 0; display: grid; grid-template-columns: 255px minmax(0, 1fr); gap: 34px; margin-inline: auto; align-items: start; }
  .work-catalog__filters { display: grid; gap: 9px; min-inline-size: 0; padding: 27px 22px; border-radius: 11px; background: var(--work-filter-background); }
  .work-catalog__filter-heading { margin: 0; color: var(--work-filter-heading-color); font-size: 20px; font-weight: 700; line-height: 30px; }
  .work-catalog__tag { display: flex; gap: 4px; align-items: start; min-inline-size: 0; min-block-size: 24px; color: var(--work-filter-color); font-size: 16px; font-weight: 600; line-height: 24px; text-decoration: none; overflow-wrap: anywhere; }
  .work-catalog__tag:is(:hover, :focus-visible) { color: var(--work-accent); }
  .work-catalog__tag:focus-visible, .work-catalog__page:focus-visible { outline: 2px solid var(--work-accent); outline-offset: 3px; }
  .work-catalog__indicator { display: grid; place-items: center; flex: none; inline-size: 14px; block-size: 14px; margin-block-start: 5px; border: 1px solid currentColor; border-radius: 50%; }
  .work-catalog__indicator::after { content: ''; inline-size: 6px; block-size: 6px; border-radius: 50%; background: currentColor; visibility: hidden; }
  .work-catalog__tag[aria-current='page'] .work-catalog__indicator { color: var(--work-accent); }
  .work-catalog__tag[aria-current='page'] .work-catalog__indicator::after { visibility: visible; }
  .work-catalog__content, .work-catalog__results { min-inline-size: 0; }
  .work-catalog__results { scroll-margin-block-start: calc(var(--header-group-height, 0px) + 24px); }
  .work-catalog__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .work-catalog__retry { display: none; min-block-size: 44px; margin-block-end: 16px; color: var(--color-foreground); }
  .work-catalog[data-error] .work-catalog__retry { display: inline-block; }
  .work-catalog__pagination { display: flex; align-items: center; justify-content: center; gap: 0; min-block-size: 44px; margin: 35px 0 0; padding: 0; }
  .work-catalog__page { display: grid; place-items: center; min-inline-size: 40px; min-block-size: 44px; color: var(--work-muted); font-size: 16px; font-weight: 600; line-height: 1.41; text-decoration: none; }
  .work-catalog__page[aria-current='page'] { color: var(--work-accent); }
  .work-catalog__page-arrow { display: grid; place-items: center; inline-size: 22px; block-size: 22px; border: 0.5px solid currentColor; border-radius: 50%; font-weight: 400; line-height: 1; }
  [dir='rtl'] .work-catalog__page--arrow { transform: scaleX(-1); }
  @media screen and (max-width: 989px) {
    .work-catalog__layout { grid-template-columns: minmax(0, 1fr); }
    .work-catalog__filters { display: flex; flex-wrap: wrap; gap: 8px 20px; }
    .work-catalog__filter-heading { flex-basis: 100%; }
    .work-catalog__tag { min-block-size: 44px; align-items: center; }
    .work-catalog__indicator { margin-block-start: 0; }
    .work-catalog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 989px) {
    .work-catalog__filters { display: block; position: sticky; inset-block-start: var(--category-sticky-top, 8px); align-self: start; padding: 0; border-radius: 12px; background: var(--color-input-background, var(--color-background)); z-index: 2; }
    .work-catalog__desktop-filters { display: none; }
    .work-catalog__mobile-filter { display: block; }
    .work-catalog__filter-toggle { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 12px 16px; border-radius: 12px; background: var(--color-input-background, var(--color-background)); border: 1px solid color-mix(in srgb, var(--color-input-text) 12%, transparent); font-size: 14px; line-height: 1.5; cursor: pointer; }
    .work-catalog__filter-label { color: var(--work-filter-color); font-size: 12px; font-weight: 500; }
    .work-catalog__selected-tag { flex: 1; min-width: 0; color: var(--color-foreground); font-weight: 600; overflow-wrap: anywhere; }
    .work-catalog__filter-caret { display: flex; flex: 0 0 14px; }
    .work-catalog__filter-caret svg { width: 14px; height: 14px; }
    .work-catalog__mobile-filter[open] .work-catalog__filter-caret { transform: rotate(180deg); }
    .work-catalog__filter-options { position: absolute; inset-inline: 0; inset-block-start: calc(100% + 8px); display: grid; max-height: 50svh; overflow-y: auto; padding: 8px; border: 1px solid color-mix(in srgb, var(--color-input-text) 12%, transparent); border-radius: 12px; background: var(--color-input-background, var(--color-background)); }
    .work-catalog__filter-options .work-catalog__tag { min-block-size: 44px; padding: 10px 12px; gap: 8px; font-size: 14px; font-weight: 500; line-height: 1.5; border-radius: 8px; }
    .work-catalog__filter-options .work-catalog__tag[aria-current='page'] { color: var(--work-accent); background: color-mix(in srgb, var(--work-accent) 8%, var(--color-input-background)); }
    .work-catalog__filter-toggle:focus-visible, .work-catalog__tag:focus-visible { outline: 2px solid var(--work-accent); outline-offset: -3px; }
  }
  @media screen and (max-width: 749px) {
    .work-catalog__hero { padding-block-start: max(calc(24px + min(var(--padding-block-start, 0px), 32px)), calc(var(--section-top-offset, 0px) + 24px)); }
    .work-catalog__intro { padding-block: 0 32px; }
    .work-catalog__heading { font-size: 24px; line-height: 1.25; }
    .work-catalog__description { margin-inline-start: 0; margin-block-start: 12px; font-size: 13px; line-height: 1.6; }
    .work-catalog__body { padding-block: 32px min(var(--padding-block-end, 0px), 32px); }
    .work-catalog__layout { gap: 16px; }
    .work-catalog__grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .work-catalog__pagination { margin-block-start: 24px; flex-wrap: wrap; }
    .work-catalog__page { font-size: 14px; min-inline-size: 44px; }
    .work-catalog__retry { font-size: 14px; padding: 10px 12px; line-height: 1.4; }
    .work-catalog__empty { font-size: 13px; line-height: 1.6; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:work_catalog.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:settings.blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Our Work"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description",
      "default": "<p>See how we help businesses grow through MarTech, technology and marketing.</p>"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "t:settings.gradient_text",
      "default": "linear-gradient(100deg, #5B34C6 0%, #8B45F0 55%, #2D6BFF 100%)"
    },
    {
      "type": "color_background",
      "id": "intro_background",
      "label": "t:work_catalog.intro_background",
      "default": "linear-gradient(168deg, #d9e0f9 0%, #f8f1ed 100%)"
    },
    {
      "type": "color_background",
      "id": "list_background",
      "label": "t:work_catalog.list_background",
      "default": "linear-gradient(180deg, #e6ecff 0%, #dbe1f8 100%)"
    },
    {
      "type": "color_background",
      "id": "filter_background",
      "label": "t:work_catalog.filter_background",
      "default": "linear-gradient(162deg, #dae2ff 1%, #c1cdf9 99%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "t:work_catalog.muted_color",
      "default": "#6b6b6b"
    },
    {
      "type": "color",
      "id": "filter_color",
      "label": "t:work_catalog.filter_color",
      "default": "#555971"
    },
    {
      "type": "color",
      "id": "filter_heading_color",
      "label": "t:work_catalog.filter_heading_color",
      "default": "#7422c2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.color",
      "default": "#0032f5"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:work_catalog.card_background",
      "default": "#ffffff4d"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "t:work_catalog.card_border",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "t:work_catalog.media_background",
      "default": "#ebebeb"
    },
    {
      "type": "color",
      "id": "media_border",
      "label": "t:work_catalog.media_border",
      "default": "#bfbfbf"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "t:work_catalog.placeholder_color",
      "default": "#8d8d8d"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:blog_filter.posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "t:blog_filter.enable_reveal",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:work_catalog.name"
    }
  ]
}
{% endschema %}
