{% comment %}
  Contact: one region containing an enquiry form and merchant-owned contact details/offices.
  @example Add Contact to a page template, configure links, and upload contact icons.
{% endcomment %}
{% liquid
  assign s = section.settings
  assign form_id = 'ContactEnquiry-' | append: section.id
  assign color_id = 'contact-enquiry-' | append: section.id
  assign office_count = 0
  for block in section.blocks
    if block.type == 'office'
      if block.settings.label != blank or block.settings.value != blank
        assign office_count = office_count | plus: 1
      endif
    endif
  endfor
%}
{% render 'custom-section-fonts', font: s.font %}
{% render 'contrast-override', section_id: color_id, background_color: s.card_background, text_color: s.text_color %}
<div class="section-background" style="background: {{ s.background | default: 'transparent' }};"></div>
<div class="section section--full-width spacing-style contact-enquiry"
  style="{% render 'spacing-style', settings: s %} --contact-enquiry-font: {{ s.font.family | escape }}, {{ s.font.fallback_families }}; --contact-enquiry-text: {{ s.text_color }}; --contact-enquiry-heading: {{ s.heading_gradient | default: s.text_color }}; --contact-enquiry-accent: {{ s.accent_color }}; --contact-enquiry-button-background: {{ s.button_background }}; --contact-enquiry-button-text: {{ s.button_text }};">
  <div class="contact-enquiry__inner">
    {% if s.heading != blank or s.description != blank %}
      <div class="contact-enquiry__intro">
        {% if s.heading != blank %}<h2 class="contact-enquiry__heading">{{ s.heading | escape }}</h2>{% endif %}
        {% if s.description != blank %}<p class="contact-enquiry__description">{{ s.description | escape | newline_to_br }}</p>{% endif %}
      </div>
    {% endif %}
    <div class="contact-enquiry__columns">
      <div class="contact-enquiry__panel color-custom-{{ color_id }}" style="{% render 'input-custom-styles', block_settings: s %}">
        {% render 'contact-enquiry-form', section_settings: s, form_id: form_id %}
      </div>
      <div class="contact-enquiry__panel contact-enquiry__information color-custom-{{ color_id }}">
        {% if s.info_heading != blank %}<h3 class="contact-enquiry__info-heading">{{ s.info_heading | escape }}</h3>{% endif %}
        {% if s.info_description != blank %}<p class="contact-enquiry__info-description">{{ s.info_description | escape | newline_to_br }}</p>{% endif %}
        <div class="contact-enquiry__details">
          {% for block in section.blocks %}
            {% if block.type == 'detail' %}
              {% if block.settings.value != blank or request.design_mode %}
                <div class="contact-enquiry__detail" {{ block.shopify_attributes }}>
                  <div class="contact-enquiry__detail-label">
                    {% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 72 | image_tag: widths: '24, 48, 72', sizes: '24px', loading: 'lazy', alt: '', class: 'contact-enquiry__icon' }}{% endif %}
                    {% if block.settings.label != blank %}<p>{{ block.settings.label | escape }}</p>{% endif %}
                  </div>
                  {% if block.settings.value != blank %}<div class="contact-enquiry__detail-value">{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.value | escape | newline_to_br }}</a>{% else %}{{ block.settings.value | escape | newline_to_br }}{% endif %}</div>{% endif %}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if office_count > 0 or request.design_mode %}
            <div class="contact-enquiry__detail contact-enquiry__offices">
              <div class="contact-enquiry__detail-label">
                {% if s.offices_icon != blank %}{{ s.offices_icon | image_url: width: 72 | image_tag: widths: '24, 48, 72', sizes: '24px', loading: 'lazy', alt: '', class: 'contact-enquiry__icon' }}{% endif %}
                {% if s.offices_label != blank %}<p>{{ s.offices_label | escape }}</p>{% endif %}
              </div>
              <div class="contact-enquiry__office-list">
                {% for block in section.blocks %}
                  {% if block.type == 'office' %}
                    {% if block.settings.label != blank or block.settings.value != blank or request.design_mode %}
                      <div class="contact-enquiry__office" {{ block.shopify_attributes }}>
                        {% if block.settings.label != blank %}<h4>{{ block.settings.label | escape }}</h4>{% endif %}
                        {% if block.settings.value != blank %}<address>{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.value | escape | newline_to_br }}</a>{% else %}{{ block.settings.value | escape | newline_to_br }}{% endif %}</address>{% endif %}
                      </div>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
  .contact-enquiry { color: var(--contact-enquiry-text); font-family: var(--contact-enquiry-font, var(--font-heading--family)); }
  .contact-enquiry__inner { width: 100%; max-width: 1440px; min-width: 0; margin-inline: auto; padding-inline: 80px; }
  .contact-enquiry__intro { margin-block-end: 60px; overflow-wrap: anywhere; }
  .contact-enquiry__heading, .contact-enquiry__info-heading { margin: 0; color: inherit; font-family: inherit; font-weight: 600; letter-spacing: normal; line-height: 1.22; background: var(--contact-enquiry-heading); background-clip: text; -webkit-text-fill-color: transparent; }
  .contact-enquiry__heading { font-size: var(--fluid-heading-58, clamp(36px, 4.02778vw, 58px)); }
  .contact-enquiry__description { margin: 0; font-size: var(--fluid-body-24, 24px); font-weight: 500; line-height: var(--fluid-leading-1-583333, 38px); }
  .contact-enquiry__columns { display: grid; grid-template-columns: minmax(0, 615fr) minmax(0, 632fr); align-items: start; gap: 30px; }
  .contact-enquiry__panel { min-width: 0; padding: 42px; border-radius: 40px; overflow-wrap: anywhere; }
  .contact-enquiry__info-heading { font-size: var(--fluid-heading-46, clamp(32px, 3.19444vw, 46px)); }
  .contact-enquiry__info-description { margin: 10px 0 0; font-size: var(--fluid-body-24, 24px); font-weight: 500; line-height: var(--fluid-leading-1-041667, 25px); }
  .contact-enquiry__details { display: grid; gap: 40px; margin-block-start: 40px; }
  .contact-enquiry__detail { display: grid; grid-template-columns: minmax(0, 205fr) minmax(0, 247fr); gap: 40px; align-items: start; }
  .contact-enquiry__detail-label { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 26px; align-items: start; font-size: var(--fluid-body-20, 20px); font-weight: 500; line-height: var(--fluid-leading-1-25, 25px); }
  .contact-enquiry__detail-label p { grid-column: 2; margin: 0; }
  .contact-enquiry__icon { width: 24px; height: 24px; object-fit: contain; }
  .contact-enquiry__detail-value { font-size: var(--fluid-body-16, 16px); font-weight: 400; line-height: var(--fluid-leading-1-5625, 25px); }
  .contact-enquiry__office-list { display: grid; gap: 38px; }
  .contact-enquiry__office h4 { margin: 0 0 20px; color: inherit; font-family: inherit; font-size: var(--fluid-heading-16, 16px); font-weight: 600; line-height: var(--fluid-leading-1-25, 20px); letter-spacing: normal; }
  .contact-enquiry__office address { font-size: var(--fluid-body-14, 14px); font-weight: 400; font-style: normal; line-height: var(--fluid-leading-1-428571, 20px); }
  .contact-enquiry a { color: var(--contact-enquiry-accent); text-decoration: underline; text-underline-offset: 0.15em; }
  .contact-enquiry a:focus { outline: none; }
  .contact-enquiry a:focus-visible { text-decoration-thickness: 3px; }
  @media screen and (max-width: 1199px) {
    .contact-enquiry__inner { padding-inline: 32px; }
    .contact-enquiry__panel { padding: 28px; }
    .contact-enquiry__detail { gap: 20px; }
    .contact-enquiry__detail-label { gap: 12px; font-size: var(--fluid-body-20, 17px); }
    .contact-enquiry__info-description { font-size: var(--fluid-body-24, 20px); line-height: 1.5; }
  }
  @media screen and (max-width: 989px) {
    .contact-enquiry__columns { grid-template-columns: minmax(0, 1fr); }
  }
  @media screen and (max-width: 749px) {
    .contact-enquiry__inner { padding-inline: 20px; }
    .contact-enquiry__intro { margin-block-end: 32px; }
    .contact-enquiry__description { margin-block-start: 10px; font-size: var(--fluid-body-24, 18px); line-height: 1.6; }
    .contact-enquiry__panel { padding: 24px; border-radius: 24px; }
    .contact-enquiry__info-description { font-size: var(--fluid-body-24, 18px); }
    .contact-enquiry__detail { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .contact-enquiry__detail-label { grid-template-columns: 24px minmax(0, 1fr); }
    .contact-enquiry__office-list { gap: 28px; }
  }
  @media (forced-colors: active) {
    .contact-enquiry__heading, .contact-enquiry__info-heading { color: CanvasText; background: none; -webkit-text-fill-color: currentColor; }
    .contact-enquiry__panel { border: 1px solid CanvasText; }
  }
{% endstylesheet %}

