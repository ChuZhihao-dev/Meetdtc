{% comment %}
  Service scope: editable introduction and a responsive list of service modules.
  Empty background shows the page background; card transparency is independent.
  The included layout adds centered copy and optional merchant-uploaded icons.
  @example Add "Service scope" and edit, add or reorder its service cards.
{% endcomment %}
{% liquid
  assign s = section.settings
  assign included_layout = false
  if s.layout == 'included'
    assign included_layout = true
  endif
  assign card_alpha = s.card_opacity | divided_by: 100.0
  assign card_count = 0
  for block in section.blocks limit: 50
    if block.settings.heading != blank or block.settings.description != blank or request.design_mode
      assign card_count = card_count | plus: 1
    endif
  endfor
%}
{% render 'custom-section-fonts', font: s.font %}
{% if s.enable_reveal %}
  {% render 'scroll-reveal-styles' %}
  <script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}
<div class="service-scope__background" style="background: {{ s.background | default: 'transparent' }};" aria-hidden="true"></div>
<scroll-reveal-component
  class="section section--full-width spacing-style service-scope{% if included_layout %} service-scope--included{% endif %}{% if request.design_mode %} service-scope--editor{% endif %}"
  style="{% render 'spacing-style', settings: s %}
    --service-scope-font: {{ s.font.family | escape }}, {{ s.font.fallback_families }};
    --service-scope-text: {{ s.text_color }};
    --service-scope-card-heading: {{ s.card_heading_color | default: s.text_color }};
    --service-scope-gradient: {{ s.heading_gradient | default: s.text_color }};
    --service-scope-card-background: {{ s.card_background | color_modify: 'alpha', card_alpha }};
    --service-scope-card-border: {{ s.card_border }};
    --service-scope-card-radius: {{ s.card_radius }}px;
    --service-scope-column-gap: {{ s.column_gap }}px;
    --service-scope-row-gap: {{ s.row_gap }}px;
    --service-scope-mobile-top: {{ s.padding_mobile_top }}px;
    --service-scope-mobile-bottom: {{ s.padding_mobile_bottom }}px;"
  {% if s.enable_reveal %}data-reveal-scope{% endif %}
  {% if s.enable_reveal and included_layout %}data-reveal-timeline="desktop" data-reveal-margin="0px 0px -15% 0px"{% endif %}
>
  <div class="service-scope__inner">
    {% if s.eyebrow != blank or s.heading != blank or s.description != blank %}
      <div class="service-scope__intro" {% if s.enable_reveal and included_layout == false %}data-reveal{% endif %}>
        {% if s.eyebrow != blank %}<p class="service-scope__eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
        {% if s.heading != blank %}<h2 class="service-scope__heading" {% if s.enable_reveal and included_layout %}data-reveal{% endif %}>{{ s.heading | escape }}</h2>{% endif %}
        {% if s.description != blank %}<div class="service-scope__description" {% if s.enable_reveal and included_layout %}data-reveal{% endif %}>{{ s.description }}</div>{% endif %}
      </div>
    {% endif %}
    {% if card_count > 0 %}
      <ul class="service-scope__grid" role="list">
        {% for block in section.blocks limit: 50 %}
          {% if block.settings.heading != blank or block.settings.description != blank or request.design_mode %}
            <li class="service-scope__card" {% if s.enable_reveal %}data-reveal{% endif %} {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <img class="service-scope__card-icon" src="{{ block.settings.icon | image_url: width: 64 }}" width="32" height="32" alt="" loading="lazy">
              {% endif %}
              {% if block.settings.heading != blank %}<h3 class="service-scope__card-heading">{{ block.settings.heading | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<div class="service-scope__card-description">{{ block.settings.description }}</div>{% endif %}
              {% if block.settings.link != blank and block.settings.link_label != blank %}
                <a class="service-scope__card-link" href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}{% if block.settings.heading != blank %}<span class="visually-hidden"> — {{ block.settings.heading | escape }}</span>{% endif %}</a>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</scroll-reveal-component>
{% stylesheet %}
  .service-scope__background {
    position: absolute;
    inset: 0;
    z-index: var(--layer-section-background, -1);
    pointer-events: none;
  }
  .service-scope {
    color: var(--service-scope-text, #000);
    font-family: var(--service-scope-font, var(--font-heading--family));
  }
  .service-scope__inner {
    width: 100%;
    max-width: 1440px;
    min-width: 0;
    margin-inline: auto;
    padding-inline: min(4.30556vw, 62px);
  }
  .service-scope__intro { display: grid; gap: 16px; min-width: 0; }
  .service-scope__eyebrow {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .service-scope__heading {
    margin: 0;
    font-family: inherit;
    font-size: 40px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: normal;
    color: inherit;
    background: var(--service-scope-gradient, #0b22b8);
    background-clip: text;
    -webkit-text-fill-color: transparent;
    overflow-wrap: anywhere;
  }
  .service-scope__description {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .service-scope__description > :first-child,
  .service-scope__card-description > :first-child { margin-block-start: 0; }
  .service-scope__description > :last-child,
  .service-scope__card-description > :last-child { margin-block-end: 0; }
  .service-scope__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* Stretch card boxes equally; keep their content in normal document flow. */
    grid-auto-rows: 1fr;
    gap: var(--service-scope-row-gap, 29px) var(--service-scope-column-gap, 33px);
    width: calc(100% - min(3.05556vw, 44px));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .service-scope__intro + .service-scope__grid { margin-block-start: 40px; }
  .service-scope__card {
    min-width: 0;
    min-height: 176px;
    padding: 24px;
    border: 1px solid var(--service-scope-card-border, #fff);
    border-radius: var(--service-scope-card-radius, 13px);
    background: var(--service-scope-card-background, #ffffff94);
    overflow-wrap: anywhere;
  }
  .service-scope .service-scope__card,
  .service-scope.reveal-ready .service-scope__card {
    transition-property: opacity, transform, translate, box-shadow;
    transition-duration: var(--text-reveal-duration, 0.6s), var(--text-reveal-duration, 0.6s), calc(var(--animation-speed-slow) * 1.5), calc(var(--animation-speed-slow) * 1.5);
    transition-timing-function: var(--ease-out-cubic);
  }
  .service-scope.reveal-ready .service-scope__card[data-reveal] {
    transition-delay: min(calc(var(--reveal-index, 0) * 90ms), 540ms), min(calc(var(--reveal-index, 0) * 90ms), 540ms), 0s, 0s;
  }
  .service-scope__card:has(:focus-visible) {
    translate: 0 -4px;
    box-shadow: 0 12px 28px -12px color-mix(in srgb, var(--service-scope-text) 22%, transparent);
  }
  @media (hover: hover) and (pointer: fine) {
    .service-scope__card:hover {
      translate: 0 -4px;
      box-shadow: 0 12px 28px -12px color-mix(in srgb, var(--service-scope-text) 22%, transparent);
    }
  }
  .service-scope__card-heading {
    min-block-size: 2lh;
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: normal;
  }
  .service-scope__card-description { font-size: 16px; font-weight: 400; line-height: 1.25; }
  .service-scope__card-heading + .service-scope__card-description { margin-block-start: 20px; }
  .service-scope__card-icon { display: block; inline-size: 32px; block-size: 32px; margin-block-end: 14px; object-fit: contain; }
  .service-scope__card-link { display: inline-flex; align-items: center; min-block-size: 44px; margin-block-start: 10px; color: inherit; font-size: 14px; font-weight: 600; text-underline-offset: 0.2em; }
  .service-scope__description a,
  .service-scope__card-description a { color: inherit; text-decoration: underline; text-underline-offset: 0.15em; }
  .service-scope a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .service-scope.reveal-ready [data-reveal] { transition-delay: min(calc(var(--reveal-index, 0) * 90ms), 540ms); }
  .service-scope.reveal-ready .service-scope__card[data-reveal][data-state='before'] { transform: translateY(24px); }
  .service-scope--editor.reveal-ready [data-reveal] { opacity: 1; transform: none; transition: none; }
  @media screen and (max-width: 989px) {
    .service-scope__inner { padding-inline: 32px; }
    .service-scope__grid { width: 100%; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .service-scope__card { padding: 24px; }
    .service-scope__description br { display: none; }
  }
  @media screen and (max-width: 749px) {
    .service-scope { padding-block: var(--service-scope-mobile-top, 40px) var(--service-scope-mobile-bottom, 40px); }
    .service-scope__inner { padding-inline: 20px; }
    .service-scope__intro { gap: 12px; }
    .service-scope__grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .service-scope__intro + .service-scope__grid { margin-block-start: 32px; }
    .service-scope__card { min-height: 0; }
    .service-scope__card-heading { min-block-size: 0; }
    .service-scope__card-heading + .service-scope__card-description { margin-block-start: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-scope .service-scope__card,
    .service-scope.reveal-ready .service-scope__card { translate: none; transition: none; }
    .service-scope.reveal-ready [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
  @media (forced-colors: active) {
    .service-scope__heading { color: CanvasText; background: none; -webkit-text-fill-color: currentColor; }
    .service-scope__card { border-color: CanvasText; }
  }
  .service-scope--included .service-scope__inner { max-inline-size: 1440px; padding-inline: clamp(24px, 5.55556vw, 80px); }
  .service-scope--included .service-scope__intro { text-align: center; }
  .service-scope--included .service-scope__heading { max-inline-size: none; font-size: 58px; line-height: 1.45; }
  .service-scope--included .service-scope__description { max-inline-size: none; font-size: 24px; font-weight: 400; line-height: 1.45; }
  .service-scope--included .service-scope__grid { inline-size: 100%; grid-auto-rows: auto; gap: var(--service-scope-row-gap) var(--service-scope-column-gap); }
  .service-scope--included .service-scope__intro + .service-scope__grid { margin-block-start: 10px; }
  .service-scope--included .service-scope__card { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; min-block-size: 220px; padding: 24px; border-width: 0; }
  .service-scope--included .service-scope__card-icon { flex-shrink: 0; margin: 0; }
  .service-scope--included .service-scope__card-heading { min-block-size: 0; color: var(--service-scope-card-heading); font-size: 21px; line-height: 1.45; }
  .service-scope--included .service-scope__card-description { font-size: 14px; line-height: 1.45; }
  .service-scope--included .service-scope__card-heading + .service-scope__card-description { margin-block-start: 0; }
  .service-scope--included .service-scope__card-link { margin-block-start: auto; color: var(--service-scope-card-heading); }
  .service-scope--included .service-scope__card,
  .service-scope--included.reveal-ready .service-scope__card { transition-duration: var(--text-reveal-duration, 0.6s), var(--text-reveal-duration, 0.6s), var(--animation-speed), var(--animation-speed); }
  .service-scope--included.reveal-ready .service-scope__card[data-reveal] { transition-delay: min(calc(var(--reveal-index, 0) * 90ms), 540ms), min(calc(var(--reveal-index, 0) * 90ms), 540ms), 0ms, 0ms; }
  @media screen and (max-width: 989px) {
    .service-scope--included .service-scope__inner { padding-inline: 32px; }
    .service-scope--included.reveal-ready .service-scope__card[data-reveal] { transition-delay: 0ms; }
  }
  @media screen and (max-width: 749px) {
    .service-scope--included .service-scope__inner { padding-inline: 24px; }
    .service-scope--included .service-scope__intro { gap: 10px; }
    .service-scope--included .service-scope__intro + .service-scope__grid { margin-block-start: 24px; }
    .service-scope--included .service-scope__card { min-block-size: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-scope--included.reveal-ready [data-reveal],
    .service-scope--included.reveal-ready [data-reveal][data-state='before'] { opacity: 1; transform: none; transition: none; }
    .service-scope--included.reveal-ready .service-scope__card[data-reveal] { transition: none; }
  }
{% endstylesheet %}

