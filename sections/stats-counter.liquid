{% comment %}
  Editable statistics with counting animation. Shared renderer also supports Product hero.
  @example Add Stats counter and configure the statistic blocks.
{% endcomment %}
<div class="section-background" style="background: {{ section.settings.background | default: 'transparent' }};"></div>
<div class="section section--full-width spacing-style stats-counter-section" style="{% render 'spacing-style', settings: section.settings %}">
  {% render 'stats-counter', settings: section.settings, blocks: section.blocks %}
</div>
{% stylesheet %}
  .stats-counter-section > .stats-counter { grid-column: 1 / -1; }
  @media screen and (max-width: 749px) {
    .stats-counter-section { padding-block: min(var(--padding-block-start), 32px) min(var(--padding-block-end), 32px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:stats_counter.name",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "font_picker",
      "id": "font",
      "label": "t:stats_counter.font",
      "default": "montserrat_n4"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "t:stats_counter.background",
      "default": "linear-gradient(126deg, #E3E6F4, #DCE1F5)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:stats_counter.text_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:stats_counter.accent_color",
      "default": "#772CC8"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:stats_counter.enable_animation",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:stats_counter.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:stats_counter.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:stats_counter.stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:stats_counter.value",
          "info": "t:stats_counter.value_info",
          "default": "10"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "t:stats_counter.suffix"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:stats_counter.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:stats_counter.name",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "10",
            "suffix": "+",
            "description": "Years of technical service experience"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "1,000",
            "suffix": "+",
            "description": "Clients served"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "50",
            "suffix": "+",
            "description": "Countries and regions covered"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "3",
            "suffix": "",
            "description": "Industries served\nE-commerce · Apps · Gaming"
          }
        }
      ]
    }
  ]
}
{% endschema %}
