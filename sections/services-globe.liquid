{% comment %}
  Services globe. Editable service overview with a decorative COBE globe.
  @example
  <!-- Add Services globe between Partner brands and the solutions grid. -->
{% endcomment %}

{% liquid
  assign s = section.settings
  assign color_id = 'services-' | append: section.id
  assign service_keys = 'web_commerce,customer_growth,ai_technology,partner_marketing,data_intelligence' | split: ','
%}
{% render 'contrast-override', background_color: s.background_gradient_from, text_color: s.text_color, section_id: color_id, preset: 'content' %}
{% render 'text-block-styles' %}
{% render 'scroll-reveal-styles' %}
<script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'services-globe.js' | asset_url }}" type="module" fetchpriority="low"></script>

<div
  class="services-globe color-custom-{{ color_id }}"
  style="
    --services-bg-from: {{ s.background_gradient_from }};
    --services-bg-to: {{ s.background_gradient_to }};
    --services-font: {{ s.font }};
    --services-heading-size: {{ s.font_size }};
    --services-link-color: {{ s.link_color }};
    --services-globe-filter: url('#services-globe-tint-{{ section.id }}');
    --gradient-from: {{ s.gradient_color_from }};
    --gradient-mid: {{ s.gradient_color_mid | default: '#8B45F0' }};
    --gradient-to: {{ s.gradient_color_to }};
    --gradient-angle: 100deg;
    --gradient-start: 0%;
    --gradient-end: 100%;
  "
>
  {% liquid
    assign globe_color = s.gradient_color_from | default: '#5B34C6'
    assign globe_red = globe_color | color_extract: 'red' | divided_by: 255.0
    assign globe_green = globe_color | color_extract: 'green' | divided_by: 255.0
    assign globe_blue = globe_color | color_extract: 'blue' | divided_by: 255.0
  %}
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position: absolute;">
    <defs>
      <filter id="services-globe-tint-{{ section.id }}" color-interpolation-filters="sRGB">
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="{{ globe_red }} 1" />
          <feFuncG type="table" tableValues="{{ globe_green }} 1" />
          <feFuncB type="table" tableValues="{{ globe_blue }} 1" />
        </feComponentTransfer>
      </filter>
    </defs>
  </svg>
  <div class="section section--page-width">
  <div class="services-globe__layout">
    <scroll-reveal-component data-reveal-scope>
    <div class="services-globe__intro">
      <div class="services-globe__title" data-reveal>
        {% if s.eyebrow != blank %}<p class="services-globe__eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
        {% if s.heading != blank %}
          <h2 class="services-globe__heading text-block{% if s.gradient_text %} text-block--gradient{% endif %}">{{ s.heading | escape | newline_to_br }}</h2>
        {% endif %}
      </div>
      <div class="services-globe__copy" data-reveal>
        {% if s.description != blank %}<div class="services-globe__description">{{ s.description }}</div>{% endif %}
      </div>
      <ul class="services-globe__services" role="list">
        {% for key in service_keys limit: 5 %}
          {% if s[key] != blank %}<li class="services-globe__service services-globe__service--{{ key }}">{{ s[key] | escape }}</li>{% endif %}
        {% endfor %}
      </ul>
      {% if s.link_label != blank and s.link != blank %}
        <div data-reveal>
          <a class="services-globe__link" href="{{ s.link | escape }}">{{ s.link_label | escape }}</a>
        </div>
      {% endif %}
    </div>
    </scroll-reveal-component>
    <div class="services-globe__visual">
      <div class="services-globe__art" aria-hidden="true">
        <services-globe-component class="services-globe__renderer" data-rotate="{{ s.auto_rotate }}">
          <img ref="fallback" class="services-globe__fallback" src="{{ 'services-globe-fallback.webp' | asset_url }}" width="1148" height="1148" alt="" decoding="async" loading="lazy">
          <div ref="host" class="services-globe__canvas-host"><canvas ref="canvas" class="services-globe__canvas" width="1148" height="1148"></canvas></div>
        </services-globe-component>
      </div>

    </div>
  </div>
  </div>
</div>

{% stylesheet %}
  .services-globe {
    overflow: clip;
    background-image: linear-gradient(123.856deg, var(--services-bg-from) 27.224%, var(--services-bg-to) 99.351%);
    font-family: var(--services-font, var(--font-heading--family));
    color: var(--color-foreground);
  }
  .services-globe__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    container-type: inline-size;
    inline-size: 100%;
    min-inline-size: 0;
    padding-block: 64px;
  }
  .services-globe__layout > scroll-reveal-component { min-inline-size: 0; }
  .services-globe__intro { display: grid; gap: 24px; }
  .services-globe__title, .services-globe__copy { min-inline-size: 0; }
  .services-globe__eyebrow { margin: 0 0 12px; font-size: 14px; font-weight: 500; line-height: 1.583; }
  .services-globe__heading {
    margin: 0;
    font-family: inherit;
    font-size: var(--services-heading-size);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-wrap: pretty;
    color: var(--color-foreground);
  }
  .services-globe__copy { max-inline-size: 50ch; }
  .services-globe__description { font-size: 16px; font-weight: 400; line-height: 1.7; overflow-wrap: anywhere; }
  .services-globe__description > :first-child { margin-block-start: 0; }
  .services-globe__description > :last-child { margin-block-end: 0; }
  .services-globe__link { display: inline-block; margin-block-start: 0; font-size: 18px; font-weight: 500; line-height: 1.5; color: var(--services-link-color); text-decoration: none; text-underline-offset: 5px; }
  .services-globe__link:is(:hover, :focus-visible) { text-decoration: underline; }
  .services-globe__link:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .services-globe__visual { position: relative; min-inline-size: 0; block-size: clamp(380px, 42cqw, 580px); }
  .services-globe__art { position: absolute; inset: 0; pointer-events: none; }
  .services-globe__renderer { display: block; position: absolute; inset-block-start: 0; inset-inline-start: -8%; inline-size: 135%; aspect-ratio: 1; }
  .services-globe__fallback { display: block; inline-size: 100%; block-size: auto; filter: var(--services-globe-filter); mix-blend-mode: multiply; }
  /* Both the static fallback and live globe share the same reserved square. */
  .services-globe__canvas-host { position: absolute; inset-block-start: 0; inset-inline: 0; inline-size: 100%; aspect-ratio: 1; mix-blend-mode: multiply; }
  .services-globe__canvas { display: block; inline-size: 100%; block-size: 100%; opacity: 0; filter: var(--services-globe-filter); }
  .services-globe__renderer[data-ready] .services-globe__fallback { visibility: hidden; }
  .services-globe__renderer[data-ready] .services-globe__canvas { opacity: 1; }
  .services-globe__services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 24px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .services-globe__service {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-inline-size: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .services-globe__service::before {
    content: '';
    flex: 0 0 6px;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--services-link-color);
    align-self: center;
  }
  @media screen and (max-width: 749px) {
    .services-globe__layout { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-block: 40px 0; }
    .services-globe__intro { gap: 24px; }
    .services-globe__heading { font-size: 1.75rem; }
    .services-globe__link { min-block-size: 44px; font-size: 16px; }
    .services-globe__services { gap: 12px 16px; }
    .services-globe__visual { block-size: 85cqw; }
    .services-globe__renderer { inset-inline-start: -5%; inline-size: 110%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.services_globe",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "SERVICES"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Build Smarter,\nScale Faster"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description",
      "default": "<p>From strategy and technology to data and execution, we help global brands connect every stage of the customer journey through integrated Martech solutions that drive measurable growth.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Explore Our Work →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-accent--family)",
          "label": "t:options.accent"
        }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "2rem",
          "label": "32px"
        },
        {
          "value": "2.5rem",
          "label": "40px"
        },
        {
          "value": "3rem",
          "label": "48px"
        },
        {
          "value": "3.625rem",
          "label": "58px"
        },
        {
          "value": "4rem",
          "label": "64px"
        }
      ],
      "default": "3.625rem"
    },
    {
      "type": "checkbox",
      "id": "gradient_text",
      "label": "t:settings.gradient_text",
      "default": true
    },
    {
      "type": "color",
      "id": "gradient_color_from",
      "label": "t:settings.gradient_color_from",
      "default": "#5B34C6",
      "visible_if": "{{ section.settings.gradient_text }}"
    },
    {
      "type": "color",
      "id": "gradient_color_to",
      "label": "t:settings.gradient_color_to",
      "default": "#2D6BFF",
      "visible_if": "{{ section.settings.gradient_text }}"
    },
    {
      "type": "color",
      "id": "gradient_color_mid",
      "label": "t:settings.gradient_color_mid",
      "default": "#8B45F0",
      "visible_if": "{{ section.settings.gradient_text }}"
    },
    {
      "type": "color",
      "id": "background_gradient_from",
      "label": "t:settings.gradient_color_from",
      "default": "#94B8FF"
    },
    {
      "type": "color",
      "id": "background_gradient_to",
      "label": "t:settings.gradient_color_to",
      "default": "#E1DFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "t:settings.color",
      "default": "#002AFF"
    },
    {
      "type": "header",
      "content": "t:content.services_globe"
    },
    {
      "type": "text",
      "id": "web_commerce",
      "label": "t:settings.web_commerce",
      "default": "Web Commerce"
    },
    {
      "type": "text",
      "id": "customer_growth",
      "label": "t:settings.customer_growth",
      "default": "Customer Growth"
    },
    {
      "type": "text",
      "id": "ai_technology",
      "label": "t:settings.ai_technology",
      "default": "AI & Technology"
    },
    {
      "type": "text",
      "id": "partner_marketing",
      "label": "t:settings.partner_marketing",
      "default": "Partner Marketing"
    },
    {
      "type": "text",
      "id": "data_intelligence",
      "label": "t:settings.data_intelligence",
      "default": "Data Intelligence"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:settings.services_auto_rotate",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.services_globe",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
