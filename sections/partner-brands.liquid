{% comment %}
  Partner brand showcase. Full-width logo rows surround an overlaid heading
  while moving; static, reduced-motion and keyboard modes keep content in flow.
  @example
  <!-- Add Partner brands, then configure logo rows and their motion directions. -->
{% endcomment %}

{% liquid
  assign section_settings = section.settings
  assign heading_text = section_settings.heading
%}

<div
  class="section-background partner-brands__background"
  style="
    --brand-bg-from: {{ section_settings.background_gradient_from }};
    --brand-bg-to: {{ section_settings.background_gradient_to }};
    --brand-bg-angle: {{ section_settings.background_gradient_angle }}deg;
  "
></div>

<partner-brands-component
  class="section section--full-width partner-brands spacing-style"
  style="{% render 'spacing-style', settings: section_settings %}
    --brand-logo-gap: {{ section_settings.logo_gap }}px;
    --brand-logo-row-gap: {{ section_settings.row_gap }}px;
    --brand-bg-from: {{ section_settings.background_gradient_from }};
    --brand-bg-to: {{ section_settings.background_gradient_to }};
    --brand-bg-angle: {{ section_settings.background_gradient_angle }}deg;
  "
  {{ section.shopify_attributes }}
>
  <div class="partner-brands__stage">
    {% if heading_text != blank %}
      {% render 'text-block-styles' %}
      <div class="partner-brands__heading-panel">
        <div
          class="partner-brands__heading text-block text-block--full-width custom-typography custom-font-size{% if section_settings.two_tone_heading %} partner-brands__heading--two-tone{% elsif section_settings.gradient_text %} text-block--gradient{% endif %}"
          role="heading"
          aria-level="2"
          style="
            {% render 'typography-style', settings: section_settings, type: 'body', preset: 'custom' %}
            --text-align: {{ section_settings.alignment }};
            --brand-heading-color: {{ section_settings.heading_color | default: '#111111' }};
            --brand-heading-accent: {{ section_settings.heading_accent_color | default: '#5B34C6' }};
          "
        >
          {{ heading_text }}
        </div>
      </div>
    {% endif %}

    {%- capture logos -%}
      {% content_for 'blocks' %}
    {%- endcapture -%}
    {% if logos != blank %}
      <div class="partner-brands__logos">{{ logos }}</div>
    {% endif %}
  </div>
</partner-brands-component>

{% stylesheet %}
  .partner-brands__background {
    background-image: linear-gradient(
      var(--brand-bg-angle, 105deg),
      var(--brand-bg-from, #aac5ff) 2.81%,
      var(--brand-bg-to, #cbd5fd) 97.19%
    );
  }

  .partner-brands__stage {
    display: grid;
    align-items: center;
    gap: 32px;
    min-inline-size: 0;
    position: relative;
    isolation: isolate;
  }

  .partner-brands__heading-panel {
    position: relative;
    z-index: 2;
    inline-size: min(44rem, var(--full-page-grid-central-column-width));
    min-inline-size: 0;
    margin-inline: auto;
    pointer-events: none;
  }

  .partner-brands__heading {
    color: var(--color-foreground);
    text-align: var(--text-align, center);
    overflow-wrap: anywhere;
  }

  .partner-brands__heading--two-tone {
    color: var(--brand-heading-color, var(--color-foreground));
  }

  .partner-brands__heading--two-tone strong {
    color: var(--brand-heading-accent, var(--color-foreground));
    font-weight: inherit;
  }

  .partner-brands__heading a {
    pointer-events: auto;
  }

  .partner-brands__logos {
    display: flex;
    flex-direction: column;
    gap: var(--brand-logo-row-gap, 40px);
    min-inline-size: 0;
    inline-size: 100%;
    padding-inline: var(--page-margin);
  }

  .partner-brands .brand-row__items {
    min-block-size: 64px;
  }

  .partner-brands .brand-logo__image,
  .partner-brands .brand-logo__placeholder {
    max-inline-size: min(180px, calc(100vw - var(--page-margin) * 2));
    max-block-size: 64px;
    object-fit: contain;
  }

  /* Only moving rows are masked; keyboard and no-script lists stay fully visible. */
  .partner-brands__stage:has(.brand-row--scrolling) .partner-brands__logos {
    padding-inline: 0;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .partner-brands__stage:has(.brand-row--scrolling):has(.partner-brands__heading-panel) {
    min-block-size: 300px;
    gap: 0;
  }

  .partner-brands__stage:has(.brand-row--scrolling) > .partner-brands__heading-panel,
  .partner-brands__stage:has(.brand-row--scrolling) > .partner-brands__logos {
    grid-area: 1 / 1;
  }

  /* Size the soft backdrop to the text, keeping the adjacent logo rows clear. */
  .partner-brands__stage:has(.brand-row--scrolling) > .partner-brands__heading-panel::before {
    content: '';
    position: absolute;
    inset-block: -12px;
    left: 50%;
    inline-size: calc(100% + 128px);
    max-inline-size: 100vw;
    z-index: -1;
    transform: translateX(-50%);
    background-image: linear-gradient(
      var(--brand-bg-angle, 105deg),
      var(--brand-bg-from, #aac5ff) 2.81%,
      var(--brand-bg-to, #cbd5fd) 97.19%
    );
    mask-image:
      linear-gradient(to right, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(to bottom, transparent, #000 12px, #000 calc(100% - 12px), transparent);
    mask-composite: intersect;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .partner-brands {
      padding-block: min(var(--padding-block-start), 40px) min(var(--padding-block-end), 40px);
    }

    .partner-brands__stage {
      gap: 24px;
    }

    .partner-brands .partner-brands__heading.custom-font-size {
      font-size: 24px;
      line-height: 1.25;
    }

    .partner-brands .partner-brands__heading > * {
      font-size: inherit;
      line-height: inherit;
    }

    .partner-brands__logos {
      gap: min(var(--brand-logo-row-gap), 32px);
    }

    .partner-brands .brand-row {
      --brand-logo-gap: 32px;
    }

    .partner-brands .brand-row__items {
      min-block-size: 48px;
    }

    .partner-brands .brand-logo__image,
    .partner-brands .brand-logo__placeholder {
      max-inline-size: min(132px, calc(100vw - var(--page-margin) * 2));
      max-block-size: 48px;
    }

    .partner-brands__stage:has(.brand-row--scrolling):has(.partner-brands__heading-panel) {
      min-block-size: 260px;
    }

    .partner-brands__stage:has(.brand-row--scrolling) > .partner-brands__heading-panel::before {
      mask-image:
        linear-gradient(to right, transparent, #000 6%, #000 94%, transparent),
        linear-gradient(to bottom, transparent, #000 12px, #000 calc(100% - 12px), transparent);
    }
  }
{% endstylesheet %}

