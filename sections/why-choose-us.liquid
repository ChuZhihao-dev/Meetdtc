{% comment %}
  Why choose us.
  Renders an optional eyebrow, a gradient headline, and supporting copy above a
  horizontally scrollable row of merchant-managed value-proposition cards.
  @example
  <!-- Add the "Why choose us" section, then edit each feature block -->
{% endcomment %}

{% liquid
  assign section_settings = section.settings
  assign heading_text = section_settings.heading
%}
{% render 'scroll-reveal-styles' %}
<script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>



<div
  class="section-background why-choose-us__background"
  style="
    --wcu-bg-angle: {{ section_settings.background_gradient_angle }}deg;
    --wcu-bg-from: {{ section_settings.background_gradient_from }};
    --wcu-bg-to: {{ section_settings.background_gradient_to }};
  "
></div>

<div
  class="section section--page-width why-choose-us spacing-style"
  style="{% render 'spacing-style', settings: section_settings %}
    --page-content-width: {{ section_settings.content_width | default: 1276 }}px;
    --page-width: calc(var(--page-content-width) + var(--page-margin) * 2);
    --wcu-heading-gap: {{ section_settings.heading_gap }}px;
    --wcu-column-gap: {{ section_settings.column_gap }}px;
    --wcu-row-gap: {{ section_settings.row_gap }}px;
  "
  {{ section.shopify_attributes }}
>
  {% if section_settings.eyebrow != blank or heading_text != blank or section_settings.description != blank %}
    <scroll-reveal-component data-reveal-scope>
    <div class="why-choose-us__intro">
      {% if section_settings.eyebrow != blank %}
        <p class="why-choose-us__eyebrow" data-reveal>{{ section_settings.eyebrow | escape }}</p>
      {% endif %}

      {% if heading_text != blank %}
        {% render 'text-block-styles' %}
        <div
          id="why-choose-us-heading-{{ section.id }}"
          class="
            why-choose-us__heading
            text-block
            text-block--full-width
            custom-typography
            custom-font-size
            {% if section_settings.gradient_text %}text-block--gradient{% endif %}
          "
          data-reveal
          style="
            {% render 'typography-style', settings: section_settings, type: 'heading', preset: 'custom' %}
            {% if section_settings.line_height == blank %}--line-height: normal;{% endif %}
            --text-align: {{ section_settings.alignment }};
          "
        >
          {{ heading_text }}
        </div>
      {% endif %}

      {% if section_settings.description != blank %}
        <div class="why-choose-us__description" data-reveal>{{ section_settings.description }}</div>
      {% endif %}
    </div>
    </scroll-reveal-component>
  {% endif %}

  {%- capture value_props -%}
    {% content_for 'blocks' %}
  {%- endcapture -%}

  {% if value_props != blank %}
    <script src="{{ 'why-choose-us.js' | asset_url }}" type="module" fetchpriority="low"></script>
    <why-choose-us-component
      class="why-choose-us__grid"
      tabindex="0"
      {% if heading_text != blank %}
        role="region"
        aria-labelledby="why-choose-us-heading-{{ section.id }}"
      {% endif %}
    >{{ value_props }}</why-choose-us-component>
  {% endif %}
</div>

{% stylesheet %}
  .why-choose-us__background {
    background-image: linear-gradient(var(--wcu-bg-angle, 180deg), var(--wcu-bg-from, #fff), var(--wcu-bg-to, #fff));
  }

  .why-choose-us__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-inline-size: 0;
    inline-size: 100%;
  }

  .why-choose-us__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-weight: 500;
    line-height: normal;
    color: var(--color-foreground);
  }

  .why-choose-us__heading.text-block {
    max-inline-size: min(1100px, 100%);
  }

  .why-choose-us__heading {
    color: var(--color-foreground);
  }

  .why-choose-us__description {
    max-inline-size: 952px;
    margin-block-start: 16px;
    font-family: var(--font-body--family);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-foreground);
    overflow-wrap: anywhere;
  }

  .why-choose-us__description > :first-child { margin-block-start: 0; }
  .why-choose-us__description > :last-child { margin-block-end: 0; }

  .why-choose-us > .why-choose-us__grid {
    grid-column: 1 / -1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((min(var(--page-content-width), 100%) - var(--wcu-column-gap, 20px) * 2) / 3);
    align-items: stretch;
    gap: var(--wcu-column-gap, 20px);
    min-inline-size: 0;
    margin-block-start: calc(var(--wcu-heading-gap, 88px) - 16px);
    padding-block: 16px;
    padding-inline: var(--util-page-margin-offset);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline proximity;
    scroll-padding-inline: var(--util-page-margin-offset);
    scrollbar-width: none;
    margin-block-end: -16px;
  }

  .why-choose-us__grid::-webkit-scrollbar {
    display: none;
  }

  .why-choose-us__grid:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: calc(-1 * var(--focus-outline-width));
  }

  @media (any-pointer: fine) {
    .why-choose-us__grid:defined {
      cursor: grab;
    }
  }

  .why-choose-us > .why-choose-us__grid.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
    user-select: none;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .why-choose-us > .why-choose-us__grid {
      grid-auto-columns: calc((100% - var(--wcu-column-gap, 20px)) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .why-choose-us { padding-block: min(var(--padding-block-start), 32px) min(var(--padding-block-end), 32px); }
    .why-choose-us__eyebrow { font-size: 12px; }
    .why-choose-us__heading.custom-font-size,
    .why-choose-us__heading.custom-font-size > * { font-size: 24px; line-height: 1.25; }
    .why-choose-us__description { margin-block-start: 2px; font-size: 13px; line-height: 1.6; }
    .why-choose-us__description br { display: none; }
    .why-choose-us > .why-choose-us__grid {
      grid-auto-columns: min(85%, 360px);
      gap: 16px;
      margin-block-start: 8px;
    }
  }
{% endstylesheet %}

