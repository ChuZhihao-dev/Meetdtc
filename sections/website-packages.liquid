{% comment %}
  Product-backed website package comparison with optional quotation cards.
  Prices and availability come from selected products; purchase submits directly to checkout.
  @example Add Website packages, bind Basic and Advanced products, and set Custom to quotation mode.
{% endcomment %}
{% liquid
  assign has_purchase = false
  for block in section.blocks
    if block.settings.mode == 'product' and block.settings.enable_purchase and block.settings.product != blank
      assign has_purchase = true
      break
    endif
  endfor
%}
{% if has_purchase %}<script src="{{ 'website-package-checkout.js' | asset_url }}" type="module" fetchpriority="low"></script>{% endif %}
{% if section.settings.enable_reveal %}
  {% render 'scroll-reveal-styles' %}
  <script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}
<scroll-reveal-component
  class="website-packages spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}
    --packages-background: {{ section.settings.background | default: 'transparent' }};
    --packages-heading-gradient: {{ section.settings.heading_gradient }};
    --packages-heading-color: {{ section.settings.heading_color }};
    --packages-text: {{ section.settings.text_color }};
    --packages-muted: {{ section.settings.muted_color }};
    --packages-accent: {{ section.settings.accent_color }};
    --packages-audience: {{ section.settings.audience_color }};
    --packages-card-background: {{ section.settings.card_background }};
    --packages-border: {{ section.settings.card_border }};
    --packages-label-background: {{ section.settings.label_background }};
    --packages-button-background: {{ section.settings.button_background }};
    --packages-button-color: {{ section.settings.button_color }};"
  {% if section.settings.enable_reveal %}data-reveal-scope data-reveal-timeline="desktop" data-reveal-margin="0px 0px -15% 0px"{% endif %}
>
  <div class="website-packages__inner">
    {% if section.settings.eyebrow != blank %}<p class="website-packages__eyebrow" {% if section.settings.enable_reveal %}data-reveal{% endif %}>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="website-packages__heading" {% if section.settings.enable_reveal %}data-reveal{% endif %}>{{ section.settings.heading | escape | newline_to_br }}</h2>{% endif %}
    <div class="website-packages__grid">
      {% content_for 'blocks' %}
    </div>
    {% if section.settings.note != blank %}<div class="website-packages__note">{{ section.settings.note }}</div>{% endif %}
  </div>
</scroll-reveal-component>
{% stylesheet %}
  .website-packages { display: block; background: var(--packages-background); color: var(--packages-text); font-family: var(--font-heading--family); }
  .website-packages__inner { inline-size: 100%; max-inline-size: 1440px; min-inline-size: 0; margin-inline: auto; padding-inline: clamp(24px, 5.55556vw, 80px); }
  .website-packages__eyebrow { margin: 0 0 10px; color: var(--color-foreground); font-size: 24px; font-weight: 500; line-height: 1.45; overflow-wrap: anywhere; }
  .website-packages__heading { max-inline-size: 784px; margin: 0 0 10px; color: var(--packages-heading-color); background: var(--packages-heading-gradient); background-clip: text; -webkit-text-fill-color: transparent; font-family: inherit; font-size: 58px; font-weight: 600; line-height: 1.45; letter-spacing: normal; overflow-wrap: anywhere; }
  .website-packages__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .website-packages__note { margin-block-start: 20px; font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
  .website-packages__note > :first-child { margin-block-start: 0; }
  .website-packages__note > :last-child { margin-block-end: 0; }
  .website-packages.reveal-ready [data-reveal] { transition-delay: calc(var(--reveal-index, 0) * 100ms); }
  .website-packages.reveal-ready [data-state='before'] { transform: translateY(24px); }
  @media screen and (max-width: 989px) {
    .website-packages__inner { padding-inline: 32px; }
    .website-packages__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .website-packages.reveal-ready [data-reveal] { transition-delay: 0ms; }
  }
  @media screen and (max-width: 749px) {
    .website-packages__inner { padding-inline: 24px; }
    .website-packages__heading { margin-block-end: 24px; }
    .website-packages__grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .website-packages.reveal-ready [data-reveal],
    .website-packages.reveal-ready [data-state='before'] { opacity: 1; transform: none; transition: none; }
  }
  @media (forced-colors: active) {
    .website-packages__heading { background: none; -webkit-text-fill-color: currentColor; }
  }
{% endstylesheet %}

{% schema %}
