{% comment %}
  Callout banner.
  Renders a full-bleed gradient background with a rounded gradient panel holding
  a gradient heading on the left and a description plus call-to-action link on
  the right.
  @example
  <!-- Add the "Callout banner" section and edit the copy and link -->
{% endcomment %}

{% liquid
  assign section_settings = section.settings
  assign heading_text = section_settings.heading
%}
{% render 'scroll-reveal-styles' %}
<script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>



<div
  class="section-background cta-banner__background"
  style="
    --cta-bg-from: {{ section_settings.background_gradient_from }};
    --cta-bg-to: {{ section_settings.background_gradient_to }};
    --cta-bg-angle: {{ section_settings.background_gradient_angle }}deg;
  "
></div>

<div
  class="section section--page-width cta-banner{% if section_settings.layout_style == 'glow' %} cta-banner--glow{% endif %} spacing-style"
  style="{% render 'spacing-style', settings: section_settings %}
    --cta-mobile-radius: {{ section_settings.panel_radius_mobile }}px;"
  {{ section.shopify_attributes }}
>
  {% if section_settings.layout_style == 'glow' %}
    <div class="cta-banner__glow" aria-hidden="true">
      <img src="{{ 'callout-glow-back.svg' | asset_url }}" width="1097" height="414" alt="" loading="lazy">
      <img src="{{ 'callout-glow-front.svg' | asset_url }}" width="1097" height="414" alt="" loading="lazy">
    </div>
  {% endif %}
  <scroll-reveal-component data-reveal-scope>
  <div
    class="cta-banner__panel spacing-style"
    style="
      --padding-block-start: {{ section_settings.panel_padding_block_start }}px;
      --padding-block-end: {{ section_settings.panel_padding_block_end }}px;
      --padding-inline-start: {{ section_settings.panel_padding_inline_start }}px;
      --padding-inline-end: {{ section_settings.panel_padding_inline_end }}px;

    --cta-panel-radius: {{ section_settings.panel_radius }}px;
    --cta-panel-from: {{ section_settings.panel_gradient_from }};
    --cta-panel-to: {{ section_settings.panel_gradient_to }};
    --cta-panel-angle: {{ section_settings.panel_gradient_angle }}deg;
    --cta-button-background: {{ section_settings.button_background }};
    --cta-button-color: {{ section_settings.button_text_color }};
    --cta-button-radius: {{ section_settings.button_radius }}px;
    --cta-description-color: {{ section_settings.description_color }};
  "
  >
    {% if heading_text != blank %}
      {% render 'text-block-styles' %}
      <div
        class="
          cta-banner__heading
          text-block
          text-block--full-width
          custom-typography
          custom-font-size
          {% if section_settings.gradient_text %}text-block--gradient{% endif %}
        "
        data-reveal
        style="
          {% render 'typography-style', settings: section_settings, type: 'heading', preset: 'custom' %}
        "
      >
        {% if section_settings.layout_style == 'glow' %}{{ heading_text | escape | replace: ' to Focus', ' to<br>Focus' }}{% else %}{{ heading_text | escape }}{% endif %}
      </div>
    {% endif %}

    <div class="cta-banner__aside" data-reveal>
      {% if section_settings.description != blank %}
        <div class="cta-banner__description">{{ section_settings.description }}</div>
      {% endif %}

      {% if section_settings.link != blank and section_settings.link_label != blank %}
        {% if section_settings.layout_style == 'glow' %}<div class="cta-banner__button-shell"><div class="cta-banner__button-ring">{% endif %}
        <a class="cta-banner__button" href="{{ section_settings.link | escape }}">
          {{- section_settings.link_label | escape -}}
          <span class="cta-banner__button-icon" aria-hidden="true">
            {% if section_settings.layout_style == 'glow' %}
              <img src="{{ 'callout-arrow.svg' | asset_url }}" width="56" height="56" alt="" loading="lazy">
            {% else %}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {% endif %}
          </span>
        </a>
        {% if section_settings.layout_style == 'glow' %}</div></div>{% endif %}
      {% endif %}
    </div>
  </div>
  </scroll-reveal-component>
</div>

{% stylesheet %}
  /* Callout keeps its light two-color gradient against the colored panel. */
  .cta-banner__heading.text-block.text-block--gradient {
    background-image: linear-gradient(
      96deg,
      #FFFFFF 12%,
      #Ffffff 88%
    );
  }
  .cta-banner__background {
    background-image: linear-gradient(
      var(--cta-bg-angle, 104deg),
      var(--cta-bg-from, #aac5ff) 2.81%,
      var(--cta-bg-to, #cbd5fd) 97.19%
    );
  }

  .cta-banner__panel {
    aspect-ratio: 1272 / 291;
    display: flex;
    gap: 40px;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background-image: linear-gradient(
      var(--cta-panel-angle, 92deg),
      var(--cta-panel-from, #6379ef) 0.42%,
      var(--cta-panel-to, #b62cf6) 99.58%
    );
    border-radius: var(--cta-panel-radius, 23px);
  }

  .cta-banner__heading {
    flex: 1 1 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .cta-banner__aside {
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    gap: 28px;
    align-items: flex-start;
    max-width: 582px;
  }

  .cta-banner__description {
    font-family: Montserrat;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--cta-description-color, #ffffff);
    text-wrap: pretty;
  }

  .cta-banner__description > :first-child {
    margin-block-start: 0;
  }

  .cta-banner__description > :last-child {
    margin-block-end: 0;
  }

  .cta-banner__button {
    display: inline-flex;
    max-inline-size: 100%;
    gap: 10px;
    align-items: center;
    justify-content: center;
    padding: 16px 26px;
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    color: var(--cta-button-color, #6d28d9);
    background-color: var(--cta-button-background, #ffffff);
    border-radius: var(--cta-button-radius, 30px);
    transition:
      transform 0.25s var(--ease-out-cubic),
      box-shadow 0.25s var(--ease-out-cubic);
  }

  .cta-banner__button-icon {
    display: inline-flex;
    transition: transform 0.25s var(--ease-out-cubic);
  }

  .cta-banner__button-icon svg {
    display: block;
    width: 1em;
    height: 1em;
  }

  @media (hover: hover) {
    .cta-banner__button:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px 0 rgb(0 0 0 / 0.18);
    }

    .cta-banner__button:hover .cta-banner__button-icon {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-banner__button,
    .cta-banner__button-icon {
      transition: none;
    }

    .cta-banner__button:hover {
      transform: none;
      box-shadow: none;
    }

    .cta-banner__button:hover .cta-banner__button-icon {
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .cta-banner__panel {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .cta-banner__aside {
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    .cta-banner__panel { aspect-ratio: auto; padding-block: min(var(--padding-block-start), 32px) min(var(--padding-block-end), 32px); padding-inline: min(var(--padding-inline-start), 24px) min(var(--padding-inline-end), 24px); }
    .cta-banner__heading.custom-font-size { font-size: 1.75rem; line-height: 1.25; }
    .cta-banner__heading > * { font-size: inherit; line-height: inherit; }
    .cta-banner__aside { min-width: 0; width: 100%; gap: 20px; }
    .cta-banner__description { font-size: 16px; line-height: 1.5; }
    .cta-banner__button { max-width: 100%; min-height: 48px; font-size: 16px; line-height: 1.4; padding: 12px 20px; }
  }
  @media screen and (max-width: 749px) {
    .cta-banner__panel { border-radius: var(--cta-mobile-radius, 16px); }
    .cta-banner__button { width: 100%; min-height: 48px; padding: 12px 20px; border-radius: 24px; }
  }
  /* Shared mobile scale for every instance of this component. */
  @media screen and (max-width: 749px) {
    .cta-banner { padding-block: min(var(--padding-block-start), 32px) min(var(--padding-block-end), 32px); }

    .cta-banner .cta-banner__panel { gap: 16px; padding-block: min(var(--padding-block-start), 24px) min(var(--padding-block-end), 24px); padding-inline: min(var(--padding-inline-start), 20px) min(var(--padding-inline-end), 20px); }
    .cta-banner .cta-banner__heading.custom-font-size { font-size: 24px; line-height: 1.25; }
    .cta-banner .cta-banner__aside { gap: 16px; }
    .cta-banner .cta-banner__description { font-size: 13px; line-height: 1.6; }
    .cta-banner .cta-banner__button { font-size: 14px; }
  }
  @media screen and (max-width: 749px) {
    .cta-banner .cta-banner__button {
      min-block-size: 44px;
      min-height: 44px;
      padding: 10px 12px;
      font-size: 14px;
      line-height: 1.4;
    }
  }

  .cta-banner--glow {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .cta-banner--glow .cta-banner__panel {
    position: relative;
    aspect-ratio: auto;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 0;
    background: transparent;
    border-radius: 0;
    text-align: center;
  }

  .cta-banner--glow .cta-banner__heading.text-block {
    flex: none;
    inline-size: min(844px, 100%);
    max-inline-size: 100%;
    text-align: center;
  }

  .cta-banner--glow .cta-banner__heading.text-block--gradient {
    background-image: var(--heading-gradient);
  }

  .cta-banner--glow .cta-banner__heading > * {
    text-align: center;
  }

  .cta-banner--glow .cta-banner__aside {
    align-items: center;
    inline-size: 100%;
    max-inline-size: 628px;
    gap: 80px;
  }

  .cta-banner__button-shell {
    inline-size: 412px;
    max-inline-size: 100%;
    padding: 8px;
    border-radius: 50px;
    background: rgb(255 255 255 / 0.1);
  }

  .cta-banner__button-ring {
    padding: 10px;
    border-radius: inherit;
    background: rgb(255 255 255 / 0.4);
  }

  .cta-banner--glow .cta-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    inline-size: 100%;
    max-inline-size: 100%;
    min-block-size: 70px;
    padding: 6px 6px 6px 26px;
    border: 1px solid rgb(124 40 243 / 0.2);
    border-radius: 50px;
    outline: none;
    font-weight: 500;
    box-shadow: 0 0 8px rgb(0 0 0 / 0.1);
  }

  .cta-banner--glow .cta-banner__button:focus-visible {
    outline: var(--focus-outline-width) solid var(--cta-button-color);
    outline-offset: 4px;
  }

  .cta-banner--glow .cta-banner__button-icon {
    flex: none;
  }

  .cta-banner__button-icon img {
    display: block;
    inline-size: 56px;
    block-size: 56px;
  }

  .cta-banner--glow .cta-banner__glow {
    position: absolute;
    z-index: -1;
    inset-inline-start: calc(50% + 5.5px);
    inset-block-end: 0;
    inline-size: 1097px;
    block-size: 414px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .cta-banner--glow .cta-banner__glow:dir(rtl) {
    transform: translateX(50%);
  }

  .cta-banner--glow .cta-banner__glow img {
    position: absolute;
    inset: 0;
    inline-size: 1097px;
    block-size: 414px;
    max-inline-size: none;
  }

  .cta-banner--glow .cta-banner__glow img:first-child {
    transform: translateY(-6px);
  }

  @media (hover: hover) {
    .cta-banner--glow .cta-banner__button:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 12px rgb(0 0 0 / 0.15);
    }
  }

  @media screen and (max-width: 749px) {
    .cta-banner.cta-banner--glow {
      padding-block: min(var(--padding-block-start, 80px), 48px) min(var(--padding-block-end, 80px), 48px);
    }
    .cta-banner.cta-banner--glow .cta-banner__panel {
      padding: 0;
      gap: 16px;
    }
    .cta-banner.cta-banner--glow .cta-banner__heading.custom-font-size {
      font-size: 24px;
      line-height: 1.25;
    }
    .cta-banner.cta-banner--glow .cta-banner__aside {
      gap: 28px;
      inline-size: 100%;
      max-inline-size: 100%;
    }
    .cta-banner.cta-banner--glow .cta-banner__description {
      font-size: 14px;
      line-height: 1.5;
      text-align: center;
      max-inline-size: 340px;
      margin: 0 auto;
    }
    /* 粉色发光遮罩移动端自适应尺寸与居中贴底定位 */
    .cta-banner.cta-banner--glow .cta-banner__glow {
      inset-inline-start: 50%;
      inset-block-end: 0;
      inline-size: clamp(340px, 92vw, 440px);
      block-size: auto;
      aspect-ratio: 1097 / 414;
      transform: translateX(-50%);
    }
    .cta-banner.cta-banner--glow .cta-banner__glow:dir(rtl) {
      transform: translateX(50%);
    }
    .cta-banner.cta-banner--glow .cta-banner__glow img {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      max-inline-size: 100%;
      object-fit: fill;
    }
    .cta-banner.cta-banner--glow .cta-banner__glow img:first-child {
      transform: translateY(-2px);
    }
    /* 按钮外层壳体与圆环移动端尺寸缩放 */
    .cta-banner.cta-banner--glow .cta-banner__button-shell {
      inline-size: 100%;
      max-inline-size: 340px;
      padding: 5px;
    }
    .cta-banner.cta-banner--glow .cta-banner__button-ring {
      padding: 6px;
    }
    /* 按钮主体移动端紧凑排版 */
    .cta-banner.cta-banner--glow .cta-banner__button {
      min-block-size: 48px;
      min-height: 48px;
      padding: 4px 4px 4px 18px;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.3;
      gap: 12px;
      border-radius: 50px;
    }
    /* 按钮右侧圆形箭头图标移动端等比缩放 */
    .cta-banner.cta-banner--glow .cta-banner__button-icon img {
      inline-size: 40px;
      block-size: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-banner--glow .cta-banner__button:hover {
      transform: none;
    }
  }

  @media screen and (min-width: 750px) {
    /* Reserve title space before the description reaches its desktop width. */
    .cta-banner:not(.cta-banner--glow) .cta-banner__aside {
      flex-basis: 55%;
      min-inline-size: 0;
    }

    .cta-banner.cta-banner--glow {
      min-block-size: 578px;
      padding-block: 88px 72px;
    }
    .cta-banner--glow .cta-banner__panel { gap: 26px; }
    .cta-banner--glow .cta-banner__heading.text-block {
      min-block-size: 142px;
      line-height: normal;
    }
    .cta-banner--glow .cta-banner__aside {
      gap: 84px;
    }
    .cta-banner--glow .cta-banner__description {
      min-block-size: 60px;
      line-height: 1.5;
    }
  }
  .cta-banner--glow .cta-banner__heading > * { line-height: inherit; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cta_banner",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "t:settings.layout_style",
      "options": [
        { "value": "standard", "label": "t:options.standard" },
        { "value": "glow", "label": "t:options.center" }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Not Sure Where to Focus Your Growth Efforts?"
