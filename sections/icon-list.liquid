{% comment %}
  Icon list: centered, editable icon/title/description items with shared row tracks.
  Timeline stages run together across items: icon, heading, then description.
  @example Add Icon list; upload each logo and adjust its width in Icon item.
{% endcomment %}
{% assign s = section.settings %}
{% render 'custom-section-fonts', font: s.font %}
{% if s.enable_reveal %}
  {% render 'scroll-reveal-styles' %}
  <script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endif %}
<div class="section-background" style="background: {{ s.background | default: 'transparent' }};"></div>
<scroll-reveal-component class="section section--full-width spacing-style icon-list"
  style="{% render 'spacing-style', settings: s %} --icon-list-font: {{ s.font.family | escape }}, {{ s.font.fallback_families }}; --icon-list-text: {{ s.text_color }};"
  {% if s.enable_reveal %}data-reveal-scope data-reveal-timeline data-reveal-in-editor{% endif %}>
  <ul class="icon-list__items" role="list">
    {% for block in section.blocks %}
      {% liquid
        assign item = block.settings
        assign has_content = false
        if item.icon != blank or item.heading != blank or item.description != blank or request.design_mode
          assign has_content = true
        endif
      %}
      {% if has_content %}
        <li class="icon-list__item" style="--icon-list-icon-width: {{ item.icon_width }}px;" {{ block.shopify_attributes }}>
          <div class="icon-list__icon-slot" {% if s.enable_reveal %}data-reveal{% endif %}>
            {% if item.icon != blank %}
              {% assign icon_sizes = item.icon_width | append: 'px' %}
              {{ item.icon | image_url: width: 540 | image_tag: widths: '60, 120, 180, 360, 540', sizes: icon_sizes, loading: 'lazy', alt: '', class: 'icon-list__image' }}
            {% endif %}
          </div>
          <div class="icon-list__heading-slot" {% if s.enable_reveal %}data-reveal{% endif %}>
            {% if item.heading != blank %}<h2 class="icon-list__heading">{{ item.heading | escape }}</h2>{% endif %}
          </div>
          <div class="icon-list__description-slot" {% if s.enable_reveal %}data-reveal{% endif %}>
            {% if item.description != blank %}<p class="icon-list__description">{{ item.description | escape | newline_to_br }}</p>{% endif %}
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</scroll-reveal-component>
{% stylesheet %}
  .icon-list { color: var(--icon-list-text); font-family: var(--icon-list-font, var(--font-heading--family)); }
  .icon-list__items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px clamp(40px, 18.88889vw, 272px); width: 100%; max-width: 1238px; min-width: 0; margin: 0 auto; padding: 0 80px; list-style: none; }
  .icon-list__item { display: grid; grid-row: span 3; grid-template-rows: subgrid; row-gap: 0; min-width: 0; text-align: center; overflow-wrap: anywhere; }
  .icon-list__icon-slot { display: grid; justify-items: center; align-items: center; min-height: 58px; }
  .icon-list__image { display: block; width: var(--icon-list-icon-width); max-width: 100%; height: auto; object-fit: contain; }
  .icon-list__heading-slot { padding-block-start: 10px; }
  .icon-list__heading { margin: 0; color: inherit; font-family: inherit; font-size: 40px; font-weight: 600; line-height: 1.225; letter-spacing: normal; }
  .icon-list__description-slot { padding-block-start: 10px; }
  .icon-list__description { margin: 0; font-size: 16px; font-weight: 500; line-height: 24px; }
  /* Stage delays are independent of the shared observer's document-order index. */
  .icon-list.reveal-ready [data-reveal] { transition: none; }
  .icon-list.reveal-ready [data-reveal][data-state='before'] { opacity: 0; transform: translateY(16px); }
  /* Keyframes also run when an already-visible section initializes before first paint. */
  .icon-list.reveal-ready [data-reveal][data-state='in'] { animation: icon-list-enter 500ms var(--ease-out-cubic) both; }
  .icon-list.reveal-ready .icon-list__heading-slot[data-state='in'] { animation-delay: 120ms; }
  .icon-list.reveal-ready .icon-list__description-slot[data-state='in'] { animation-delay: 240ms; }
  @keyframes icon-list-enter {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media screen and (max-width: 989px) {
    .icon-list__items { padding-inline: 32px; column-gap: 40px; }
  }
  @media screen and (max-width: 749px) {
    .icon-list__items { grid-template-columns: minmax(0, 1fr); padding-inline: 20px; }
    .icon-list__description { max-width: 403px; margin-inline: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .icon-list.reveal-ready [data-reveal] { opacity: 1; transform: none; transition: none; }
    .icon-list.reveal-ready [data-reveal][data-state] { opacity: 1; transform: none; animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:icon_list.name",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "font_picker",
      "id": "font",
      "label": "t:icon_list.font",
      "default": "montserrat_n4"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "t:icon_list.background",
      "default": "#DCE1F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:icon_list.text_color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "t:icon_list.enable_reveal",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:icon_list.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:icon_list.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:icon_list.item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:icon_list.icon"
        },
        {
          "type": "range",
          "id": "icon_width",
          "label": "t:icon_list.icon_width",
          "min": 24,
          "max": 180,
          "step": 2,
          "unit": "px",
          "default": 60
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:icon_list.heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:icon_list.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:icon_list.name",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon_width": 58,
            "heading": "Our Mission",
            "description": "To turn AI and MarTech into practical capabilities that support our clients’ growth."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_width": 64,
            "heading": "Our Vision",
            "description": "To be a trusted digital technology partner for businesses growing globally."
          }
        }
      ]
    }
  ]
}
{% endschema %}
