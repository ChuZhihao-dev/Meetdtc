{% comment %}
  Brand footer: brand, two navigation columns, contact/offices, platform strip and copyright.
  Navigation comes exclusively from selected Shopify menus. Contact details are merchant-owned.
  @example Add Brand footer after Growth diagnosis; choose Services/Company menus and upload logos.
{% endcomment %}
{% liquid
  assign s = section.settings
  assign logo = s.logo | default: settings.logo_inverse | default: settings.logo
  assign color_id = 'brand-footer-' | append: section.id
  assign platform_color_id = color_id | append: '-platforms'
  assign logo_sizes = s.logo_width | append: 'px'
  assign whatsapp_url = s.whatsapp_link
  if whatsapp_url == blank and s.whatsapp != blank
    assign whatsapp_digits = ''
    assign whatsapp_characters = s.whatsapp | split: ''
    for character in whatsapp_characters
      if '0123456789' contains character
        assign whatsapp_digits = whatsapp_digits | append: character
      endif
    endfor
    if whatsapp_digits.size >= 7
      assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
    endif
  endif
%}
{% render 'contrast-override', section_id: color_id, text_color: s.text_color %}
{% render 'scroll-reveal-styles' %}
<script src="{{ 'scroll-reveal.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% if s.platform_surface %}
  {% render 'contrast-override', section_id: platform_color_id, background_color: s.platform_background, text_color: s.platform_text %}
{% endif %}
{% style %}
  #site-footer { --footer-surface-background: {{ s.shared_background }}; }
{% endstyle %}
<div class="section-background brand-footer__background" style="background: {{ s.background }};"></div>
<div class="section section--full-width spacing-style brand-footer color-custom-{{ color_id }}" data-shared-background="{{ s.share_background }}"
  style="{% render 'spacing-style', settings: s %} --brand-footer-logo-width: {{ s.logo_width }}px;">
  <scroll-reveal-component class="brand-footer__inner" data-reveal-scope>
    <div class="brand-footer__main">
      <div class="brand-footer__brand" data-reveal>
        <a class="brand-footer__logo{% if logo != blank %} brand-footer__logo--image{% endif %}{% if s.logo_surface %} brand-footer__logo--surface{% endif %}" href="{{ routes.root_url }}">
          {% if logo != blank %}
            {{ logo | image_url: width: 960 | image_tag: widths: '224, 448, 640, 960', sizes: logo_sizes, loading: 'lazy', alt: shop.name }}
          {% else %}{{ shop.name | escape }}{% endif %}
        </a>
        {% if s.description != blank %}<p class="brand-footer__description">{{ s.description | escape | newline_to_br }}</p>{% endif %}
      </div>
      {% assign columns = 'services,company' | split: ',' %}
      {% for column in columns %}
        {% liquid
          assign menu_key = column | append: '_menu'
          assign menu = s[menu_key]
          assign heading = menu.title
        %}
        {% capture links %}
          {% if menu != blank and menu.links.size > 0 %}
            {% for link in menu.links %}
              <li><a href="{{ link.url | escape }}">{{ link.title | escape }}</a>
                {% if link.links.size > 0 %}<ul class="brand-footer__subnav">{% for child in link.links %}<li><a href="{{ child.url | escape }}">{{ child.title | escape }}</a>{% if child.links.size > 0 %}<ul class="brand-footer__subnav">{% for grandchild in child.links %}<li><a href="{{ grandchild.url | escape }}">{{ grandchild.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>{% endif %}
              </li>
            {% endfor %}
          {% endif %}
        {% endcapture %}
        {% if links != blank %}
          <nav class="brand-footer__navigation brand-footer__navigation--{{ column }}" aria-label="{{ heading | escape }}" data-reveal>
            {% if heading != blank %}<h2 class="brand-footer__heading">{{ heading | escape }}</h2>{% endif %}
            <ul class="brand-footer__links" role="list">{{ links }}</ul>
          </nav>
        {% endif %}
      {% endfor %}
      <div class="brand-footer__contact" data-reveal>
        {% if s.contact_heading != blank %}<h2 class="brand-footer__heading">{{ s.contact_heading | escape }}</h2>{% endif %}
        {% if s.email != blank %}<a class="brand-footer__email" href="mailto:{{ s.email | strip | escape }}">{{ s.email | escape }}</a>{% endif %}
        {% if s.whatsapp != blank %}<p class="brand-footer__contact-line">{% if whatsapp_url != blank %}<a href="{{ whatsapp_url | escape }}">{{ s.whatsapp | escape }}</a>{% else %}{{ s.whatsapp | escape }}{% endif %}</p>{% endif %}
        {% if s.hours != blank %}<p class="brand-footer__contact-line">{{ s.hours | escape | newline_to_br }}</p>{% endif %}
        <div class="brand-footer__offices">
          {% for block in section.blocks %}
            {% if block.type == 'office' %}
              {% if block.settings.city != blank or block.settings.address != blank or request.design_mode %}
                <div class="brand-footer__office" {{ block.shopify_attributes }}>
                  {% if block.settings.city != blank %}<h3>{{ block.settings.city | escape }}</h3>{% endif %}
                  {% if block.settings.address != blank %}<address>{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.address | escape | newline_to_br }}</a>{% else %}{{ block.settings.address | escape | newline_to_br }}{% endif %}</address>{% endif %}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    {% capture platforms %}
      {% for block in section.blocks %}
        {% if block.type == 'platform' %}
          {% if block.settings.image != blank or block.settings.label != blank or request.design_mode %}
            {% liquid
              assign platform_image = block.settings.image
              assign platform_scale = block.settings.image_scale | default: 25
              assign platform_width = platform_image.width | times: platform_scale | divided_by: 100.0
              assign platform_sizes = platform_width | ceil | append: 'px'
              assign platform_source_width = platform_image.width | at_most: 5760
            %}
            <li class="brand-footer__platform"{% if platform_image != blank %} style="--brand-footer-platform-width: {{ platform_width }}px;"{% endif %} {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{% endif %}
              {% if platform_image != blank %}
                {% assign platform_alt = block.settings.label | default: platform_image.alt %}
                {{ platform_image | image_url: width: platform_source_width | image_tag: width: platform_image.width, height: platform_image.height, sizes: platform_sizes, loading: 'lazy', alt: platform_alt }}
              {% else %}<span>{{ block.settings.label | escape }}</span>{% endif %}
              {% if block.settings.link != blank %}</a>{% endif %}
            </li>
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endcapture %}
    {% if platforms != blank %}
      <div class="brand-footer__platforms" data-reveal>
        {% if s.platforms_heading != blank %}<h2 class="brand-footer__heading">{{ s.platforms_heading | escape }}</h2>{% endif %}
        <ul class="brand-footer__platform-strip{% if s.platform_surface %} brand-footer__platform-strip--surface color-custom-{{ platform_color_id }}{% endif %}" role="list">{{ platforms }}</ul>
      </div>
    {% endif %}
    <div class="brand-footer__bottom" data-reveal>
      <p>&copy; {{ 'now' | date: '%Y' }} {{ s.copyright_name | default: shop.name | escape }}</p>
      {% if s.bottom_note != blank %}<p>{{ s.bottom_note | escape }}</p>{% endif %}
    </div>
  </scroll-reveal-component>
</div>
{% stylesheet %}
  .brand-footer { font-family: var(--font-heading--family); }
  .brand-footer__inner { width: calc(100% - 48px); max-width: 1322px; min-width: 0; margin-inline: auto; padding-inline: 10px; }
  .brand-footer__main { display: grid; grid-template-columns: minmax(0, 357fr) minmax(0, 268fr) minmax(0, 129fr) minmax(0, 248fr); gap: clamp(28px, 5.4vw, 72px); align-items: start; max-width: 1276px; margin-inline: auto; }
  .brand-footer__main > * { min-width: 0; overflow-wrap: anywhere; }
  .brand-footer__navigation--services { grid-column: 2; }
  .brand-footer__navigation--company { grid-column: 3; }
  .brand-footer__contact { grid-column: 4; }
  .brand-footer__logo { display: inline-block; max-width: 100%; font-size: 22px; font-weight: 600; line-height: 1.3; }
  .brand-footer__logo--image { width: var(--brand-footer-logo-width); }
  .brand-footer__logo--surface { padding: 14px 16px; border-radius: 12px; background: #fff; }
  .brand-footer__logo img { display: block; width: 100%; height: auto; }
  .brand-footer__description { max-width: 357px; margin: 20px 0 0; color: inherit; font-family: var(--font-body--family); font-size: 16px; font-weight: 400; line-height: 1.3; }
  .brand-footer__heading { margin: 0 0 20px; color: inherit; font-family: inherit; font-size: 21px; font-weight: 600; line-height: 1.2; letter-spacing: 1px; text-transform: uppercase; overflow-wrap: anywhere; }
  .brand-footer__links, .brand-footer__subnav { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; font-size: 14px; font-weight: 600; line-height: 1.7; letter-spacing: -0.15px; }
  .brand-footer__subnav { margin-block-start: 8px; padding-inline-start: 12px; }
  .brand-footer a { color: inherit; text-decoration: none; text-underline-offset: 0.22em; }
  .brand-footer a:hover { text-decoration: underline; }
  .brand-footer a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 3px; }
  .brand-footer__email { display: inline-block; font-size: 14px; font-weight: 600; line-height: 1.6; }
  .brand-footer__contact-line { margin: 8px 0 0; font-size: 12px; font-weight: 500; line-height: 1.8667; }
  .brand-footer__offices { display: grid; gap: 12px; margin-block-start: 12px; }
  .brand-footer__office h3 { margin: 0 0 4px; color: inherit; font-family: inherit; font-size: 14px; font-weight: 600; line-height: 1.6; letter-spacing: normal; }
  .brand-footer__office address { font-size: 12px; font-weight: 500; font-style: normal; line-height: 1.8667; }
  .brand-footer__platforms { margin-block-start: 80px; }
  .brand-footer__platforms .brand-footer__heading { margin-block-end: 8px; text-transform: none; }
  .brand-footer__platform-strip { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 28px; min-block-size: 117px; margin: 0; padding: 14px 0; list-style: none; }
  .brand-footer__platform-strip--surface { padding-inline: 24px; border-radius: 13px; }
  .brand-footer__platform { display: flex; flex: 0 1 var(--brand-footer-platform-width, 100px); align-items: center; justify-content: center; min-width: 0; max-width: 100%; font-size: 14px; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
  .brand-footer__platform a { display: flex; align-items: center; justify-content: center; max-width: 100%; }
  .brand-footer__platform img { display: block; width: var(--brand-footer-platform-width, auto); height: auto; max-width: 100%; object-fit: contain; }
  .brand-footer__bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 32px; margin-block-start: 80px; padding-block-start: 20px; border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-50)); font-size: 16px; font-weight: 400; line-height: 1.575; }
  .brand-footer__bottom p { min-width: 0; max-width: 100%; margin: 0; overflow-wrap: anywhere; }
  @media screen and (max-width: 1099px) {
    .brand-footer__main { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
    .brand-footer__navigation, .brand-footer__contact { grid-column: auto; }
    .brand-footer__platforms, .brand-footer__bottom { margin-block-start: 56px; }
  }
  @media screen and (max-width: 749px) {
    .brand-footer__inner { width: 100%; padding-inline: 20px; }
    .brand-footer__main { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; }
    .brand-footer__brand, .brand-footer__contact { grid-column: 1 / -1; }
    .brand-footer__description { max-width: 440px; }
    .brand-footer__heading { margin-block-end: 16px; }
    .brand-footer__platforms { margin-block-start: 40px; }
    .brand-footer__platform-strip { justify-content: center; gap: 24px; padding-block: 16px; }
    .brand-footer__platform { max-width: calc(50% - 12px); }
    .brand-footer__bottom { flex-direction: column; margin-block-start: 40px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:brand_footer.name",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "max_blocks": 32,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:brand_footer.logo",
      "info": "t:footer_surface.logo_info"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:brand_footer.description",
      "default": "Integrated MarTech for global growth — website and e-commerce, customer acquisition, lifecycle marketing and data intelligence."
    },
    {
      "type": "link_list",
      "id": "services_menu",
      "label": "t:brand_footer.services_menu",
      "info": "t:footer_surface.menu_info"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "t:brand_footer.company_menu",
      "info": "t:footer_surface.menu_info"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "t:brand_footer.contact_heading",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:brand_footer.email",
      "default": "enquiry@meetdtc.com"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "t:brand_footer.whatsapp",
      "info": "t:footer_surface.whatsapp_info"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "t:brand_footer.hours"
    },
    {
      "type": "text",
      "id": "platforms_heading",
      "label": "t:brand_footer.platforms_heading",
      "default": "Platforms & ecosystem"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "t:brand_footer.copyright_name",
      "default": "Meet Experience"
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "t:brand_footer.bottom_note"
    },
    {
      "type": "color_background",
      "id": "shared_background",
      "label": "t:footer_surface.shared_background",
      "info": "t:footer_surface.background_info",
      "default": "linear-gradient(119.64deg, #0048FF 6.48%, rgba(242, 0, 255, 0.25) 100.95%)",
      "visible_if": "{{ section.settings.share_background }}"
    },
    {
      "type": "checkbox",
      "id": "show_advanced",
      "label": "t:footer_surface.advanced",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "logo_surface",
      "label": "t:footer_surface.logo_surface",
      "default": false,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "checkbox",
      "id": "platform_surface",
      "label": "t:footer_surface.platform_surface",
      "default": false,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:brand_footer.logo_width",
      "min": 120,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 224,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "t:brand_footer.whatsapp_link",
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "checkbox",
      "id": "share_background",
      "label": "t:footer_surface.share_background",
      "default": true,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "t:brand_footer.background",
      "default": "linear-gradient(115deg, #263BA4 0%, #5622B6 55%, #7527C7 100%)",
      "visible_if": "{{ section.settings.show_advanced and section.settings.share_background == false }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:brand_footer.text_color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "color",
      "id": "platform_background",
      "label": "t:brand_footer.platform_background",
      "default": "#F8F7FF",
      "visible_if": "{{ section.settings.show_advanced and section.settings.platform_surface }}"
    },
    {
      "type": "color",
      "id": "platform_text",
      "label": "t:brand_footer.platform_text",
      "default": "#21164F",
      "visible_if": "{{ section.settings.show_advanced and section.settings.platform_surface }}"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:brand_footer.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.show_advanced }}"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:brand_footer.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.show_advanced }}"
    }
  ],
  "blocks": [
    {
      "type": "office",
      "name": "t:brand_footer.office",
      "settings": [
        {
          "type": "text",
          "id": "city",
          "label": "t:brand_footer.city"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "t:brand_footer.address"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:brand_footer.link"
        }
      ]
    },
    {
      "type": "platform",
      "name": "t:brand_footer.platform",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:brand_footer.image"
        },
        {
          "type": "range",
          "id": "image_scale",
          "label": "t:options.scale",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 25
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:brand_footer.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:brand_footer.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:brand_footer.name",
      "category": "t:categories.footer",
      "blocks": [
        {
          "type": "office",
          "settings": {
            "city": "Singapore",
            "address": "112 Robinson Road, #06-03, Singapore 068902"
          }
        },
        {
          "type": "office",
          "settings": {
            "city": "Shanghai",
            "address": "Floors 3–8, No. 35 Loushanguan Road, Changning District, Shanghai, China"
          }
        },
        {
          "type": "office",
          "settings": {
            "city": "Shenzhen",
            "address": "25th Floor, Hanking Center, Futian District, Shenzhen, China"
          }
        },
        {
          "type": "platform",
          "settings": {
            "label": "Shopify"
          }
        },
        {
          "type": "platform",
          "settings": {
            "label": "Klaviyo"
          }
        },
        {
          "type": "platform",
          "settings": {
            "label": "Omnisend"
          }
        },
        {
          "type": "platform",
          "settings": {
            "label": "Trustpilot"
          }
        },
        {
          "type": "platform",
          "settings": {
            "label": "impact.com"
          }
        },
        {
          "type": "platform",
          "settings": {
            "label": "Awin"
          }
        },
        {
          "type": "platform",
          "settings": {
            "label": "Rakuten Advertising"
          }
        }
      ]
    }
  ]
}
{% endschema %}
