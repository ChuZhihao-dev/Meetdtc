{% doc %}
  A brand offer backed by its product title, image and assigned collection.
  Image/title never navigate to the product page.
  Optional custom.brand_description, offer_summary, offer_terms, offer_code and offer_url supply the offer.
  @param {product} [product] - Product supplying the brand and offer.
  @param {collection} [current_collection] - Collection currently being browsed.
  @param {collection} [all_offers_collection] - Optional total collection, omitted from category labels.
  @param {string} section_id - Owning section's ID for unique code fields.
  @param {number} index - Card position within its owning section.
  @param {string} [loading] - Responsive image loading strategy, defaults to lazy.
  @param {boolean} [preview] - Non-interactive sample, used only in the theme editor.
  @example {% render 'product-offer-card', product: product, current_collection: collection, section_id: section.id, index: forloop.index %}
{% enddoc %}
{% render 'product-offer-card-styles' %}
{% liquid
  assign brand = product.title | default: product.vendor
  assign category = ''
  if current_collection != blank and current_collection.handle != 'all' and current_collection.handle != 'frontpage' and current_collection.id != all_offers_collection.id
    assign category = current_collection.title
  else
    for product_collection in product.collections limit: 50
      unless product_collection.handle == 'all' or product_collection.handle == 'frontpage' or product_collection.id == all_offers_collection.id
        assign category = product_collection.title
        break
      endunless
    endfor
  endif
  assign category = category | default: product.type
  assign summary = product.metafields.custom.offer_summary.value
  assign brand_description = product.metafields.custom.brand_description.value
  assign terms = product.metafields.custom.offer_terms.value
  assign code = product.metafields.custom.offer_code.value | strip
  assign offer_url = product.metafields.custom.offer_url.value | strip
  assign https_prefix = offer_url | slice: 0, 8 | downcase
  assign http_prefix = offer_url | slice: 0, 7 | downcase
  assign valid_url = false
  if https_prefix == 'https://' or http_prefix == 'http://'
    assign valid_url = true
  endif
  assign image = product.featured_image
  assign image_alt = image.alt | default: brand
  assign loading = loading | default: 'lazy'
  assign code_id = 'OfferCode-' | append: section_id | append: '-' | append: index
  if preview
    assign brand = 'me_picks.sample_brand' | t
    assign category = 'me_picks.sample_category' | t
    assign summary = 'me_picks.sample_summary' | t
    assign brand_description = 'me_picks.sample_description' | t
    assign terms = 'me_picks.sample_terms' | t
    assign code = 'WELCOME10'
    assign preview_variant = index | modulo: 2
    if preview_variant == 0
      assign brand = 'me_picks.sample_link_brand' | t
      assign category = 'me_picks.sample_link_category' | t
      assign summary = 'me_picks.sample_link_summary' | t
      assign brand_description = 'me_picks.sample_link_description' | t
      assign terms = 'me_picks.sample_link_terms' | t
      assign code = ''
    endif
  endif
%}
<article class="offer-card">
  <div class="offer-card__media">
    {% if preview %}
      <img class="offer-card__sample-image{% if preview_variant == 0 %} offer-card__sample-image--link{% endif %}" src="{{ 'me-picks-sample-brands.png' | asset_url }}" alt="" width="1122" height="1402" loading="lazy" decoding="async">
    {% elsif image != blank %}
      {{ image | image_url: width: 1000 | image_tag: width: image.width, height: image.height, widths: '266, 400, 532, 750, 1000', sizes: '(min-width: 1200px) calc((min(100vw - 80px, 1280px) - 72px) / 4 - 32px), (min-width: 990px) calc((100vw - 128px) / 3 - 32px), (min-width: 750px) calc((100vw - 104px) / 2 - 32px), calc(100vw - 64px)', loading: loading, decoding: 'async', alt: image_alt, class: 'offer-card__image' }}
    {% else %}
      <span class="offer-card__placeholder" aria-hidden="true">{{ 'me_picks.image_preview' | t }}</span>
    {% endif %}
  </div>
  <div class="offer-card__body">
    {% if category != blank %}<p class="offer-card__category">{{ category | escape }}</p>{% endif %}
    <h2 class="offer-card__brand">{{ brand | escape }}</h2>
    {% if brand_description != blank %}<p class="offer-card__description">{{ brand_description | escape }}</p>{% endif %}
    {% if summary != blank %}<p class="offer-card__summary">{{ summary | escape }}</p>{% endif %}
    {% if terms != blank %}<p class="offer-card__terms">{{ terms | escape | newline_to_br }}</p>{% endif %}
    <offer-code-component class="offer-card__actions" data-copy-label="{{ 'me_picks.copy' | t | escape }}" data-copied="{{ 'me_picks.copied' | t | escape }}" data-manual="{{ 'me_picks.copy_manual' | t | escape }}">
      {% if code != blank %}
        {% if preview %}
          <div class="offer-card__code-row"><span class="offer-card__code-label">{{ 'me_picks.code_label' | t }}</span><span class="offer-card__code">{{ code | escape }}</span><span class="offer-card__copy">{{ 'me_picks.copy' | t }}</span></div>
        {% else %}
          <div class="offer-card__code-row">
            <span class="offer-card__code-label">{{ 'me_picks.code_label' | t }}</span>
            <label class="visually-hidden" for="{{ code_id }}">{{ 'me_picks.code_for' | t: brand: brand | escape }}</label>
            <input class="offer-card__code" id="{{ code_id }}" ref="code" type="text" value="{{ code | escape }}" readonly>
            <button class="offer-card__copy" ref="copy" type="button" on:click="/copyCode" hidden aria-label="{{ 'me_picks.copy_code' | t: brand: brand | escape }}">
              <span ref="copyText">{{ 'me_picks.copy' | t }}</span>
            </button>
          </div>
        {% endif %}
      {% elsif valid_url or preview %}
        <div class="offer-card__code-row offer-card__code-row--empty">{{ 'me_picks.no_code_needed' | t }}</div>
      {% endif %}
      {% if preview %}
        <span class="offer-card__button">{% if code != blank %}{{ 'me_picks.copy_and_shop' | t }}{% else %}{{ 'me_picks.get_offer' | t }}{% endif %}<span aria-hidden="true">↗</span></span>
      {% elsif valid_url %}
        <a class="offer-card__button" href="{{ offer_url | escape }}" target="_blank" rel="noopener noreferrer" {% if code != blank %}on:click="/copyAndShop"{% endif %} aria-label="{% if code != blank %}{{ 'me_picks.copy_and_shop_for' | t: brand: brand | escape }}{% else %}{{ 'me_picks.get_offer_for' | t: brand: brand | escape }}{% endif %}">{% if code != blank %}{{ 'me_picks.copy_and_shop' | t }}{% else %}{{ 'me_picks.get_offer' | t }}{% endif %}<span aria-hidden="true">↗</span></a>
      {% endif %}
      {% unless preview %}<span class="visually-hidden" ref="status" role="status" aria-atomic="true"></span>{% endunless %}
    </offer-code-component>
  </div>
</article>
