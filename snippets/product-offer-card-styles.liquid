{% doc %}
  Owns shared offer-card styles, including empty-to-populated collection rendering.
  @example {% render 'product-offer-card-styles' %} before rendering the offer grid.
{% enddoc %}
{% stylesheet %}
  .offer-card { display: flex; flex-direction: column; min-inline-size: 0; min-block-size: 470px; block-size: 100%; padding: 16px 16px 30px; overflow: clip; border: 0; border-radius: var(--me-picks-card-radius); box-shadow: inset 0 0 0 1px var(--me-picks-card-border); background: var(--me-picks-card-background); text-align: center; }
  .offer-card__media { position: relative; display: grid; flex-shrink: 0; place-items: center; aspect-ratio: 266 / 150; overflow: hidden; border-radius: 10px; background: var(--me-picks-media-background); }
  .offer-card__image { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .offer-card__sample-image { position: absolute; inline-size: 239.23%; max-inline-size: none; block-size: 493.66%; left: -12.58%; inset-block-start: -115.85%; }
  .offer-card__sample-image--link { left: -126.65%; }
  .offer-card__placeholder { font-size: 9px; font-weight: 400; line-height: 1.41; color: var(--color-foreground-muted); }
  .offer-card__body { display: flex; flex: 1; flex-direction: column; min-inline-size: 0; padding-block-start: 14px; }
  .offer-card__category { margin: 0 0 3px; color: color-mix(in srgb, var(--me-picks-offer-color, var(--me-picks-accent)) 80%, var(--me-picks-card-background)); font-size: 10px; font-weight: 600; line-height: 18px; letter-spacing: 1.2px; text-transform: uppercase; overflow-wrap: anywhere; }
  .offer-card__brand { margin: 0; color: var(--color-foreground); font-family: inherit; font-size: 20px; font-weight: 800; line-height: 28px; overflow-wrap: anywhere; }
  .offer-card__description { margin: 0; color: var(--color-foreground-muted); font-size: 12px; font-weight: 400; line-height: 1.2; overflow-wrap: anywhere; }
  .offer-card__summary { margin: 24px 0 0; color: var(--me-picks-offer-color, var(--me-picks-accent)); font-size: 32px; font-weight: 800; line-height: 46px; overflow-wrap: anywhere; }
  .offer-card__terms { margin: 0; color: var(--color-foreground-muted); font-size: 12px; font-weight: 400; line-height: 1.2; overflow-wrap: anywhere; }
  .offer-card__actions { display: grid; gap: 12px; inline-size: 100%; min-inline-size: 0; margin-block-start: auto; padding-block-start: 12px; }
  .offer-card__code-row { display: flex; align-items: center; gap: 6px; min-inline-size: 0; min-block-size: 44px; padding: 6px 10px; border: 1px solid color-mix(in srgb, var(--me-picks-code-color) 16%, var(--me-picks-code-background)); border-radius: 10px; background: var(--me-picks-code-background); color: var(--color-foreground-muted); }
  .offer-card__code-row--empty { justify-content: center; font-size: 12px; line-height: 22px; }
  .offer-card__code-label { flex: none; font-size: 12px; font-weight: 600; line-height: 30px; }
  .offer-card__code { display: block; flex: 1; inline-size: 0; min-inline-size: 0; margin: 0; padding: 0; border: 0; border-radius: 0; box-shadow: none; background: transparent; color: var(--me-picks-code-color); font: inherit; font-size: 13px; font-weight: 800; line-height: 30px; text-align: center; text-overflow: ellipsis; }
  input.offer-card__code { cursor: text; }
  .offer-card__copy { display: inline-flex; flex: none; align-items: center; justify-content: center; min-inline-size: 70px; min-block-size: 30px; padding: 4px 8px; border: 0; border-radius: 8px; background: color-mix(in srgb, var(--me-picks-accent) 9%, var(--me-picks-code-background)); color: var(--me-picks-accent); font: inherit; font-size: 12px; font-weight: 600; line-height: 22px; cursor: copy; }
  .offer-card__button { display: flex; align-items: center; justify-content: center; gap: 6px; inline-size: 100%; min-inline-size: 0; min-block-size: 40px; padding: 8px 12px; border: 0; border-radius: 10px; background: var(--me-picks-button-background); color: var(--me-picks-button-color); font: inherit; font-size: 13px; font-weight: 700; line-height: 24px; text-align: center; text-decoration: none; overflow-wrap: anywhere; }
  .offer-card__button:hover { color: var(--me-picks-button-color); }
  .offer-card__copy[hidden] { display: none; }
  .offer-card__code:focus-visible, .offer-card__copy:focus-visible, .offer-card__button:focus-visible { outline: none }
  @media screen and (max-width: 749px) {
    .offer-card__copy, .offer-card__button { min-block-size: 44px; }
  }
{% endstylesheet %}
