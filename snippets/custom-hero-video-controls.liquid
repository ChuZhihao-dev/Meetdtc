{% doc %}
  Shared poster and video visibility styles for the native-layout Hero.
  @example {% render 'custom-hero-video-controls' %}
{% enddoc %}
{% stylesheet %}
  .hero__video-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .hero[data-enhanced] video:not([data-playing]) { opacity: 0; }
{% endstylesheet %}
