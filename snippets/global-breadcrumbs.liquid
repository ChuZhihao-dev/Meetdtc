{% doc %}
  Breadcrumb navigation and matching structured data for the breadcrumb section.
  Reads the current resource and locale-aware routes from Shopify globals.
  @example
  {% render 'global-breadcrumbs' %}
{% enddoc %}
{% liquid
  assign show_breadcrumbs = true
  assign supported_pages = 'product,collection,list-collections,page,blog,article,cart,search,policy,404' | split: ','
  unless supported_pages contains request.page_type
    assign show_breadcrumbs = false
  endunless
  assign current_title = page_title
  assign parent_title = ''
  assign parent_url = ''
  case request.page_type
    when 'product'
      assign current_title = product.title
      if collection != blank
        assign parent_title = collection.title
        assign parent_url = collection.url
      endif
    when 'collection'
      assign current_title = collection.title
      if current_tags != blank
        assign parent_title = collection.title
        assign parent_url = collection.url
        assign current_title = current_tags | join: ', '
      endif
    when 'page'
      assign current_title = page.title
    when 'blog'
      assign current_title = blog.title
      if current_tags != blank
        assign parent_title = blog.title
        assign parent_url = blog.url
        assign current_title = current_tags | join: ', '
      endif
    when 'article'
      assign current_title = article.title
      assign parent_title = blog.title
      assign parent_url = blog.url
  endcase
  assign home_title = 'global_breadcrumbs.home' | t
  assign home_url = routes.root_url | prepend: request.origin
  assign absolute_parent_url = parent_url | prepend: request.origin
%}
{% if show_breadcrumbs and current_title != blank %}
  <nav class="global-breadcrumbs" aria-label="{{ 'global_breadcrumbs.label' | t | escape }}">
    <ol class="global-breadcrumbs__list" role="list">
      <li class="global-breadcrumbs__item"><a href="{{ routes.root_url }}">{{ home_title | escape }}</a></li>
      {% if parent_title != blank and parent_url != blank %}
        <li class="global-breadcrumbs__item">
          <span class="global-breadcrumbs__separator" aria-hidden="true">/</span>
          <a href="{{ parent_url | escape }}">{{ parent_title | escape }}</a>
        </li>
      {% endif %}
      <li class="global-breadcrumbs__item">
        <span class="global-breadcrumbs__separator" aria-hidden="true">/</span>
        <span aria-current="page">{{ current_title | escape }}</span>
      </li>
    </ol>
  </nav>
  {% unless request.page_type == 'search' or request.page_type == 'cart' or request.page_type == '404' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {{ home_title | json | replace: '<', '\u003c' }}, "item": {{ home_url | json | replace: '<', '\u003c' }} },
          {% if parent_title != blank and parent_url != blank %}
            { "@type": "ListItem", "position": 2, "name": {{ parent_title | json | replace: '<', '\u003c' }}, "item": {{ absolute_parent_url | json | replace: '<', '\u003c' }} },
          {% endif %}
          { "@type": "ListItem", "position": {% if parent_title != blank and parent_url != blank %}3{% else %}2{% endif %}, "name": {{ current_title | json | replace: '<', '\u003c' }}, "item": {{ canonical_url | json | replace: '<', '\u003c' }} }
        ]
      }
    </script>
  {% endunless %}
{% endif %}

{% stylesheet %}
  .global-breadcrumbs {
    display: grid;
    grid-template-columns: minmax(var(--page-margin), 1fr) min(var(--page-content-width), calc(100% - var(--page-margin) * 2)) minmax(var(--page-margin), 1fr);
    color: var(--color-foreground);
  }
  .global-breadcrumbs__list {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.5;
  }
  .global-breadcrumbs__item { display: flex; align-items: baseline; gap: 12px; min-inline-size: 0; }
  .global-breadcrumbs__item a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .global-breadcrumbs__item a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .global-breadcrumbs__item :is(a, [aria-current]) { min-inline-size: 0; overflow-wrap: anywhere; }
  .global-breadcrumbs__separator { flex: none; opacity: var(--opacity-70); }
{% endstylesheet %}
