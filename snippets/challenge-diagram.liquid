{% doc %}
  Renders the growth-potential diagram from the original Figma SVG layers.
  Markers are decorative and have no interactive behavior.
  @param {string} center_text - Merchant-authored text inside the circle.
  @param {color} [center_tint] - Optional tint over the original circle artwork.
  @example
  {% render 'challenge-diagram', center_text: section.settings.center_text, center_tint: section.settings.center_tint %}
{% enddoc %}

<div class="challenge-diagram">
  <div class="challenge-diagram__layers" aria-hidden="true">
    <span class="challenge-diagram__layer" style="--challenge-layer-size: 38.0165%;"><img src="{{ 'challenge-core-base.svg' | asset_url }}" width="184" height="184" alt="" loading="lazy"></span>
    <span class="challenge-diagram__layer" style="--challenge-layer-size: 47.1074%;"><img src="{{ 'challenge-core-halo.svg' | asset_url }}" width="228" height="228" alt="" loading="lazy"></span>
    <span class="challenge-diagram__layer" style="--challenge-layer-size: 38.0165%;"><img src="{{ 'challenge-core-ring.svg' | asset_url }}" width="184" height="184" alt="" loading="lazy"></span>
    <span class="challenge-diagram__layer" data-ring="2" style="--challenge-layer-size: 72.314%;"><img src="{{ 'challenge-ring-middle.svg' | asset_url }}" width="350" height="350" alt="" loading="lazy"></span>
    <span class="challenge-diagram__layer" data-ring="3" style="--challenge-layer-size: 85.9504%;"><img src="{{ 'challenge-ring-outer.svg' | asset_url }}" width="416" height="416" alt="" loading="lazy"></span>
    <span class="challenge-diagram__layer" data-ring="1" style="--challenge-layer-size: 100%;"><img src="{{ 'challenge-ring-boundary.svg' | asset_url }}" width="484" height="484" alt="" loading="lazy"></span>
    <span class="challenge-diagram__layer" style="--challenge-layer-size: 57.0248%;"><img src="{{ 'challenge-ring-inner.svg' | asset_url }}" width="276" height="276" alt="" loading="lazy"></span>
    {% if center_tint != blank %}<span class="challenge-diagram__tint" style="background-color: {{ center_tint }};"></span>{% endif %}
  </div>
  {% if center_text != blank %}<p class="challenge-diagram__center">{{ center_text | escape | newline_to_br }}</p>{% endif %}
  {% for marker in (1..3) %}
    <span class="challenge-diagram__marker challenge-diagram__marker--{{ marker }}" data-marker-slot="{{ marker }}">
      <span class="challenge-diagram__decoration" aria-hidden="true"><img src="{{ 'challenge-marker.svg' | asset_url }}" width="38" height="38" alt="" loading="lazy"><span>−</span></span>
    </span>
  {% endfor %}
</div>

{% stylesheet %}
  .challenge-diagram { position: relative; inline-size: 100%; aspect-ratio: 1; container-type: inline-size; }
  .challenge-diagram__layers { position: absolute; inset: 0; }
  .challenge-diagram__layer { position: absolute; inset-block-start: 50%; inset-inline-start: 50%; inline-size: var(--challenge-layer-size); translate: -50% -50%; }
  .challenge-diagram__layer img { display: block; inline-size: 100%; block-size: auto; }
  .challenge-diagram__tint { position: absolute; inset: 30.992%; border-radius: 50%; mix-blend-mode: color; }
  .challenge-diagram__center { position: absolute; inset-block-start: 50%; inset-inline-start: 50%; translate: -50% -50%; inline-size: 38.0165%; max-block-size: 38%; margin: 0; font-size: clamp(1rem, 4.9587cqw, 1.5rem); font-weight: 600; line-height: 1.25; text-align: center; overflow-wrap: anywhere; color: var(--challenge-center-color); }
  .challenge-diagram__marker { position: absolute; inline-size: 44px; block-size: 44px; translate: -50% -50%; }
  .challenge-diagram__marker--1 { inset-inline-start: 7.6446%; inset-block-start: 58.0579%; }
  .challenge-diagram__marker--2 { inset-inline-start: 71.0744%; inset-block-start: 83.0579%; }
  .challenge-diagram__marker--3 { inset-inline-start: 84.0909%; inset-block-start: 18.3884%; }
  .challenge-diagram__decoration { position: absolute; inset: 0; display: grid; place-items: center; inline-size: 44px; block-size: 44px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: #616161; font-family: inherit; font-size: clamp(1rem, 4.9587cqw, 1.5rem); font-weight: 300; line-height: 1; }
  .challenge-diagram__decoration img { grid-area: 1 / 1; inline-size: 7.8512cqw; block-size: auto; }
  .challenge-diagram__decoration span { grid-area: 1 / 1; }
  [dir='rtl'] .challenge-diagram__layer, [dir='rtl'] .challenge-diagram__center { translate: 50% -50%; }
  [dir='rtl'] .challenge-diagram__marker { translate: 50% -50%; }
  @media screen and (max-width: 749px) { .challenge-diagram__center { font-size: 1.125rem; line-height: 1.3333; } }
{% endstylesheet %}
