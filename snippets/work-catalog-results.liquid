{% doc %}
  Renders the Our Work results grid, empty state and pagination.
  Instances are the keyed hydration boundary the work-catalog component morphs.
  @param {blog} [blog] - Blog whose articles render; omitted for editor preview.
  @param {object} [paginate] - Paginate object from the owning section.
  @param {boolean} [preview] - Editor-only placeholder state.
  @param {string} [listing_path] - Route path for the current listing.
  @example {% render 'work-catalog-results', blog: blog, paginate: paginate, preview: preview, listing_path: listing_path %}
{% enddoc %}
<div class="work-catalog__results" tabindex="-1" on:click="work-catalog-component/navigate"
  data-hydration-key="work-catalog-{{ section.id }}"
  data-current-path="{{ listing_path | default: request.path | escape }}"
  data-loaded-text="{{ 'work_catalog.loaded' | t | escape }}">
  <div ref="grid" class="work-catalog__grid">
    {% if blog != blank %}
      {% for article in blog.articles %}
        {% liquid
          assign loading = 'lazy'
          if forloop.index <= 3
            assign loading = 'eager'
          endif
        %}
        {% render 'work-article-card', article: article, loading: loading %}
      {% endfor %}
    {% endif %}
    {% if preview %}
      {% for index in (1..9) %}
        {% render 'work-article-card', preview: true %}
      {% endfor %}
    {% endif %}
  </div>
  {% if blog != blank and blog.articles.size == 0 and preview == false %}
    <p class="work-catalog__empty">{{ 'work_catalog.empty' | t }}</p>
  {% elsif blog == blank and preview == false %}
    <p class="work-catalog__empty">{{ 'work_catalog.empty' | t }}</p>
  {% endif %}
  {% render 'work-pagination', paginate: paginate, preview: preview %}
</div>
