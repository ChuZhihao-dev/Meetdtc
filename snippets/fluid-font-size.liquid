{% doc %}
  Emits a font-size value interpolated from 375px to 1440px using global mobile ratios.
  Global settings are read here, independently of a caller's local settings parameter.
  @param {number} desktop_size - Maximum font size in CSS pixels at a 16px root.
  @param {string} [kind] - 'heading' or 'body' (default).
  @param {string} [fallback] - Existing CSS value when global scaling is disabled.
  @param {string} [css_variable] - Optional property name; emit the declaration only when enabled.
  @example {% render 'fluid-font-size', desktop_size: 58, kind: 'heading', fallback: '58px' %}
{% enddoc %}
{%- liquid
  assign maximum = desktop_size | times: 1.0
  if settings.enable_fluid_typography and maximum > 0
    assign ratio = settings.fluid_body_mobile_ratio | default: 75 | divided_by: 100.0
    assign floor = 16
    if kind == 'heading'
      assign ratio = settings.fluid_heading_mobile_ratio | default: 60 | divided_by: 100.0
      if maximum >= 32
        assign floor = 24
      endif
    endif
    assign minimum = maximum | times: ratio | at_least: floor | at_most: maximum
    assign slope = maximum | minus: minimum | divided_by: 1065.0
    assign slope_vw = slope | times: 100 | round: 6
    assign intercept = slope | times: 375
    assign intercept_rem = minimum | minus: intercept | divided_by: 16.0 | round: 6
    assign minimum_rem = minimum | divided_by: 16.0 | round: 6
    assign maximum_rem = maximum | divided_by: 16.0 | round: 6
    if css_variable != blank
      echo css_variable | append: ': '
    endif
    echo 'clamp(' | append: minimum_rem | append: 'rem, calc(' | append: intercept_rem | append: 'rem + ' | append: slope_vw | append: 'vw), ' | append: maximum_rem | append: 'rem)'
    if css_variable != blank
      echo ';'
    endif
  elsif css_variable != blank
    # Keep the existing CSS fallback when disabled.
  elsif fallback != blank
    echo fallback
  else
    echo maximum | divided_by: 16.0 | append: 'rem'
  endif
-%}
