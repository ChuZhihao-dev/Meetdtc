{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% assign scoped_class = block_settings.style_class | append: '--' | append: block.id %}

{% liquid
  assign has_icon = false
  if block_settings.button_icon != blank
    assign has_icon = true
  endif

  assign is_unstyled = false
  if block_settings.style_class == 'button-unstyled'
    assign is_unstyled = true
  endif

  assign has_gradient = false
  if block_settings.button_gradient and is_unstyled == false
    assign has_gradient = true
  endif

  assign has_radius = false
  if block_settings.button_custom_radius and is_unstyled == false
    assign has_radius = true
  endif

  assign has_typography = false
  if is_unstyled == false
    if block_settings.button_font != blank or block_settings.button_font_size != blank or block_settings.button_font_weight != blank or block_settings.button_letter_spacing != blank or block_settings.button_case != blank
      assign has_typography = true
    endif
  endif
%}

{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

{%- if has_gradient or has_radius or has_typography -%}
  {% style %}
    .{{ scoped_class }} {
      {%- if has_gradient %}
        background-color: transparent;
        background-image: linear-gradient(
          {{ block_settings.button_gradient_angle }}deg,
          {{ block_settings.button_gradient_from }} {{ block_settings.button_gradient_start_position }}%,
          {{ block_settings.button_gradient_to }} {{ block_settings.button_gradient_end_position }}%
        );
      {%- endif %}
      {%- if has_radius %}
        border-radius: {{ block_settings.button_radius }}px;
      {%- endif %}
      {%- if block_settings.button_font != blank %}
        font-family: {{ block_settings.button_font }};
      {%- endif %}
      {%- if block_settings.button_font_size != blank %}
        font-size: {{ block_settings.button_font_size }};
      {%- endif %}
      {%- if block_settings.button_font_weight != blank %}
        font-weight: {{ block_settings.button_font_weight }};
      {%- endif %}
      {%- if block_settings.button_letter_spacing != blank %}
        letter-spacing: var(--letter-spacing--body-{{ block_settings.button_letter_spacing }});
      {%- endif %}
      {%- if block_settings.button_case != blank %}
        text-transform: {{ block_settings.button_case }};
      {%- endif %}
    }
  {% endstyle %}
{%- endif -%}

<a
  {% if has_gradient %}
    data-button-gradient="true"
  {% endif %}
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ scoped_class }}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {%- if has_icon -%}
    <span class="button__content">
      {{ block_settings.label }}
      <span
        class="button__icon"
        aria-hidden="true"
        style="--button-icon-url: url('{{ block_settings.button_icon | image_url }}'); --button-icon-size: {{ block_settings.button_icon_size }}px;"
      ></span>
    </span>
  {%- else -%}
    {{ block_settings.label }}
  {%- endif -%}
</a>

{% stylesheet %}
  /* Button label + trailing icon. The icon is tinted with currentColor via a mask so an
     uploaded (typically single-color) SVG inherits the button's text color. */
  .button__content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }

  .button__icon {
    display: inline-block;
    flex: none;
    inline-size: var(--button-icon-size, 1em);
    block-size: var(--button-icon-size, 1em);
    background-color: currentColor;
    -webkit-mask-image: var(--button-icon-url);
    mask-image: var(--button-icon-url);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }
{% endstylesheet %}
