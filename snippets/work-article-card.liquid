{% doc %}
  Renders a blog article as a case study: featured image, title and short description.
  @param {article} [article] - Blog article; omitted only for theme-editor placeholders.
  @param {string} [loading] - Image loading strategy, defaults to lazy.
  @param {boolean} [preview] - Render a non-linked editor preview.
  @example {% render 'work-article-card', article: article, loading: 'lazy' %}
{% enddoc %}
{% liquid
  assign image = article.image
  assign title = article.title
  assign description = article.excerpt_or_content
  assign loading = loading | default: 'lazy'
  assign sizes = '(min-width: 1440px) 335px, (min-width: 990px) calc((92.5vw - 329px) / 3), (min-width: 750px) calc((100vw - 64px) / 2), calc(100vw - 32px)'
  assign image_alt = image.alt | default: title
%}
<article class="work-card">
  {% unless preview %}<a class="work-card__link" href="{{ article.url | escape }}">{% endunless %}
    <div class="work-card__media">
      {% if image != blank %}
        {{ image | image_url: width: 1600 | image_tag: width: image.width, height: image.height, widths: '335,450,670,900,1200,1600', sizes: sizes, loading: loading, decoding: 'async', alt: image_alt, class: 'work-card__image' }}
      {% else %}
        <span class="work-card__placeholder" aria-hidden="true">{{ 'work_catalog.image_preview' | t }}</span>
      {% endif %}
    </div>
    <div class="work-card__body">
      {% if title != blank %}<h2 class="work-card__title">{{ title | escape }}</h2>{% endif %}
      {% if description != blank %}<p class="work-card__description">{{ description | strip_html | truncatewords: 42 | escape }}</p>{% endif %}
    </div>
  {% unless preview %}</a>{% endunless %}
</article>
{% stylesheet %}
  .work-card { min-inline-size: 0; min-block-size: 426px; overflow: clip; border: 1px solid var(--work-card-border); border-radius: var(--work-card-radius); background: var(--work-card-background); }
  .work-card__link { display: block; block-size: 100%; color: inherit; text-decoration: none; }
  .work-card__link:focus-visible { outline: 3px solid var(--work-accent); outline-offset: -4px; }
  .work-card__media { position: relative; display: grid; place-items: center; aspect-ratio: 335 / 278; overflow: hidden; border-block-end: 0.5px solid var(--work-media-border); background: var(--work-media-background); }
  .work-card__image { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; transform: scale(1); transition: transform 0.4s var(--ease-out-cubic); }
  @media (hover: hover) {
    .work-card__link:hover .work-card__image,
    .work-card__link:focus-visible .work-card__image { transform: scale(1.06); }
  }
  .work-card__placeholder { font-size: 9px; font-weight: 400; line-height: 1.41; color: var(--work-placeholder-color); }
  .work-card__body { min-inline-size: 0; min-block-size: 148px; padding: 16px; }
  .work-card__title { margin: 0; color: var(--color-foreground); font-family: inherit; font-size: 16px; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
  .work-card__description { margin: 14px 0 0; color: var(--work-muted); font-size: 11px; font-weight: 400; line-height: 1.41; overflow-wrap: anywhere; }
  @media screen and (max-width: 749px) {
    .work-card { min-block-size: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card__image { transition: none; }
  }
{% endstylesheet %}
